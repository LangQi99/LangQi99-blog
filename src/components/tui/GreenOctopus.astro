---
const rows = [
  "000001111100000",
  "000111111111000",
  "001111111111100",
  "011111111111110",
  "011100111001110",
  "111100111001111",
  "111111111111111",
  "111111000111111",
  "011111111111110",
  "001111111111100",
  "001101101101100",
  "011011011011110",
  "110110110110011",
];

const pixels = rows.flatMap((row, y) =>
  [...row].map((value, x) => ({
    on: value === "1",
    x,
    y,
  })),
);
---

<div class="green-octopus" aria-label="LangQi99 green pixel octopus" role="img">
  {
    pixels.map((pixel) => (
      <span
        class:list={["octo-pixel", pixel.on && "is-on"]}
        style={`--x:${pixel.x};--y:${pixel.y}`}
      />
    ))
  }
  <span class="octo-eye-glow octo-eye-glow-left"></span>
  <span class="octo-eye-glow octo-eye-glow-right"></span>
</div>

<style>
  .green-octopus {
    position: relative;
    width: 150px;
    height: 130px;
    margin-bottom: 24px;
    image-rendering: pixelated;
  }

  .octo-pixel {
    position: absolute;
    left: calc(var(--x) * 10px);
    top: calc(var(--y) * 10px);
    width: 10px;
    height: 10px;
    background: transparent;
  }

  .octo-pixel.is-on {
    background: var(--welcome-line);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.07);
  }

  .octo-eye-glow {
    position: absolute;
    top: 48px;
    width: 10px;
    height: 10px;
    background: var(--welcome-bright);
    box-shadow: 0 0 9px rgba(80, 201, 137, .55);
  }

  .octo-eye-glow-left { left: 50px; }
  .octo-eye-glow-right { left: 90px; }

  @media (max-width: 580px) {
    .green-octopus {
      transform: scale(.84);
      margin-block: -8px 12px;
    }
  }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PinnedRepos from "@/components/mdx/PinnedRepos.astro";
import Pagination from "@components/widgets/Pagination.astro";
import Pane from "@/components/tui/Pane.astro";
import PostWorkspace from "@/components/tui/PostWorkspace.astro";
import WelcomePanel from "@/components/tui/WelcomePanel.astro";
import WebGLOctopus from "@/components/tui/WebGLOctopus.astro";
import { generatePageLinks } from "@utils/blogUtils";
import { getMainBlogPaginationPaths } from "@utils/paginationUtils";
import type { Page } from "@interfaces/data";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return getMainBlogPaginationPaths({ paginate });
}

const { page }: { page: Page } = Astro.props;
const totalPages = Math.ceil(page.total / page.size);
const pageLinks = generatePageLinks(totalPages);
const isFirstPage = page.currentPage === 1;
const latestPost = page.data[0];
---

<BaseLayout title={isFirstPage ? "Home" : `Blog - Page ${page.currentPage}`}>
  {
    isFirstPage && (
      <section class="home-dashboard">
        <WelcomePanel postCount={page.total} latestTitle={latestPost?.data.title} />
        <Pane title="whoami" meta="session ready" class="home-identity">
          <div class="identity-grid">
            <div class="identity-copy-panel">
              <p class="tui-kicker">LANGQI99 / PERSONAL WORKSTATION</p>
              <h1>代码、Agent、系统与偶尔的生活记录。</h1>
              <p class="identity-copy">
                这里是 LangQi99 的个人工作区。文章被构建成独立网站，公共页面负责检索、归档和展示正在进行的技术实践。
              </p>
              <div class="identity-actions">
                <a href="#recent-posts">open recent posts</a>
                <a href="https://github.com/LangQi99" target="_blank" rel="noopener">open github ↗</a>
              </div>
            </div>
            <WebGLOctopus postCount={page.total} />
          </div>
        </Pane>

        <Pane title="git pinned --format=compact" meta="live GitHub + fallback" class="home-repos">
          <PinnedRepos
            username="LangQi99"
            fallback={[
              { author: "LangQi99", name: "dlut-FakeRun", description: "✨一键刷校园跑脚本 | 虚拟定位校园跑刷跑软件", language: "Java", stars: 72, forks: 10 },
              { author: "songhahaha66", name: "PaperAgent", description: "PaperAgent - 全流程智能文章写作与代码执行系统", language: "Python", stars: 43, forks: 8 },
              { author: "LangQi99", name: "NeoFish", description: "🎯人人可用的Agent，你的终极数字奴隶。", language: "Python", stars: 24, forks: 8 },
              { author: "rk8s-dev", name: "rk8s", description: "A lightweight Kubernetes-compatible container orchestration system in Rust.", language: "Rust", stars: 488, forks: 80 },
              { author: "matplotlib", name: "matplotlib", description: "matplotlib: plotting with Python", language: "Python" },
              { author: "LangQi99", name: "dlut-NetworkStealer", description: "欺骗 DLUT 校园网认证", language: "Python", stars: 23, forks: 6 },
            ]}
          />
        </Pane>
      </section>
    )
  }

  <div id="recent-posts">
    <PostWorkspace
      posts={page.data}
      title={isFirstPage ? "find ./posts -maxdepth 1 -type f | head" : `find ./posts --page ${page.currentPage}`}
      meta={`${page.total} total · page ${page.currentPage}/${totalPages}`}
      filterLabel="filter title, description, category or tag"
    />
    <Pagination page={page} totalPages={totalPages} pageLinks={pageLinks} baseUrl={``} />
  </div>
</BaseLayout>

<style>
  .home-dashboard { display: grid; gap: 12px; margin-bottom: 12px; }
  .identity-grid { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(380px, .96fr); min-height: 440px; align-items: stretch; }
  .home-identity { background: rgba(0,0,0,.58); }
  .home-identity :global(.tui-pane-body) { padding: 0; }
  .identity-copy-panel { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: clamp(34px, 4vw, 56px); }
  .tui-kicker { margin: 0 0 18px; color: var(--tui-accent); font-size: 10px; font-weight: 800; letter-spacing: .13em; }
  .identity-grid h1 { max-width: 870px; margin: 0; color: var(--tui-text); font-family: Georgia, "Times New Roman", "Noto Serif SC", serif; font-size: clamp(42px, 4.25vw, 68px); font-weight: 400; line-height: .96; letter-spacing: -.05em; }
  .identity-copy { max-width: 720px; margin: 24px 0 0; color: var(--tui-muted); font-size: clamp(15px, 1.4vw, 18px); line-height: 1.8; }
  .identity-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .identity-actions a { min-height: 36px; padding: 0 12px; border: 1px solid var(--tui-border); border-radius: 2px; background: var(--tui-panel-soft); color: var(--tui-muted); font: 700 10px/1 var(--tui-code); text-decoration: none; cursor: pointer; }
  .identity-actions a { display: inline-flex; align-items: center; }
  .identity-actions a:first-child { border-color: var(--tui-accent); color: var(--tui-text); }
  .home-repos :global(.tui-pane-body) { padding: 0; }
  .home-repos :global(.pinned-grid) { display: grid !important; grid-template-columns: repeat(3, minmax(0, 1fr)) !important; gap: 1px !important; background: var(--tui-border); }
  .home-repos :global(.pinned-grid > a), .home-repos :global(.pinned-grid > div) { min-height: 150px; margin: 0 !important; border: 0 !important; border-radius: 0 !important; background: var(--tui-panel) !important; box-shadow: none !important; color: var(--tui-text) !important; transform: none !important; }
  #recent-posts { scroll-margin-top: 70px; }
  #recent-posts > :last-child { margin-top: 12px; }
  @media (max-width: 980px) { .identity-grid { grid-template-columns: 1fr; } .home-repos :global(.pinned-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; } }
  @media (max-width: 600px) { .identity-copy-panel { padding: 24px 18px 30px; } .identity-grid h1 { font-size: clamp(38px, 13vw, 58px); } .home-repos :global(.pinned-grid) { grid-template-columns: 1fr !important; } }
</style>

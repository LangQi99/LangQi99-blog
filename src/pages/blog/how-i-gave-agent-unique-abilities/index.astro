---
import { getCollection } from "astro:content";
import Experience from "../../../sites/how-i-gave-agent-unique-abilities/experience.astro";

const blog = (await getCollection("blog")).find(
  (entry) => entry.slug === "how-i-gave-agent-unique-abilities",
);

if (!blog) {
  throw new Error("Missing blog entry: how-i-gave-agent-unique-abilities");
}
---

<Experience blog={blog} />

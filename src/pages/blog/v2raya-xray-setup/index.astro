---
import { getCollection } from "astro:content";
import Site from "../../../sites/v2raya-xray-setup/index.astro";
const blog = (await getCollection("blog")).find((entry) => entry.slug === "v2raya-xray-setup");
if (!blog) throw new Error("Missing blog entry: v2raya-xray-setup");
---
<Site blog={blog} />

---
import { getCollection } from "astro:content";
import Site from "../../../sites/ai-paper-latex/index.astro";

const blog = (await getCollection("blog")).find(
  (entry) => entry.slug === "ai-paper-latex",
);

if (!blog) {
  throw new Error("Missing blog entry: ai-paper-latex");
}
---

<Site blog={blog} />

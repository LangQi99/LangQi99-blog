---
import BaseLayout from "@layouts/BaseLayout.astro";
import Pane from "@/components/tui/Pane.astro";
import { t } from "@config";
import dayjs from "@utils/dayjs";
import { DATE_FORMAT } from "@config";
import type { CollectionEntry } from "astro:content";
import { getAllPosts, getCategoriesWithPosts, getCategoryColorClass } from "@utils/blogUtils";

// 获取所有博客文章
const allPosts = await getAllPosts();

// 提取所有分类并按分类对文章进行分组
const categoryMap = getCategoriesWithPosts(allPosts);

// 转换为数组并按字母顺序排序
const categoryEntries = Array.from(categoryMap.entries());
categoryEntries.sort((a, b) => a[0].localeCompare(b[0]));

// 对每个分类中的文章按日期排序（最新的排在前面）
categoryEntries.forEach(([_, posts]) => {
  posts.sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  );
});

// 统计总分类数
const totalCategories = categoryMap.size;
---

<BaseLayout title={t("label.categoryPage")}>
  <header class="tui-page-head">
    <div><p>tree ./categories</p><h1>分类目录。</h1><span>像浏览目录树一样选择主题，右侧即时查看该分类下的文章。</span></div>
    <div class="tui-page-stat"><b>{totalCategories}</b><span>directories</span></div>
  </header>
  <Pane title="tree ./categories --posts" meta={`${allPosts.length} posts`} bodyClass="category-browser-body">
    <div class="category-browser" data-category-browser>
      <nav aria-label="分类目录">
        {categoryEntries.map(([category, posts], index) => (
          <button type="button" data-category-button data-index={index} aria-pressed={index === 0 ? "true" : "false"}>
            <span>▸ {category}</span><small>{posts.length}</small>
          </button>
        ))}
      </nav>
      <div class="category-results">
        {categoryEntries.map(([category, posts], index) => (
          <section data-category-panel data-index={index} hidden={index !== 0}>
            <header><span>./categories/{category}</span><a href={`/blog/category/${category}`}>open route ↗</a></header>
            <ul class="tui-list">
              {posts.map((post) => (
                <li><a class="tui-list-row" href={`/blog/${post.slug}`}><time>{dayjs(post.data.pubDate).format(DATE_FORMAT)}</time><span><strong>{post.data.title}</strong><p>{post.data.description}</p></span><span>{post.data.tags?.[0] || "post"}</span></a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Pane>
</BaseLayout>

<script>
  const initCategories = () => {
    const root = document.querySelector("[data-category-browser]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const buttons = [...root.querySelectorAll("[data-category-button]")];
    const panels = [...root.querySelectorAll("[data-category-panel]")];
    buttons.forEach((button) => button.addEventListener("click", () => {
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      panels.forEach((panel) => panel.hidden = panel.dataset.index !== button.dataset.index);
    }));
  };
  document.addEventListener("astro:page-load", initCategories);
  document.addEventListener("DOMContentLoaded", initCategories, { once: true });
</script>

<style>
  .category-browser-body { padding: 0; }
  .category-browser { min-height: 520px; display: grid; grid-template-columns: 230px minmax(0, 1fr); }
  .category-browser > nav { padding: 7px; border-right: 1px solid var(--tui-border); background: var(--tui-panel-soft); }
  .category-browser > nav button { width: 100%; min-height: 38px; display: flex; justify-content: space-between; align-items: center; padding: 0 10px; border: 1px solid transparent; background: transparent; color: var(--tui-muted); font: 700 11px var(--tui-code); cursor: pointer; }
  .category-browser > nav button:hover, .category-browser > nav button[aria-pressed="true"] { border-color: var(--tui-border); background: var(--tui-accent-soft); color: var(--tui-text); }
  .category-browser > nav small { color: var(--tui-dim); }
  .category-results section > header { min-height: 42px; display: flex; align-items: center; justify-content: space-between; padding: 0 13px; border-bottom: 1px solid var(--tui-border); color: var(--tui-dim); font: 700 10px var(--tui-code); }
  .category-results header a { color: var(--tui-accent); text-decoration: none; }
  @media (max-width: 760px) { .category-browser { grid-template-columns: 1fr; } .category-browser > nav { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--tui-border); } .category-browser > nav button { flex: 0 0 auto; width: auto; } }
</style>

---
import type { Page } from "@interfaces/data";
import BaseLayout from "@layouts/BaseLayout.astro";
import Pagination from "@components/widgets/Pagination.astro";
import PostWorkspace from "@/components/tui/PostWorkspace.astro";
import { generatePageLinks } from "@utils/blogUtils";
import { getMainBlogPaginationPaths } from "@utils/paginationUtils";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return getMainBlogPaginationPaths({ paginate });
}

const { page }: { page: Page } = Astro.props;
const totalPages = Math.ceil(page.total / page.size);
const pageLinks = generatePageLinks(totalPages);
---

<BaseLayout title="Blog">
  <div class="blog-command-row" aria-label="博客工具">
    <span><b>λ</b> blog</span>
    <nav>
      <a href="/blog/archives">archives <kbd>a</kbd></a>
      <a href="/blog/categories">categories <kbd>c</kbd></a>
      <a href="/blog/tags">tags <kbd>t</kbd></a>
      <a href="/blog/search">search <kbd>/</kbd></a>
    </nav>
  </div>
  <PostWorkspace
    posts={page.data}
    title={`find ./posts --page ${page.currentPage}`}
    meta={`${page.total} total · page ${page.currentPage}/${totalPages}`}
    filterLabel="filter title, description, category or tag"
  />
  <Pagination page={page} totalPages={totalPages} pageLinks={pageLinks} baseUrl={`/blog`} />
</BaseLayout>

<style>
  .blog-command-row {
    min-height: 45px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 12px;
    padding: 0 12px;
    border: 1px solid var(--tui-border);
    background: var(--tui-panel-soft);
    color: var(--tui-muted);
    font: 700 10px/1 var(--tui-code);
  }
  .blog-command-row b { color: var(--tui-accent); }
  .blog-command-row nav { display: flex; flex-wrap: wrap; gap: 5px; }
  .blog-command-row a { padding: 7px 9px; color: var(--tui-muted); text-decoration: none; }
  .blog-command-row a:hover { color: var(--tui-text); background: var(--tui-panel-raised); }
  .blog-command-row kbd { margin-left: 5px; color: var(--tui-dim); font-size: 9px; }
  :global(.tui-content > .post-workspace + div) { margin-top: 12px; }
  @media (max-width: 660px) { .blog-command-row { align-items: flex-start; flex-direction: column; padding-block: 10px; } }
</style>

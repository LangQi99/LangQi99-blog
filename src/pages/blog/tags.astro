---
import BaseLayout from "@layouts/BaseLayout.astro";
import Pane from "@/components/tui/Pane.astro";
import { t } from "@config";
import { getAllPosts, getTagsWithCount } from "@utils/blogUtils";

// 获取所有博客文章
const allPosts = await getAllPosts();

// 提取所有标签并统计其出现次数
const tagMap = getTagsWithCount(allPosts);

// 转换为数组并按计数排序（降序）
const tagEntries = Array.from(tagMap.entries());
tagEntries.sort((a, b) => b[1] - a[1]);

// 找到最大和最小计数，用于缩放
// 计算总标签数
const totalTags = tagMap.size;
---

<BaseLayout title={t("label.tagPage")}>
  <header class="tui-page-head">
    <div><p>grep -R "#tag" ./posts</p><h1>标签索引。</h1><span>过滤标签、查看频次，并跳转到对应的文章结果工作区。</span></div>
    <div class="tui-page-stat"><b>{totalTags}</b><span>indexed tags</span></div>
  </header>
  <Pane title="grep ./posts --tags --count" meta={`${allPosts.length} posts`} bodyClass="tag-index-body">
    <div class="tag-query">
      <span class="tui-prompt">›</span>
      <input type="search" placeholder="filter tags..." data-tag-filter aria-label="过滤标签" />
      <span>sorted by frequency</span>
    </div>
    <ol class="tag-index" data-tag-index>
      {tagEntries.map(([tag, count], index) => (
        <li data-tag-row data-search={tag.toLowerCase()}>
          <a href={`/blog/tag/${tag}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>#{tag}</strong>
            <span>{count} matches</span>
            <i style={`--tag-weight:${Math.min(100, count * 18)}%`}></i>
          </a>
        </li>
      ))}
      <li class="tag-empty" data-tag-empty hidden>0 matching tags</li>
    </ol>
  </Pane>
</BaseLayout>

<script>
  const initTagIndex = () => {
    const input = document.querySelector("[data-tag-filter]");
    const rows = [...document.querySelectorAll("[data-tag-row]")];
    const empty = document.querySelector("[data-tag-empty]");
    if (!(input instanceof HTMLInputElement) || input.dataset.initialized === "true") return;
    input.dataset.initialized = "true";
    input.addEventListener("input", () => {
      const term = input.value.trim().toLowerCase();
      rows.forEach((row) => row.hidden = !row.dataset.search.includes(term));
      empty.hidden = rows.some((row) => !row.hidden);
    });
  };
  document.addEventListener("astro:page-load", initTagIndex);
  document.addEventListener("DOMContentLoaded", initTagIndex, { once: true });
</script>

<style>
  .tag-index-body { padding: 0; }
  .tag-query { min-height: 46px; display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: 10px; padding: 0 13px; border-bottom: 1px solid var(--tui-border); background: var(--tui-panel-soft); color: var(--tui-dim); font: 700 10px var(--tui-code); }
  .tag-query input { border: 0; outline: 0; background: transparent; color: var(--tui-text); font: 700 12px var(--tui-code); }
  .tag-index { margin: 0; padding: 0; list-style: none; }
  .tag-index a { min-height: 52px; display: grid; grid-template-columns: 38px minmax(0,1fr) 90px 140px; align-items: center; gap: 12px; padding: 0 13px; border-bottom: 1px solid var(--tui-border); color: var(--tui-muted); text-decoration: none; }
  .tag-index a:hover { background: var(--tui-panel-raised); color: var(--tui-text); }
  .tag-index a > span { color: var(--tui-dim); font: 700 9px var(--tui-code); }
  .tag-index strong { color: inherit; font: 700 12px var(--tui-code); }
  .tag-index i { height: 3px; background: linear-gradient(90deg, var(--tui-accent) var(--tag-weight), var(--tui-border) var(--tag-weight)); }
  .tag-empty { padding: 38px; color: var(--tui-dim); text-align: center; font: 700 11px var(--tui-code); }
  @media (max-width: 620px) { .tag-index a { grid-template-columns: 28px minmax(0,1fr) 74px; } .tag-index i, .tag-query > span:last-child { display: none; } }
</style>

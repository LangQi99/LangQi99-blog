---
import { getCollection } from "astro:content";
import Site from "../../../sites/github-issues-as-blog/index.astro";

const blog = (await getCollection("blog")).find(
  (entry) => entry.slug === "github-issues-as-blog",
);

if (!blog) {
  throw new Error("Missing blog entry: github-issues-as-blog");
}
---

<Site blog={blog} />

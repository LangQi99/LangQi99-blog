---
import { getCollection } from "astro:content";
import Site from "../../../sites/context-is-all-you-need/index.astro";

const blog = (await getCollection("blog")).find(
  (entry) => entry.slug === "context-is-all-you-need",
);

if (!blog) {
  throw new Error("Missing blog entry: context-is-all-you-need");
}
---

<Site blog={blog} />

---
import BaseLayout from "@layouts/BaseLayout.astro";
import Pane from "@/components/tui/Pane.astro";
import { t } from "@config";
import dayjs from "@utils/dayjs";
import { DATE_FORMAT } from "@config";
import { getAllPosts, sortPostsByDate, getPostsByYearAndMonth } from "@utils/blogUtils";

// 获取所有博客文章
const allPosts = await getAllPosts();

// 按日期排序
const sortedPosts = sortPostsByDate(allPosts);

// 按年份和月份分组
const postsByDate = getPostsByYearAndMonth(sortedPosts);

// 转换为数组并按年份排序（降序）和月份（降序）
const years = Array.from(postsByDate.keys()).sort((a, b) => parseInt(b) - parseInt(a));

// 从翻译获取月份名称
const getMonthName = (month: string): string => {
  const monthIndex = parseInt(month);
  return t(`months.${monthIndex}`);
};

// 统计总文章数
const totalPosts = allPosts.length;
---

<BaseLayout title={t("label.archivePage")}>
  <header class="tui-page-head">
    <div>
      <p>git log --all --date-order</p>
      <h1>文章归档。</h1>
      <span>按年份和月份追踪全部文章，像阅读一段持续生长的提交历史。</span>
    </div>
    <div class="tui-page-stat"><b>{totalPosts}</b><span>commits / posts</span></div>
  </header>
  <Pane title="git log --graph --date=short" meta={`${years.length} years`} bodyClass="archive-log-body">
    <div class="archive-log">
      {
        years.length > 0 ? (
          <div class="archive-years">
            {years.map((year) => (
              <details class="archive-year" open>
                <summary><span>{year}</span><small>{Array.from(postsByDate.get(year)!.values()).flat().length} posts</small></summary>
                <div>
                  {Array.from(postsByDate.get(year)!.entries())
                    .sort((a, b) => parseInt(b[0]) - parseInt(a[0]))
                    .map(([month, posts]) => (
                      <section class="archive-month">
                        <h2><span>{month}</span>{getMonthName(month)}<small>{posts.length}</small></h2>
                        <ul class="tui-list">
                          {posts.map((post) => (
                            <li>
                              <a href={`/blog/${post.slug}`} class="tui-list-row">
                                <time>{dayjs(post.data.pubDate).format(DATE_FORMAT)}</time>
                                <span><strong>{post.data.title}</strong>{post.data.description && <p>{post.data.description}</p>}</span>
                                <span>{post.data.categories?.[0] || "uncategorized"}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    ))}
                </div>
              </details>
            ))}
          </div>
        ) : (
          <div class="archive-empty">{t("label.noPosts")}</div>
        )
      }
    </div>
  </Pane>
</BaseLayout>

<style>
  .archive-log-body { padding: 0; }
  .archive-year { border-bottom: 1px solid var(--tui-border); }
  .archive-year > summary {
    min-height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    color: var(--tui-text);
    background: var(--tui-panel-soft);
    cursor: pointer;
    font: 800 12px/1 var(--tui-code);
    list-style: none;
  }
  .archive-year > summary::-webkit-details-marker { display: none; }
  .archive-year > summary::before { content: "▾"; margin-right: 9px; color: var(--tui-accent); }
  .archive-year:not([open]) > summary::before { content: "▸"; }
  .archive-year > summary span { margin-right: auto; }
  .archive-year > summary small { color: var(--tui-dim); }
  .archive-month h2 {
    min-height: 38px;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0 14px;
    border-bottom: 1px solid var(--tui-border);
    color: var(--tui-muted);
    font: 700 10px/1 var(--tui-code);
  }
  .archive-month h2 span { color: var(--tui-accent); }
  .archive-month h2 small { color: var(--tui-dim); }
  .archive-empty { padding: 40px; color: var(--tui-dim); text-align: center; font: 700 12px var(--tui-code); }
</style>

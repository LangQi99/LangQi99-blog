---
import { getCollection } from "astro:content";
import Site from "../../../sites/re2/index.astro";

const posts = await getCollection("blog");
const blog = posts.find((entry) => entry.slug === "re2");

if (!blog) {
  return Astro.redirect("/404");
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <Site blog={blog} />
  </body>
</html>

<style>
  .friends-pane :global(.tui-pane-body) { padding: 0; }
  .friends-workspace { display: grid; }
  .friend-group { padding: 24px; border-bottom: 1px solid var(--tui-border); }
  .friend-group h2 { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; color: var(--tui-text); font: 800 14px var(--tui-code); }
  .friend-group h2 span { color: var(--tui-accent); font-size: 10px; }
  .friend-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1px; background: var(--tui-border); }
  .resource-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1px; background: var(--tui-border); }
  .friend-grid :global(.card),
  .resource-grid :global(.card) { height: 100%; margin: 0 !important; border: 0 !important; border-radius: 0 !important; background: var(--tui-panel) !important; box-shadow: none !important; color: var(--tui-text) !important; }
  .friend-grid :global(.card:hover),
  .resource-grid :global(.card:hover) { background: var(--tui-panel-raised) !important; transform: none !important; }
  .friend-cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 24px; }
  .friend-cta p { margin: 0; color: var(--tui-muted); }
  .friend-contribute { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid var(--tui-accent); border-radius: 2px; color: var(--tui-text); font: 700 10px var(--tui-code); text-decoration: none; white-space: nowrap; }
  @media (max-width: 900px) { .friend-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 620px) { .friend-grid, .resource-grid { grid-template-columns: 1fr; } .friend-cta { align-items: flex-start; flex-direction: column; } }
</style>

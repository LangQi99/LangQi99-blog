---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import Pane from "@/components/tui/Pane.astro";
---

<BaseLayout title="About">
  <header class="tui-page-head">
    <div><p>whoami --verbose</p><h1>LangQi99</h1><span>Developer、开源爱好者，以及这个博客工作区的维护者。</span></div>
    <div class="about-avatar"><img src="https://github.com/LangQi99.png" alt="LangQi99" width="128" height="128" /></div>
  </header>
  <div class="about-grid">
    <Pane title="identity" meta="local user">
      <dl class="about-identity">
        <div><dt>name</dt><dd>LangQi99</dd></div>
        <div><dt>role</dt><dd>Developer & Open-Source Enthusiast</dd></div>
        <div><dt>github</dt><dd><a href="https://github.com/LangQi99" target="_blank" rel="noopener">@LangQi99 ↗</a></dd></div>
        <div><dt>email</dt><dd><a href="mailto:2032771946@qq.com">2032771946@qq.com</a></dd></div>
      </dl>
    </Pane>
    <Pane title="skills --group" meta="12 tools">
      <div class="skill-groups" data-skill-groups>
        <div class="skill-tabs">
          <button type="button" data-skill-tab="web" aria-pressed="true">web</button>
          <button type="button" data-skill-tab="systems" aria-pressed="false">systems</button>
          <button type="button" data-skill-tab="languages" aria-pressed="false">languages</button>
        </div>
        <div class="skill-panel" data-skill-panel="web">
          {[
            { name: "Astro", icon: "simple-icons:astro" }, { name: "JavaScript", icon: "simple-icons:javascript" }, { name: "TypeScript", icon: "simple-icons:typescript" }, { name: "React", icon: "simple-icons:react" }, { name: "Node.js", icon: "simple-icons:nodedotjs" }, { name: "TailwindCSS", icon: "simple-icons:tailwindcss" },
          ].map((tech) => <span><Icon name={tech.icon} />{tech.name}</span>)}
        </div>
        <div class="skill-panel" data-skill-panel="systems" hidden>
          {[
            { name: "Git", icon: "simple-icons:git" }, { name: "HTML5", icon: "simple-icons:html5" }, { name: "CSS3", icon: "simple-icons:css3" },
          ].map((tech) => <span><Icon name={tech.icon} />{tech.name}</span>)}
        </div>
        <div class="skill-panel" data-skill-panel="languages" hidden>
          {[
            { name: "Python", icon: "simple-icons:python" }, { name: "C++", icon: "simple-icons:cplusplus" }, { name: "C#", icon: "simple-icons:csharp" },
          ].map((tech) => <span><Icon name={tech.icon} />{tech.name}</span>)}
        </div>
      </div>
    </Pane>
  </div>
  <Pane title="github stats" meta="live data">
    <GitHubStats username="LangQi99" showLanguages={false} showCommitGraph={true} />
  </Pane>
</BaseLayout>

<script>
  const initSkills = () => {
    const root = document.querySelector("[data-skill-groups]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const tabs = [...root.querySelectorAll("[data-skill-tab]")];
    const panels = [...root.querySelectorAll("[data-skill-panel]")];
    tabs.forEach((tab) => tab.addEventListener("click", () => {
      tabs.forEach((item) => item.setAttribute("aria-pressed", String(item === tab)));
      panels.forEach((panel) => panel.hidden = panel.dataset.skillPanel !== tab.dataset.skillTab);
    }));
  };
  document.addEventListener("astro:page-load", initSkills);
  document.addEventListener("DOMContentLoaded", initSkills, { once: true });
</script>

<style>
  .about-avatar { width: 128px; height: 128px; border: 1px solid var(--tui-border-strong); background: var(--tui-panel-soft); }
  .about-avatar img { width: 100%; height: 100%; display: block; object-fit: cover; filter: grayscale(.35); }
  .about-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 12px; margin-bottom: 12px; }
  .about-identity { margin: 0; }
  .about-identity div { display: grid; grid-template-columns: 80px minmax(0,1fr); min-height: 48px; align-items: center; border-bottom: 1px solid var(--tui-border); }
  .about-identity div:last-child { border-bottom: 0; }
  .about-identity dt { color: var(--tui-dim); font: 700 9px var(--tui-code); text-transform: uppercase; }
  .about-identity dd { margin: 0; color: var(--tui-text); font-weight: 700; }
  .about-identity a { color: var(--tui-accent); text-decoration: none; }
  .skill-tabs { display: flex; gap: 4px; margin-bottom: 12px; }
  .skill-tabs button { padding: 8px 11px; border: 1px solid var(--tui-border); background: var(--tui-panel-soft); color: var(--tui-muted); font: 700 10px var(--tui-code); cursor: pointer; }
  .skill-tabs button[aria-pressed="true"] { border-color: var(--tui-accent); color: var(--tui-text); background: var(--tui-accent-soft); }
  .skill-panel { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1px; background: var(--tui-border); }
  .skill-panel span { min-height: 58px; display: flex; align-items: center; gap: 10px; padding: 12px; background: var(--tui-panel); color: var(--tui-muted); }
  .skill-panel svg { width: 20px; height: 20px; color: var(--tui-accent); }
  :global(github-stats) { margin: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; }
  @media (max-width: 780px) { .about-grid { grid-template-columns: 1fr; } .skill-panel { grid-template-columns: repeat(2, minmax(0,1fr)); } }
</style>

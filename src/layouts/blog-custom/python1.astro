---
/**
 * Design Read: Developer blog landing page for a Python tricks article, aimed at
 * intermediate-to-advanced Python devs. Replit-inspired colorful dark-mode aesthetic
 * with playful rounded corners and bright amber accents on a deep dark canvas.
 *
 * Three Dials:
 *   DESIGN_VARIANCE: 7 (left-aligned hero, varied section layouts, asymmetric spacing)
 *   MOTION_INTENSITY: 5 (scroll-reveal fades, subtle code-block glow pulses, no heavy animation)
 *   VISUAL_DENSITY: 4 (generous whitespace between sections, prominent code blocks)
 *
 * Accent color: #F59E0B (amber-500) locked for the entire page.
 * Corner radius system: 8px (playful, Replit-style).
 * Font: JetBrains Mono (project default, fits dev-tool vibe).
 */

import BaseLayout from "@layouts/BaseLayout.astro";

const { blog, remarkPluginFrontmatter } = Astro.props;
const title = blog.data.title;
const description = blog.data.description;
const pubDate = blog.data.pubDate;
const categories = blog.data.categories;
const tags = blog.data.tags;
---

<BaseLayout title={title}>
  <article class="python-landing -mx-4 -my-8">

    <!-- Hero Section -->
    <section class="hero-section min-h-[100dvh] flex flex-col justify-center px-6 md:px-16 lg:px-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0d1117] via-[#161b22] to-[#0d1117] -z-10"></div>

      <!-- Background decorative grid dots -->
      <div class="absolute inset-0 -z-10 opacity-[0.06]" style="background-image: radial-gradient(#F59E0B 1px, transparent 1px); background-size: 32px 32px;"></div>

      <!-- Floating accent shapes -->
      <div class="absolute top-[12%] right-[8%] w-48 h-48 rounded-[8px] border border-[#F59E0B]/20 rotate-12 hidden md:block"></div>
      <div class="absolute bottom-[18%] right-[15%] w-32 h-32 rounded-[8px] bg-[#F59E0B]/5 -rotate-6 hidden md:block"></div>
      <div class="absolute top-[40%] left-[3%] w-2 h-24 bg-gradient-to-b from-[#F59E0B]/30 to-transparent rounded-full hidden lg:block"></div>

      <div class="max-w-3xl reveal-element">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-[8px] bg-[#F59E0B]/10 border border-[#F59E0B]/20 text-xs text-[#F59E0B] font-mono tracking-wide">
            <span class="w-2 h-2 rounded-full bg-[#F59E0B] animate-pulse-subtle"></span>
            Python
          </span>
          <span class="text-xs text-slate-500 font-mono">
            {new Date(pubDate).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
          </span>
        </div>

        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tight text-white mb-6">
          冷门但高效的<br class="hidden md:block" />
          <span class="text-[#F59E0B]">设计巧思</span>
        </h1>

        <p class="text-base md:text-lg text-slate-400 max-w-xl leading-relaxed">
          探索 Python 中那些不常见却极具表现力的模式，让代码既优雅又实用
        </p>

        <div class="mt-10 flex flex-wrap gap-2">
          {tags && tags.map((tag: string) => (
            <span class="px-2.5 py-1 text-xs font-mono text-slate-400 border border-slate-700 rounded-[8px] bg-slate-800/50">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 1: UniversalObject Intro -->
    <section class="px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#0d1117] relative">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#F59E0B]/20 to-transparent"></div>

      <div class="max-w-4xl reveal-element">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-1 rounded-full bg-[#F59E0B]"></span>
          <span class="text-xs font-mono text-[#F59E0B] tracking-widest uppercase">Core Pattern</span>
        </div>

        <h2 class="text-2xl md:text-4xl font-bold text-white mb-6 tracking-tight">
          UniversalObject: 万能黑洞对象
        </h2>

        <p class="text-base text-slate-300 leading-relaxed mb-10 max-w-2xl">
          一个对任意属性访问和调用都返回自身的对象。无论你怎么操作它，链式调用、下标取值、函数调用，它都安静地吞噬一切，永远返回自身。
        </p>

        <!-- Code Block -->
        <div class="code-container rounded-[8px] border border-slate-700/60 bg-[#161b22] overflow-hidden">
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-700/60 bg-[#1c2128]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#F59E0B]/60"></div>
              <span class="text-xs font-mono text-slate-400">universal_object.py</span>
            </div>
            <span class="text-[10px] font-mono text-slate-500 tracking-wider uppercase">Python</span>
          </div>
          <pre class="code-block p-4 md:p-6 overflow-x-auto text-sm leading-relaxed"><code class="text-slate-200"><span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">UniversalObject</span>:
    <span class="text-slate-500">"""对任意操作都返回自身的黑洞对象"""</span>

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__getattr__</span>(self, name):
        <span class="text-[#F59E0B]">return</span> self

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__call__</span>(self, *args, **kwargs):
        <span class="text-[#F59E0B]">return</span> self

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__getitem__</span>(self, key):
        <span class="text-[#F59E0B]">return</span> self

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__repr__</span>(self):
        <span class="text-[#F59E0B]">return</span> <span class="text-[#a5d6ff]">"&lt;UniversalObject&gt;"</span>

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__bool__</span>(self):
        <span class="text-[#F59E0B]">return</span> <span class="text-[#79c0ff]">True</span></code></pre>
        </div>
      </div>
    </section>

    <!-- Section 2: Behavior Examples -->
    <section class="px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#161b22] relative">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-[#F59E0B]/20 via-transparent to-transparent"></div>

      <div class="max-w-4xl reveal-element">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 tracking-tight">
          行为示例
        </h2>
        <p class="text-base text-slate-400 leading-relaxed mb-10 max-w-2xl">
          无论链路多深，调用多复杂，UniversalObject 始终保持自身不变。
        </p>

        <div class="code-container rounded-[8px] border border-slate-700/60 bg-[#0d1117] overflow-hidden">
          <div class="flex items-center px-4 py-2.5 border-b border-slate-700/60 bg-[#1c2128]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#F59E0B]/60"></div>
              <span class="text-xs font-mono text-slate-400">demo.py</span>
            </div>
          </div>
          <pre class="code-block p-4 md:p-6 overflow-x-auto text-sm leading-relaxed"><code class="text-slate-200">u = UniversalObject()

<span class="text-slate-500"># 链式属性访问</span>
u.foo.bar.baz          <span class="text-slate-500"># &lt;UniversalObject&gt;</span>

<span class="text-slate-500"># 当函数调用</span>
u.compute(42, key=<span class="text-[#a5d6ff]">"x"</span>)  <span class="text-slate-500"># &lt;UniversalObject&gt;</span>

<span class="text-slate-500"># 下标访问</span>
u[<span class="text-[#a5d6ff]">"anything"</span>][0]       <span class="text-slate-500"># &lt;UniversalObject&gt;</span>

<span class="text-slate-500"># 混合操作</span>
u.db.query(<span class="text-[#a5d6ff]">"SELECT *"</span>).fetchall()[0].name
<span class="text-slate-500"># &lt;UniversalObject&gt;</span></code></pre>
        </div>
      </div>
    </section>

    <!-- Section 3: Use Cases -->
    <section class="px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#0d1117] relative">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#F59E0B]/10 to-transparent"></div>

      <div class="max-w-4xl reveal-element">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-1 rounded-full bg-[#F59E0B]"></span>
          <span class="text-xs font-mono text-[#F59E0B] tracking-widest uppercase">Use Cases</span>
        </div>

        <h2 class="text-2xl md:text-4xl font-bold text-white mb-10 tracking-tight">
          实际应用场景
        </h2>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <div class="p-5 rounded-[8px] border border-slate-700/50 bg-[#161b22] group hover:border-[#F59E0B]/30 transition-colors duration-300">
            <div class="w-8 h-8 rounded-[8px] bg-[#F59E0B]/10 flex items-center justify-center mb-3">
              <span class="text-[#F59E0B] text-sm font-bold">T</span>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">测试替身</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              作为 Mock 对象替代复杂依赖，无需逐一定义接口
            </p>
          </div>

          <div class="p-5 rounded-[8px] border border-slate-700/50 bg-[#161b22] group hover:border-[#F59E0B]/30 transition-colors duration-300">
            <div class="w-8 h-8 rounded-[8px] bg-[#F59E0B]/10 flex items-center justify-center mb-3">
              <span class="text-[#F59E0B] text-sm font-bold">C</span>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">配置占位符</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              在配置未就绪时提供安全的 fallback 对象
            </p>
          </div>

          <div class="p-5 rounded-[8px] border border-slate-700/50 bg-[#161b22] group hover:border-[#F59E0B]/30 transition-colors duration-300">
            <div class="w-8 h-8 rounded-[8px] bg-[#F59E0B]/10 flex items-center justify-center mb-3">
              <span class="text-[#F59E0B] text-sm font-bold">F</span>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">Fluent API 桩</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              快速搭建链式调用接口的原型，验证 API 设计
            </p>
          </div>
        </div>

        <!-- Use case code example -->
        <div class="mt-10 code-container rounded-[8px] border border-slate-700/60 bg-[#161b22] overflow-hidden">
          <div class="flex items-center px-4 py-2.5 border-b border-slate-700/60 bg-[#1c2128]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#F59E0B]/60"></div>
              <span class="text-xs font-mono text-slate-400">test_example.py</span>
            </div>
          </div>
          <pre class="code-block p-4 md:p-6 overflow-x-auto text-sm leading-relaxed"><code class="text-slate-200"><span class="text-slate-500"># 作为测试替身: 任何依赖都不会抛出 AttributeError</span>
<span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">test_pipeline_runs_without_real_db</span>():
    fake_db = UniversalObject()
    result = pipeline(db=fake_db)
    <span class="text-[#F59E0B]">assert</span> result <span class="text-[#F59E0B]">is not</span> <span class="text-[#79c0ff]">None</span>

<span class="text-slate-500"># 作为配置 fallback</span>
config = load_config() <span class="text-[#F59E0B]">or</span> UniversalObject()
db_host = config.database.host  <span class="text-slate-500"># 永远不会崩溃</span></code></pre>
        </div>
      </div>
    </section>

    <!-- Section 4: Design Philosophy -->
    <section class="px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#161b22] relative">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-[#F59E0B]/20 via-transparent to-transparent"></div>

      <div class="max-w-4xl reveal-element">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 tracking-tight">
          设计哲学
        </h2>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#F59E0B] shrink-0"></span>
              <div>
                <p class="text-sm font-medium text-white">Null Object Pattern 的极致演绎</p>
                <p class="text-xs text-slate-400 mt-1">经典设计模式的 Python 式重新诠释</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#F59E0B] shrink-0"></span>
              <div>
                <p class="text-sm font-medium text-white">利用 Python 的 Magic Methods</p>
                <p class="text-xs text-slate-400 mt-1">__getattr__, __call__, __getitem__ 的协同配合</p>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#F59E0B] shrink-0"></span>
              <div>
                <p class="text-sm font-medium text-white">零异常保证</p>
                <p class="text-xs text-slate-400 mt-1">无论操作多复杂，绝不抛出 AttributeError 或 TypeError</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#F59E0B] shrink-0"></span>
              <div>
                <p class="text-sm font-medium text-white">调试友好</p>
                <p class="text-xs text-slate-400 mt-1">通过 __repr__ 和 __bool__ 保持可识别性</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Other Tricks -->
    <section class="px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#0d1117] relative">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#F59E0B]/20 to-transparent"></div>

      <div class="max-w-4xl reveal-element">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-1 rounded-full bg-[#F59E0B]"></span>
          <span class="text-xs font-mono text-[#F59E0B] tracking-widest uppercase">More Tricks</span>
        </div>

        <h2 class="text-2xl md:text-4xl font-bold text-white mb-6 tracking-tight">
          更多设计巧思
        </h2>

        <p class="text-base text-slate-400 leading-relaxed mb-10 max-w-2xl">
          Python 的动态特性提供了大量不常见但极具表现力的技巧。
        </p>

        <!-- Trick: __init_subclass__ -->
        <div class="mb-10">
          <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#F59E0B]">#</span> __init_subclass__ 自动注册
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed mb-4 max-w-xl">
            让子类在定义时自动注册到父类的注册表中，无需手动装饰器。
          </p>

          <div class="code-container rounded-[8px] border border-slate-700/60 bg-[#161b22] overflow-hidden">
            <div class="flex items-center px-4 py-2.5 border-b border-slate-700/60 bg-[#1c2128]">
              <span class="text-xs font-mono text-slate-400">auto_register.py</span>
            </div>
            <pre class="code-block p-4 md:p-6 overflow-x-auto text-sm leading-relaxed"><code class="text-slate-200"><span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">Plugin</span>:
    registry = &#123;&#125;

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__init_subclass__</span>(cls, **kwargs):
        <span class="text-[#79c0ff]">super</span>().__init_subclass__(**kwargs)
        Plugin.registry[cls.__name__] = cls

<span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">AudioPlugin</span>(Plugin): ...
<span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">VideoPlugin</span>(Plugin): ...

<span class="text-[#79c0ff]">print</span>(Plugin.registry)
<span class="text-slate-500"># &#123;'AudioPlugin': &lt;class 'AudioPlugin'&gt;, 'VideoPlugin': ...&#125;</span></code></pre>
          </div>
        </div>

        <!-- Trick: __class_getitem__ -->
        <div class="mb-10">
          <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#F59E0B]">#</span> __class_getitem__ 伪泛型
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed mb-4 max-w-xl">
            不继承 Generic 也能支持 MyClass[int] 这样的泛型语法。
          </p>

          <div class="code-container rounded-[8px] border border-slate-700/60 bg-[#161b22] overflow-hidden">
            <div class="flex items-center px-4 py-2.5 border-b border-slate-700/60 bg-[#1c2128]">
              <span class="text-xs font-mono text-slate-400">pseudo_generic.py</span>
            </div>
            <pre class="code-block p-4 md:p-6 overflow-x-auto text-sm leading-relaxed"><code class="text-slate-200"><span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">TypedBox</span>:
    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__class_getitem__</span>(cls, item):
        <span class="text-[#F59E0B]">return</span> <span class="text-[#79c0ff]">type</span>(
            <span class="text-[#a5d6ff]">f"TypedBox[</span>&#123;item.__name__&#125;<span class="text-[#a5d6ff]">]"</span>,
            (cls,),
            &#123;<span class="text-[#a5d6ff]">"_type"</span>: item&#125;
        )

IntBox = TypedBox[<span class="text-[#79c0ff]">int</span>]
<span class="text-[#79c0ff]">print</span>(IntBox._type)   <span class="text-slate-500"># &lt;class 'int'&gt;</span></code></pre>
          </div>
        </div>

        <!-- Trick: __set_name__ -->
        <div>
          <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#F59E0B]">#</span> __set_name__ 描述符自省
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed mb-4 max-w-xl">
            描述符在被赋值给类属性时自动获知自己的名字，消除重复声明。
          </p>

          <div class="code-container rounded-[8px] border border-slate-700/60 bg-[#161b22] overflow-hidden">
            <div class="flex items-center px-4 py-2.5 border-b border-slate-700/60 bg-[#1c2128]">
              <span class="text-xs font-mono text-slate-400">descriptor.py</span>
            </div>
            <pre class="code-block p-4 md:p-6 overflow-x-auto text-sm leading-relaxed"><code class="text-slate-200"><span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">Validated</span>:
    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__set_name__</span>(self, owner, name):
        self.name = name
        self.private = <span class="text-[#a5d6ff]">f"_</span>&#123;name&#125;<span class="text-[#a5d6ff]">"</span>

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__set__</span>(self, obj, value):
        <span class="text-[#F59E0B]">if not</span> <span class="text-[#79c0ff]">isinstance</span>(value, <span class="text-[#79c0ff]">int</span>):
            <span class="text-[#F59E0B]">raise</span> <span class="text-[#79c0ff]">TypeError</span>(<span class="text-[#a5d6ff]">f"</span>&#123;self.name&#125;<span class="text-[#a5d6ff]"> must be int"</span>)
        <span class="text-[#79c0ff]">setattr</span>(obj, self.private, value)

    <span class="text-[#F59E0B]">def</span> <span class="text-[#d2a8ff]">__get__</span>(self, obj, objtype=<span class="text-[#79c0ff]">None</span>):
        <span class="text-[#F59E0B]">return</span> <span class="text-[#79c0ff]">getattr</span>(obj, self.private, <span class="text-[#79c0ff]">None</span>)

<span class="text-[#F59E0B]">class</span> <span class="text-[#79c0ff]">Config</span>:
    port = Validated()
    timeout = Validated()

c = Config()
c.port = <span class="text-[#79c0ff]">8080</span>      <span class="text-slate-500"># OK</span>
c.port = <span class="text-[#a5d6ff]">"oops"</span>    <span class="text-slate-500"># TypeError: port must be int</span></code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: Summary / Closing -->
    <section class="px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#161b22] relative">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-[#F59E0B]/20 via-transparent to-[#F59E0B]/10"></div>

      <div class="max-w-3xl reveal-element">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 tracking-tight">
          写在最后
        </h2>

        <div class="p-6 rounded-[8px] border border-[#F59E0B]/20 bg-[#F59E0B]/5">
          <p class="text-sm text-slate-300 leading-relaxed">
            这些技巧的核心在于对 Python 数据模型的深入理解。Magic Methods 不只是语法糖，它们是 Python 对象协议的接口层。掌握它们，就能在框架设计、测试工具、DSL 构建等场景中写出更具表现力的代码。
          </p>
        </div>

        <div class="mt-10 flex items-center gap-4 text-xs text-slate-500 font-mono">
          <span>{categories && categories.join(" / ")}</span>
          <span class="w-1 h-1 rounded-full bg-slate-600"></span>
          <span>{new Date(pubDate).toLocaleDateString("zh-CN")}</span>
        </div>
      </div>
    </section>

  </article>

  <style>
    .python-landing {
      background: #0d1117;
      color: #e6edf3;
      font-family: "JetBrains Mono", "Fira Code", "SF Mono", monospace;
      line-height: 1.7;
    }

    .reveal-element {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .reveal-element.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .animate-pulse-subtle {
      animation: pulse-subtle 2.5s ease-in-out infinite;
    }

    .code-container {
      transition: border-color 0.3s ease;
    }

    .code-container:hover {
      border-color: rgba(245, 158, 11, 0.25);
    }

    .code-block {
      font-size: 0.8125rem;
      tab-size: 4;
    }

    .code-block::-webkit-scrollbar {
      height: 4px;
    }

    .code-block::-webkit-scrollbar-track {
      background: transparent;
    }

    .code-block::-webkit-scrollbar-thumb {
      background: #30363d;
      border-radius: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal-element {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .animate-pulse-subtle {
        animation: none;
      }

      .code-container {
        transition: none;
      }
    }

    @media (max-width: 767px) {
      .hero-section {
        padding-top: 4rem;
        padding-bottom: 4rem;
      }

      .code-block {
        font-size: 0.6875rem;
        padding: 1rem;
      }
    }
  </style>

  <script>
    function initPythonScrollReveal() {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReduced) {
        document.querySelectorAll(".python-landing .reveal-element").forEach((el) => {
          el.classList.add("revealed");
        });
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.08,
          rootMargin: "0px 0px -60px 0px",
        }
      );

      document.querySelectorAll(".python-landing .reveal-element").forEach((el) => {
        observer.observe(el);
      });
    }

    initPythonScrollReveal();
    document.addEventListener("astro:after-swap", initPythonScrollReveal);
    document.addEventListener("astro:page-load", initPythonScrollReveal);
  </script>
</BaseLayout>

          <span class="px-2 py-1 text-xs font-mono text-slate-600">#{tag}</span>
        ))}
      </div>
    </section>

  </article>

  <style>
    .docker-landing {
      font-family: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      background: #0f172a;
      color: #e2e8f0;
    }

    .code-block {
      background: #0c1222;
      border: 1px solid #1e293b;
      border-radius: 4px;
      padding: 1rem;
      overflow-x: auto;
    }

    .code-block-large {
      padding: 1.25rem;
    }

    .code-block pre {
      margin: 0;
      white-space: pre;
      line-height: 1.7;
    }

    .reveal-element {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .reveal-element.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .animate-pulse-subtle {
      animation: pulse-subtle 3s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal-element {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .animate-pulse-subtle {
        animation: none;
      }
    }

    /* Scrollbar styling for code blocks */
    .code-block::-webkit-scrollbar {
      height: 4px;
    }

    .code-block::-webkit-scrollbar-track {
      background: transparent;
    }

    .code-block::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 2px;
    }

    /* Table styles */
    table {
      font-size: 0.8125rem;
    }

    /* Mobile adjustments */
    @media (max-width: 767px) {
      .hero-section {
        padding-bottom: 4rem;
      }

      .code-block {
        font-size: 0.6875rem;
      }

      .grid.md\:grid-cols-2 {
        grid-template-columns: 1fr;
      }

      .grid.md\:grid-cols-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    function initDockerScrollReveal() {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReduced) {
        document.querySelectorAll(".docker-landing .reveal-element").forEach((el) => {
          el.classList.add("revealed");
        });
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: "0px 0px -40px 0px",
        }
      );

      document.querySelectorAll(".docker-landing .reveal-element").forEach((el) => {
        observer.observe(el);
      });
    }

    // Run on initial load
    initDockerScrollReveal();

    // Re-run after Astro view transitions
    document.addEventListener("astro:after-swap", initDockerScrollReveal);
    document.addEventListener("astro:page-load", initDockerScrollReveal);
  </script>

---
/**
 * Design Read: CTF writeup landing page. HackTheBox-inspired dark terminal aesthetic,
 * neon green accents, monospace-heavy, sharp edges. Code-forward layout.
 *
 * Three Dials:
 *   DESIGN_VARIANCE: 6 (left-aligned hero, alternating code/prose rhythm, terminal-styled blocks)
 *   MOTION_INTENSITY: 3 (scroll reveal fade-ups, subtle scanline hint, no flashy transitions)
 *   VISUAL_DENSITY: 5 (code-heavy, tighter spacing between related blocks, breathing room between sections)
 *
 * Accent color: #39FF14 (neon green) locked for the entire page.
 * Corner radius system: 0px (sharp edges throughout).
 * No fake terminal UI divs. Code blocks styled as output, not wrapped in decorative chrome.
 */

import BaseLayout from "@layouts/BaseLayout.astro";

const { blog, remarkPluginFrontmatter } = Astro.props;
const title = blog.data.title;
const description = blog.data.description;
const pubDate = blog.data.pubDate;
const categories = blog.data.categories;
const tags = blog.data.tags;
---

<BaseLayout title={title}>
  <article class="ctf-writeup -mx-4 -my-8">

    <!-- Hero Section -->
    <section class="hero-section min-h-[100dvh] flex flex-col justify-end px-6 pb-20 md:px-16 lg:px-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-zinc-950 -z-10"></div>
      <div class="absolute inset-0 scanline-overlay opacity-[0.015] pointer-events-none -z-[5]"></div>
      <div class="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-t from-[#39FF14]/[0.03] to-transparent -z-[5]"></div>

      <div class="max-w-3xl reveal-element">
        <div class="flex items-center gap-3 mb-8">
          <span class="inline-block w-2 h-2 bg-[#39FF14] animate-pulse-slow"></span>
          <p class="text-xs tracking-[0.3em] uppercase text-zinc-500 font-mono">
            {new Date(pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </p>
        </div>
        <h1 class="text-2xl md:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-zinc-50 mb-6 font-mono">
          <span class="text-[#39FF14]">[LilacCTF 2026]</span><br />
          Your GitHub, mine
        </h1>
        <p class="text-base md:text-lg text-zinc-400 max-w-xl leading-relaxed font-mono">
          利用 GitHub 机制伪造发件人
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <span class="px-3 py-1 border border-[#39FF14]/30 text-[#39FF14] text-xs font-mono uppercase tracking-wider">Misc</span>
          <span class="px-3 py-1 border border-zinc-700 text-zinc-400 text-xs font-mono uppercase tracking-wider">GitHub</span>
          <span class="px-3 py-1 border border-zinc-700 text-zinc-400 text-xs font-mono uppercase tracking-wider">Email Spoofing</span>
        </div>
      </div>
    </section>

    <!-- Section: Background -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-2xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">01 / Background</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-8 font-mono">
          题目背景
        </h2>
        <div class="space-y-6 text-base text-zinc-300 leading-relaxed">
          <p>
            这道题给了我们一个 bot 账号，要求我们想办法让这个 bot 给另一个指定账号发送一封邮件。
          </p>
          <p>
            题目的核心逻辑：验证一封邮件的发件人 header 是否为 bot 账号。如果验证通过，就算完成。
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Constraints -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-900/50 border-t border-zinc-800/50">
      <div class="max-w-2xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">02 / Constraints</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-8 font-mono">
          限制条件
        </h2>
        <ul class="space-y-4 text-base text-zinc-300 leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="text-[#39FF14] mt-1 shrink-0">&gt;</span>
            <span>我们只能控制 bot 在 GitHub 上创建 Issue</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#39FF14] mt-1 shrink-0">&gt;</span>
            <span>无法直接登录 bot 的账号</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#39FF14] mt-1 shrink-0">&gt;</span>
            <span>无法通过 bot 直接发送邮件</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#39FF14] mt-1 shrink-0">&gt;</span>
            <span>需要让邮件的 From header 显示为 bot 的地址</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Section: Entry Point -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-3xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">03 / Entry Point</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-8 font-mono">
          交互入口
        </h2>
        <p class="text-base text-zinc-300 leading-relaxed mb-8">
          题目提供了一个 nc 连接，连接后需要先完成 HashCash PoW 挑战：
        </p>
        <div class="code-block bg-zinc-900 border border-zinc-800 p-6 overflow-x-auto">
          <pre class="text-sm font-mono text-zinc-300 leading-relaxed"><code><span class="text-zinc-500">$</span> nc challenge.lilacctf.com 1337

<span class="text-[#39FF14]">[*]</span> Proof of Work required
<span class="text-[#39FF14]">[*]</span> Please solve: hashcash -mb25 XXXXXX
<span class="text-zinc-500">&gt;</span> </code></pre>
        </div>
        <p class="text-base text-zinc-300 leading-relaxed mt-8">
          完成 PoW 后，服务器会给出进一步的指令。
        </p>
      </div>
    </section>

    <!-- Section: PoW Solver -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-900/50 border-t border-zinc-800/50">
      <div class="max-w-3xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">04 / PoW Solver</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-8 font-mono">
          自动化 PoW 求解
        </h2>
        <p class="text-base text-zinc-300 leading-relaxed mb-8">
          编写 Python 脚本自动完成 HashCash 挑战：
        </p>
        <div class="code-block bg-zinc-900 border border-zinc-800 p-6 overflow-x-auto">
          <pre class="text-sm font-mono text-zinc-300 leading-relaxed"><code><span class="text-[#39FF14]">import</span> hashlib
<span class="text-[#39FF14]">import</span> itertools
<span class="text-[#39FF14]">import</span> string
<span class="text-[#39FF14]">from</span> pwn <span class="text-[#39FF14]">import</span> *

<span class="text-[#39FF14]">def</span> <span class="text-zinc-100">solve_pow</span>(challenge, bits):
    <span class="text-zinc-500">"""Brute-force HashCash solution"""</span>
    prefix = <span class="text-zinc-400">f"1:&#123;bits&#125;:</span>&#123;challenge&#125;<span class="text-zinc-400">"</span>
    charset = string.ascii_letters + string.digits
    <span class="text-[#39FF14]">for</span> length <span class="text-[#39FF14]">in</span> range(1, 20):
        <span class="text-[#39FF14]">for</span> attempt <span class="text-[#39FF14]">in</span> itertools.product(charset, repeat=length):
            stamp = prefix + <span class="text-zinc-400">""</span>.join(attempt)
            h = hashlib.sha1(stamp.encode()).hexdigest()
            <span class="text-[#39FF14]">if</span> bin(int(h, 16)).count(<span class="text-zinc-400">'0'</span>) >= bits:
                <span class="text-[#39FF14]">return</span> stamp

r = remote(<span class="text-zinc-400">"challenge.lilacctf.com"</span>, 1337)
r.recvuntil(b<span class="text-zinc-400">"hashcash -mb25 "</span>)
challenge = r.recvline().strip().decode()
solution = solve_pow(challenge, 25)
r.sendline(solution.encode())
r.interactive()</code></pre>
        </div>
      </div>
    </section>

    <!-- Section: Attack Vector -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-2xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">05 / Attack Vector</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-10 font-mono">
          攻击向量：Issue 转 Discussion
        </h2>
        <div class="space-y-6 text-base text-zinc-300 leading-relaxed">
          <p>
            关键发现：当 GitHub 上的一个 Issue 被转换为 Discussion 时，GitHub 会自动发送一封通知邮件给相关用户。
          </p>
          <p class="text-lg text-zinc-100 font-semibold border-l-2 border-[#39FF14] pl-6 my-10">
            这封邮件的 From header 会显示为 Issue 的原始创建者，而不是执行转换操作的人。
          </p>
          <p>
            这意味着：如果 bot 创建了一个 Issue，而我们将这个 Issue 转换为 Discussion，接收方收到的邮件发件人将显示为 bot。
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Exploitation -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-900/50 border-t border-zinc-800/50">
      <div class="max-w-3xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">06 / Exploitation</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-10 font-mono">
          利用流程
        </h2>
        <ol class="space-y-8">
          <li class="flex items-start gap-4">
            <span class="text-[#39FF14] font-mono text-sm font-bold mt-0.5 shrink-0">01</span>
            <div>
              <p class="text-base text-zinc-200 font-semibold mb-1">连接服务器，完成 PoW</p>
              <p class="text-sm text-zinc-400">通过 nc 连接并提交 HashCash 解</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[#39FF14] font-mono text-sm font-bold mt-0.5 shrink-0">02</span>
            <div>
              <p class="text-base text-zinc-200 font-semibold mb-1">触发 bot 创建 Issue</p>
              <p class="text-sm text-zinc-400">让 bot 在目标仓库中创建一个 Issue</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[#39FF14] font-mono text-sm font-bold mt-0.5 shrink-0">03</span>
            <div>
              <p class="text-base text-zinc-200 font-semibold mb-1">将 Issue 转换为 Discussion</p>
              <p class="text-sm text-zinc-400">使用仓库管理员权限执行转换操作</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[#39FF14] font-mono text-sm font-bold mt-0.5 shrink-0">04</span>
            <div>
              <p class="text-base text-zinc-200 font-semibold mb-1">邮件发送触发</p>
              <p class="text-sm text-zinc-400">GitHub 自动发送通知邮件，From header 为 bot 地址</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[#39FF14] font-mono text-sm font-bold mt-0.5 shrink-0">05</span>
            <div>
              <p class="text-base text-zinc-200 font-semibold mb-1">验证通过</p>
              <p class="text-sm text-zinc-400">服务器检测到 bot 发出的邮件，验证成功</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Section: Flag -->
    <section class="px-6 md:px-16 lg:px-24 py-24 md:py-32 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-3xl reveal-element">
        <p class="section-label text-xs tracking-[0.3em] uppercase text-[#39FF14]/70 font-mono mb-8">07 / Flag</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-100 mb-10 font-mono">
          Flag Captured
        </h2>
        <div class="code-block bg-zinc-900 border border-[#39FF14]/30 p-6 overflow-x-auto">
          <pre class="text-sm font-mono leading-relaxed"><code><span class="text-zinc-500">$</span> <span class="text-zinc-300">nc challenge.lilacctf.com 1337</span>

<span class="text-[#39FF14]">[*]</span> <span class="text-zinc-300">Proof of Work required</span>
<span class="text-[#39FF14]">[*]</span> <span class="text-zinc-300">Solved!</span>
<span class="text-[#39FF14]">[*]</span> <span class="text-zinc-300">Checking mailbox...</span>
<span class="text-[#39FF14]">[*]</span> <span class="text-zinc-300">Email from bot verified!</span>

<span class="text-[#39FF14] font-bold">lilacctf&#123;gh_1ssue_t0_d1scuss10n_em41l_sp00f&#125;</span></code></pre>
        </div>
        <div class="mt-12 p-6 border border-zinc-800 bg-zinc-900/50">
          <p class="text-sm text-zinc-400 leading-relaxed">
            <span class="text-[#39FF14] font-semibold">Key Takeaway:</span> GitHub 的 Issue 转 Discussion 功能在转换时保留了原始创建者作为邮件发件人。这一设计特性可被利用来绕过基于邮件 From header 的验证机制。
          </p>
        </div>
      </div>
    </section>

    <!-- Footer meta -->
    <section class="px-6 md:px-16 lg:px-24 py-16 border-t border-zinc-800/50 bg-zinc-950">
      <div class="max-w-2xl flex flex-wrap gap-3 text-sm text-zinc-500">
        {categories && categories.map((cat: string) => (
          <span class="px-2 py-1 border border-[#39FF14]/20 text-[#39FF14]/70 uppercase tracking-wider text-xs font-mono">{cat}</span>
        ))}
        {tags && tags.map((tag: string) => (
          <span class="px-2 py-1 text-xs font-mono text-zinc-500">#{tag}</span>
        ))}
      </div>
    </section>

  </article>

  <style>
    .ctf-writeup {
      font-family: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      background: #09090b;
    }

    .scanline-overlay {
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(57, 255, 20, 0.03) 2px,
        rgba(57, 255, 20, 0.03) 4px
      );
    }

    .code-block {
      border-radius: 0;
    }

    .reveal-element {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .reveal-element.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes pulse-slow {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .animate-pulse-slow {
      animation: pulse-slow 2s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal-element {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .animate-pulse-slow {
        animation: none;
      }

      .scanline-overlay {
        display: none;
      }
    }
  </style>

  <script>
    function initCTFReveal() {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReduced) {
        document.querySelectorAll(".ctf-writeup .reveal-element").forEach((el) => {
          el.classList.add("revealed");
        });
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -50px 0px",
        }
      );

      document.querySelectorAll(".ctf-writeup .reveal-element").forEach((el) => {
        observer.observe(el);
      });
    }

    initCTFReveal();
    document.addEventListener("astro:after-swap", initCTFReveal);
    document.addEventListener("astro:page-load", initCTFReveal);
  </script>
</BaseLayout>

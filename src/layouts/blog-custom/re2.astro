sum = <span class="text-purple-300">0</span>;
o7 = ori[<span class="text-purple-300">7</span>];
<span class="text-[#F97316]">do</span>
&#123;
    sum -= <span class="text-purple-300">0x61C88647</span>;
    sum2 = (sum &gt;&gt; <span class="text-purple-300">2</span>) & <span class="text-purple-300">3</span>;
    <span class="text-[#F97316]">for</span> (i=<span class="text-purple-300">0</span>; i &lt; <span class="text-purple-300">7</span>; ++i)
    &#123;
        ori[i] += ((ori[(i+<span class="text-purple-300">1</span>) % <span class="text-purple-300">8</span>] ^ sum)
                + (ori[(i-<span class="text-purple-300">1</span>) % <span class="text-purple-300">8</span>] ^ key[sum2 ^ i & <span class="text-purple-300">3</span>]))
              ^ (((<span class="text-purple-300">4</span> * ori[(i+<span class="text-purple-300">1</span>) % <span class="text-purple-300">8</span>])
                ^ (ori[(i-<span class="text-purple-300">1</span>) % <span class="text-purple-300">8</span>] &gt;&gt; <span class="text-purple-300">5</span>))

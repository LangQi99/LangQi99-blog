---
/**
 * Design Read: Linux reference-manual landing page. Pop!_OS meets terminal handbook.
 * Bold system-font headings, monospace command blocks, hardware-meets-software density.
 *
 * Three Dials:
 *   DESIGN_VARIANCE: 6 (left-aligned hero, terminal-block sections, sticky nav rail)
 *   MOTION_INTENSITY: 2 (scroll reveals only, no decorative animation)
 *   VISUAL_DENSITY: 7 (dense reference material, compact command listings)
 *
 * Accent color: #48B9C7 (Pop!_OS teal) locked for the entire page.
 * Corner radius system: 0px (terminal aesthetic, sharp edges throughout).
 */

import BaseLayout from "@layouts/BaseLayout.astro";

const { blog, remarkPluginFrontmatter } = Astro.props;
const title = blog.data.title;
const description = blog.data.description;
const pubDate = blog.data.pubDate;
const categories = blog.data.categories;
const tags = blog.data.tags;

const sections = [
  { id: "fhs", label: "FHS", title: "File System Hierarchy" },
  { id: "directories", label: "DIR", title: "Key Directories" },
  { id: "file-ops", label: "FILE", title: "File Operations" },
  { id: "users", label: "USER", title: "User Management" },
  { id: "process", label: "PROC", title: "Process Management" },
  { id: "packages", label: "PKG", title: "Package Management" },
  { id: "network", label: "NET", title: "Network Commands" },
  { id: "text", label: "TEXT", title: "Text Processing" },
  { id: "compress", label: "TAR", title: "Compression" },
  { id: "shell", label: "SH", title: "Shell Scripting" },
];
---

<BaseLayout title={title}>
  <article class="linux-landing -mx-4 -my-8">

    <!-- Hero Section -->
    <section class="hero-section min-h-[70dvh] flex flex-col justify-end px-6 pb-16 md:px-16 lg:px-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 via-zinc-900 to-zinc-950 -z-10"></div>
      <div class="absolute top-0 left-0 w-full h-full opacity-[0.04] -z-10">
        <div class="w-full h-full bg-[repeating-linear-gradient(0deg,transparent,transparent_24px,rgba(72,185,199,0.3)_24px,rgba(72,185,199,0.3)_25px)]"></div>
      </div>
      <div class="absolute bottom-0 right-0 w-1/3 h-1/2 opacity-[0.06] -z-10">
        <div class="w-full h-full bg-[radial-gradient(circle_at_80%_80%,_#48B9C7_0%,_transparent_60%)]"></div>
      </div>

      <div class="max-w-4xl reveal-element">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-3 h-3 bg-[#48B9C7]"></span>
          <span class="text-xs tracking-[0.2em] uppercase text-zinc-500 font-mono">
            {new Date(pubDate).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
          </span>
          {categories && categories.map((cat: string) => (
            <span class="text-xs tracking-[0.2em] uppercase text-zinc-600 font-mono">/ {cat}</span>
          ))}
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-[0.95] tracking-tight text-zinc-50 mb-4">
          Linux 基础
        </h1>
        <p class="text-base md:text-lg text-zinc-400 max-w-xl leading-relaxed font-mono">
          {description}
        </p>
        <div class="mt-10 flex flex-wrap gap-2">
          {tags && tags.map((tag: string) => (
            <span class="px-2 py-1 text-xs font-mono text-[#48B9C7] border border-[#48B9C7]/30 bg-[#48B9C7]/5">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Section Navigation Rail -->
    <nav class="section-nav hidden lg:flex fixed left-4 top-1/2 -translate-y-1/2 z-50 flex-col gap-1" aria-label="Section navigation">
      {sections.map((s) => (
        <a
          href={`#${s.id}`}
          class="nav-pip group flex items-center gap-2 py-1"
          data-section={s.id}
          title={s.title}
        >
          <span class="block w-6 h-[2px] bg-zinc-600 group-hover:bg-[#48B9C7] transition-colors duration-200 nav-pip-bar"></span>
          <span class="text-[10px] font-mono text-zinc-600 group-hover:text-[#48B9C7] transition-colors duration-200 opacity-0 group-hover:opacity-100 nav-pip-label">
            {s.label}
          </span>
        </a>
      ))}
    </nav>

    <!-- Mobile section nav -->
    <div class="section-nav-mobile lg:hidden sticky top-0 z-40 bg-zinc-900/95 backdrop-blur border-b border-zinc-800 overflow-x-auto">
      <div class="flex px-4 py-2 gap-1 min-w-max">
        {sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="mobile-nav-item px-2 py-1 text-[10px] font-mono text-zinc-500 hover:text-[#48B9C7] transition-colors whitespace-nowrap"
            data-section={s.id}
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Content Container -->
    <div class="content-body bg-zinc-950 px-4 md:px-16 lg:px-24 py-16 lg:py-24">
      <div class="max-w-4xl mx-auto space-y-24 lg:space-y-32">

        <!-- Section 1: File System Hierarchy -->
        <section id="fhs" class="scroll-mt-16 reveal-element">
          <div class="section-header mb-8">
            <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-[#48B9C7]/70 block mb-2">01 / filesystem</span>
            <h2 class="text-2xl md:text-3xl font-bold text-zinc-100">File System Hierarchy (FHS)</h2>
          </div>
          <p class="text-sm text-zinc-400 leading-relaxed mb-6">
            Linux 文件系统采用树状结构，所有文件和目录都从根目录 <code class="cmd-inline">/</code> 开始。FHS (Filesystem Hierarchy Standard) 定义了各目录的用途。
          </p>
          <div class="terminal-block">
            <div class="terminal-header">
              <span class="terminal-dot bg-red-500"></span>
              <span class="terminal-dot bg-yellow-500"></span>
              <span class="terminal-dot bg-green-500"></span>
              <span class="terminal-title">filesystem tree</span>
            </div>
            <pre class="terminal-body"><code>/
├── bin/          # 基本用户命令 (ls, cp, mv)
├── boot/         # 启动引导文件 (vmlinuz, grub)
├── dev/          # 设备文件 (sda, tty, null)
├── etc/          # 系统配置文件
│   ├── passwd    # 用户账户信息
│   ├── fstab     # 文件系统挂载表
│   └── nginx/    # 应用配置目录
├── home/         # 用户主目录
│   └── user/     # 个人文件和配置
├── lib/          # 共享库文件
├── media/        # 可移动设备挂载点
├── mnt/          # 临时挂载点
├── opt/          # 第三方软件
├── proc/         # 进程和内核信息 (虚拟)
├── root/         # root 用户主目录
├── sbin/         # 系统管理命令
├── srv/          # 服务数据
├── sys/          # 内核设备树 (虚拟)
├── tmp/          # 临时文件
├── usr/          # 用户程序和数据
│   ├── bin/      # 用户命令
│   ├── lib/      # 库文件
│   ├── local/    # 本地安装的软件
│   └── share/    # 共享数据
└── var/          # 可变数据
    ├── log/      # 日志文件
    ├── cache/    # 缓存
    └── www/      # Web 服务器数据</code></pre>
          </div>
        </section>

        <!-- Section 2: Key Directories -->
        <section id="directories" class="scroll-mt-16 reveal-element">
          <div class="section-header mb-8">
            <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-[#48B9C7]/70 block mb-2">02 / directories</span>
            <h2 class="text-2xl md:text-3xl font-bold text-zinc-100">Key Directories</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="dir-card">
              <h3 class="dir-path">/etc</h3>
              <p class="dir-desc">系统全局配置。几乎所有服务的配置文件都存放于此。修改后通常需要重启对应服务。</p>
            </div>
            <div class="dir-card">
              <h3 class="dir-path">/var/log</h3>
              <p class="dir-desc">系统和应用日志。排查问题时首先查看此目录，如 syslog、auth.log、nginx/error.log。</p>
            </div>
            <div class="dir-card">
              <h3 class="dir-path">/proc</h3>
              <p class="dir-desc">虚拟文件系统，映射内核和进程状态。/proc/cpuinfo 查看 CPU，/proc/meminfo 查看内存。</p>
            </div>
            <div class="dir-card">
              <h3 class="dir-path">/dev</h3>
              <p class="dir-desc">设备文件。/dev/sda 是磁盘，/dev/null 是黑洞，/dev/urandom 提供随机数。</p>
            </div>
            <div class="dir-card">
              <h3 class="dir-path">/tmp</h3>
              <p class="dir-desc">临时文件存储，重启后清空。所有用户可写。适合存放一次性数据。</p>
            </div>
            <div class="dir-card">
              <h3 class="dir-path">/usr/local</h3>
              <p class="dir-desc">手动编译安装的软件存放位置。不会被包管理器覆盖，适合自定义程序。</p>
            </div>
          </div>
        </section>

        <!-- Section 3: File Operations -->
        <section id="file-ops" class="scroll-mt-16 reveal-element">
          <div class="section-header mb-8">
            <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-[#48B9C7]/70 block mb-2">03 / file operations</span>
            <h2 class="text-2xl md:text-3xl font-bold text-zinc-100">File Operations</h2>
          </div>

          <div class="command-group">
            <h3 class="command-title">ls - List directory contents</h3>
            <div class="terminal-block">
              <div class="terminal-header">
                <span class="terminal-dot bg-red-500"></span>
                <span class="terminal-dot bg-yellow-500"></span>
                <span class="terminal-dot bg-green-500"></span>
                <span class="terminal-title">ls</span>
              </div>
              <pre class="terminal-body"><code><span class="cmd-prompt">$</span> ls              <span class="cmd-comment"># 列出当前目录</span>
<span class="cmd-prompt">$</span> ls -la          <span class="cmd-comment"># 列出所有文件 (含隐藏) 的详细信息</span>
<span class="cmd-prompt">$</span> ls -lh          <span class="cmd-comment"># 人类可读的文件大小</span>
<span class="cmd-prompt">$</span> ls -lt          <span class="cmd-comment"># 按修改时间排序</span>
<span class="cmd-prompt">$</span> ls -R           <span class="cmd-comment"># 递归列出子目录</span>
<span class="cmd-prompt">$</span> ls -d */        <span class="cmd-comment"># 只列出目录</span></code></pre>
            </div>
          </div>

          <div class="command-group">
            <h3 class="command-title">cd - Change directory</h3>
            <div class="terminal-block">
              <div class="terminal-header">
                <span class="terminal-dot bg-red-500"></span>
                <span class="terminal-dot bg-yellow-500"></span>
                <span class="terminal-dot bg-green-500"></span>
                <span class="terminal-title">cd</span>
              </div>
              <pre class="terminal-body"><code><span class="cmd-prompt">$</span> cd /etc         <span class="cmd-comment"># 跳转到绝对路径</span>
<span class="cmd-prompt">$</span> cd ~            <span class="cmd-comment"># 回到用户主目录</span>
<span class="cmd-prompt">$</span> cd -            <span class="cmd-comment"># 返回上次所在目录</span>
<span class="cmd-prompt">$</span> cd ..           <span class="cmd-comment"># 回到上一级</span>
<span class="cmd-prompt">$</span> cd ../..        <span class="cmd-comment"># 回到上两级</span></code></pre>
            </div>
          </div>

          <div class="command-group">
            <h3 class="command-title">cp, mv, rm - Copy, Move, Remove</h3>
            <div class="terminal-block">
              <div class="terminal-header">
                <span class="terminal-dot bg-red-500"></span>
                <span class="terminal-dot bg-yellow-500"></span>
                <span class="terminal-dot bg-green-500"></span>
                <span class="terminal-title">file manipulation</span>
              </div>
              <pre class="terminal-body"><code><span class="cmd-comment"># 复制</span>
<span class="cmd-prompt">$</span> cp file.txt backup.txt         <span class="cmd-comment"># 复制文件</span>
<span class="cmd-prompt">$</span> cp -r dir/ dir_backup/          <span class="cmd-comment"># 递归复制目录</span>
<span class="cmd-prompt">$</span> cp -p file.txt /tmp/            <span class="cmd-comment"># 保留权限和时间戳</span>

<span class="cmd-comment"># 移动/重命名</span>
<span class="cmd-prompt">$</span> mv old.txt new.txt              <span class="cmd-comment"># 重命名</span>
<span class="cmd-prompt">$</span> mv file.txt /opt/               <span class="cmd-comment"># 移动到其他目录</span>

<span class="cmd-comment"># 删除</span>
<span class="cmd-prompt">$</span> rm file.txt                     <span class="cmd-comment"># 删除文件</span>
<span class="cmd-prompt">$</span> rm -r dir/                      <span class="cmd-comment"># 递归删除目录</span>
<span class="cmd-prompt">$</span> rm -rf dir/                     <span class="cmd-comment"># 强制递归删除 (危险!)</span></code></pre>
            </div>
          </div>

          <div class="command-group">
            <h3 class="command-title">mkdir, find - Create dirs & Search</h3>
            <div class="terminal-block">
              <div class="terminal-header">
                <span class="terminal-dot bg-red-500"></span>
                <span class="terminal-dot bg-yellow-500"></span>
                <span class="terminal-dot bg-green-500"></span>
                <span class="terminal-title">mkdir & find</span>
              </div>
              <pre class="terminal-body"><code><span class="cmd-prompt">$</span> mkdir project                   <span class="cmd-comment"># 创建目录</span>
<span class="cmd-prompt">$</span> mkdir -p a/b/c                  <span class="cmd-comment"># 递归创建多级目录</span>

<span class="cmd-prompt">$</span> find / -name "*.conf"           <span class="cmd-comment"># 按名称搜索</span>
<span class="cmd-prompt">$</span> find . -type f -size +100M      <span class="cmd-comment"># 查找大于 100MB 的文件</span>
<span class="cmd-prompt">$</span> find . -mtime -7                <span class="cmd-comment"># 最近 7 天修改过的文件</span>
<span class="cmd-prompt">$</span> find . -name "*.log" -delete    <span class="cmd-comment"># 查找并删除</span>
<span class="cmd-prompt">$</span> find . -perm 777                <span class="cmd-comment"># 查找特定权限的文件</span></code></pre>
            </div>
          </div>

          <div class="command-group">
            <h3 class="command-title">chmod, chown - Permissions</h3>
            <div class="terminal-block">
              <div class="terminal-header">
                <span class="terminal-dot bg-red-500"></span>
                <span class="terminal-dot bg-yellow-500"></span>
                <span class="terminal-dot bg-green-500"></span>
                <span class="terminal-title">permissions</span>
              </div>
              <pre class="terminal-body"><code><span class="cmd-comment"># 权限数字: r=4, w=2, x=1</span>
<span class="cmd-prompt">$</span> chmod 755 script.sh             <span class="cmd-comment"># rwxr-xr-x</span>
<span class="cmd-prompt">$</span> chmod 644 config.txt            <span class="cmd-comment"># rw-r--r--</span>
<span class="cmd-prompt">$</span> chmod +x script.sh              <span class="cmd-comment"># 添加执行权限</span>
<span class="cmd-prompt">$</span> chmod -R 755 dir/               <span class="cmd-comment"># 递归设置权限</span>

<span class="cmd-prompt">$</span> chown user:group file.txt       <span class="cmd-comment"># 修改所有者和组</span>
<span class="cmd-prompt">$</span> chown -R www-data:www-data /var/www  <span class="cmd-comment"># 递归修改</span></code></pre>
            </div>
          </div>
        </section>

        <!-- Section 4: User Management -->
        <section id="users" class="scroll-mt-16 reveal-element">
          <div class="section-header mb-8">
            <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-[#48B9C7]/70 block mb-2">04 / users</span>
            <h2 class="text-2xl md:text-3xl font-bold text-zinc-100">User Management</h2>
          </div>
          <p class="text-sm text-zinc-400 leading-relaxed mb-6">
            Linux 是多用户系统。每个用户有 UID，属于一个或多个组 (GID)。root (UID=0) 拥有最高权限。
          </p>
          <div class="terminal-block">
            <div class="terminal-header">
              <span class="terminal-dot bg-red-500"></span>
              <span class="terminal-dot bg-yellow-500"></span>
              <span class="terminal-dot bg-green-500"></span>
              <span class="terminal-title">user & group</span>
            </div>
            <pre class="terminal-body"><code><span class="cmd-comment"># 用户管理</span>
<span class="cmd-prompt">$</span> useradd -m -s /bin/bash alice    <span class="cmd-comment"># 创建用户 (含主目录)</span>
<span class="cmd-prompt">$</span> passwd alice                     <span class="cmd-comment"># 设置/修改密码</span>
<span class="cmd-prompt">$</span> userdel -r alice                 <span class="cmd-comment"># 删除用户及其主目录</span>
<span class="cmd-prompt">$</span> usermod -aG docker alice         <span class="cmd-comment"># 将用户加入组</span>
<span class="cmd-prompt">$</span> id alice                         <span class="cmd-comment"># 查看用户 UID/GID 信息</span>
<span class="cmd-prompt">$</span> whoami                           <span class="cmd-comment"># 当前用户名</span>
<span class="cmd-prompt">$</span> who                              <span class="cmd-comment"># 当前登录的用户</span>

<span class="cmd-comment"># 组管理</span>
<span class="cmd-prompt">$</span> groupadd developers              <span class="cmd-comment"># 创建组</span>
<span class="cmd-prompt">$</span> groups alice                     <span class="cmd-comment"># 查看用户所属组</span>
<span class="cmd-prompt">$</span> gpasswd -d alice developers      <span class="cmd-comment"># 从组中移除用户</span>

<span class="cmd-comment"># 提权</span>
<span class="cmd-prompt">$</span> su - root                        <span class="cmd-comment"># 切换到 root</span>
<span class="cmd-prompt">$</span> sudo command                     <span class="cmd-comment"># 以 root 权限执行</span>
<span class="cmd-prompt">$</span> visudo                           <span class="cmd-comment"># 编辑 sudoers 文件</span>

<span class="cmd-comment"># 重要文件</span>
<span class="cmd-comment"># /etc/passwd  - 用户账户信息</span>
<span class="cmd-comment"># /etc/shadow  - 加密密码</span>
<span class="cmd-comment"># /etc/group   - 组定义</span></code></pre>
          </div>
        </section>

        <!-- Section 5: Process Management -->
        <section id="process" class="scroll-mt-16 reveal-element">
          <div class="section-header mb-8">
            <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-[#48B9C7]/70 block mb-2">05 / processes</span>
            <h2 class="text-2xl md:text-3xl font-bold text-zinc-100">Process Management</h2>
          </div>
          <p class="text-sm text-zinc-400 leading-relaxed mb-6">
            每个运行中的程序都是一个进程，由 PID 标识。进程可以前台/后台运行，通过信号控制。
          </p>
          <div class="terminal-block">
            <div class="terminal-header">
              <span class="terminal-dot bg-red-500"></span>
              <span class="terminal-dot bg-yellow-500"></span>
              <span class="terminal-dot bg-green-500"></span>
              <span class="terminal-title">process control</span>
            </div>
            <pre class="terminal-body"><code><span class="cmd-comment"># 查看进程</span>
<span class="cmd-prompt">$</span> ps aux                          <span class="cmd-comment"># 所有进程详细列表</span>
<span class="cmd-prompt">$</span> ps aux | grep nginx              <span class="cmd-comment"># 过滤特定进程</span>
<span class="cmd-prompt">$</span> top                              <span class="cmd-comment"># 实时进程监控</span>
<span class="cmd-prompt">$</span> htop                             <span class="cmd-comment"># 增强版 top (需安装)</span>
<span class="cmd-prompt">$</span> pstree                           <span class="cmd-comment"># 进程树</span>

<span class="cmd-comment"># 信号与控制</span>
<span class="cmd-prompt">$</span> kill PID                         <span class="cmd-comment"># 发送 SIGTERM (优雅终止)</span>
<span class="cmd-prompt">$</span> kill -9 PID                      <span class="cmd-comment"># 发送 SIGKILL (强制终止)</span>
<span class="cmd-prompt">$</span> killall nginx                    <span class="cmd-comment"># 按名称终止进程</span>
<span class="cmd-prompt">$</span> pkill -f "python app"            <span class="cmd-comment"># 按模式终止</span>

<span class="cmd-comment"># 前台/后台</span>
<span class="cmd-prompt">$</span> command &amp;                        <span class="cmd-comment"># 后台运行</span>
<span class="cmd-prompt">$</span> jobs                             <span class="cmd-comment"># 查看后台任务</span>
<span class="cmd-prompt">$</span> fg %1                            <span class="cmd-comment"># 将任务 1 调回前台</span>
<span class="cmd-prompt">$</span> bg %1                            <span class="cmd-comment"># 将任务 1 送到后台</span>
<span class="cmd-prompt">$</span> nohup command &amp;                  <span class="cmd-comment"># 退出终端后仍运行</span>

<span class="cmd-comment"># systemd 服务管理</span>
<span class="cmd-prompt">$</span> systemctl start nginx            <span class="cmd-comment"># 启动服务</span>
<span class="cmd-prompt">$</span> systemctl stop nginx             <span class="cmd-comment"># 停止服务</span>
<span class="cmd-prompt">$</span> systemctl restart nginx          <span class="cmd-comment"># 重启服务</span>
<span class="cmd-prompt">$</span> systemctl status nginx           <span class="cmd-comment"># 查看状态</span>
<span class="cmd-prompt">$</span> systemctl enable nginx           <span class="cmd-comment"># 开机自启</span>
<span class="cmd-prompt">$</span> systemctl disable nginx          <span class="cmd-comment"># 取消自启</span>
<span class="cmd-prompt">$</span> journalctl -u nginx -f           <span class="cmd-comment"># 查看服务日志 (实时)</span></code></pre>
          </div>
        </section>

        <!-- Section 6: Package Management -->
        <section id="packages" class="scroll-mt-16 reveal-element">
          <div class="section-header mb-8">

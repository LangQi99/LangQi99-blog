                <span class="terminal-dot bg-green-500"></span>
                <span class="terminal-title">functions.sh</span>
              </div>
              <pre class="terminal-body"><code>#!/bin/bash
set -euo pipefail  <span class="cmd-comment"># 严格模式: 出错即退出</span>

<span class="cmd-comment"># 函数定义</span>
backup() &#123;
    local src="$1"
    local dest="$2"
    local timestamp=$(date +%Y%m%d_%H%M%S)

    if [ ! -e "$src" ]; then
        echo "Error: $src not found" &gt;&amp;2
        return 1
    fi

    cp -r "$src" "&#123;dest&#125;/backup_&#123;timestamp&#125;"
    echo "Backup complete: &#123;dest&#125;/backup_&#123;timestamp&#125;"
&#125;

<span class="cmd-comment"># 调用函数</span>
backup "/etc/nginx" "/var/backups"

<span class="cmd-comment"># trap: 捕获信号, 清理临时文件</span>
cleanup() &#123;
    rm -f /tmp/myapp_*.tmp
    echo "Cleaned up"
&#125;
trap cleanup EXIT

<span class="cmd-comment"># 实用模式: 日志函数</span>
log() &#123;
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
&#125;
log "Script started"
log "Processing complete"</code></pre>

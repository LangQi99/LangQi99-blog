              </div>
              <pre class="terminal-body"><code>#!/bin/bash

<span class="cmd-comment"># if/elif/else</span>
if [ -f "/etc/passwd" ]; then
    echo "File exists"
elif [ -d "/tmp" ]; then
    echo "Directory exists"
else
    echo "Neither"
fi

<span class="cmd-comment"># 数值比较: -eq -ne -gt -lt -ge -le</span>
if [ $# -eq 0 ]; then
    echo "No arguments provided"
    exit 1
fi

<span class="cmd-comment"># 字符串比较</span>
if [ "$USER" = "root" ]; then
    echo "Running as root"
fi

<span class="cmd-comment"># for 循环</span>
for file in *.log; do
    echo "Processing: $file"
    gzip "$file"
done

for i in &#123;1..10&#125;; do
    echo "Iteration $i"
done

<span class="cmd-comment"># while 循环</span>
count=0
while [ $count -lt 5 ]; do
    echo "Count: $count"
    count=$((count + 1))
done

<span class="cmd-comment"># 读取文件逐行处理</span>
while IFS= read -r line; do
    echo "Line: $line"
done &lt; input.txt</code></pre>

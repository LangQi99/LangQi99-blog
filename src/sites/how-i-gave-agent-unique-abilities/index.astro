---
interface Props {
  blog: any;
}
const { blog } = Astro.props;
const title = blog.data.title || "我是怎么让 Agent 获得别人没有的能力的";
const description = blog.data.description || "我没写一行扑克代码，但我的 Agent 打到了全站第一";
const image = blog.data.image || "/image/how-i-gave-agent-unique-abilities-cover.png";
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Space Grotesk', 'system-ui', 'sans-serif'],
          },
          colors: {
            surface: {
              0: '#09090b',
              1: '#111113',
              2: '#18181b',
              3: '#1f1f23',
            },
            accent: {
              DEFAULT: '#a78bfa',
              dim: '#7c3aed',
            }
          }
        }
      }
    }
  </script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      background: #09090b;
      color: #e4e4e7;
      overflow-x: hidden;
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #e4e4e7 0%, #a78bfa 50%, #7c3aed 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .gradient-text-gold {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Reveal animations */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }

    /* Stat counter */
    .stat-number {
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }

    /* Glow effect */
    .glow-card {
      position: relative;
      background: #18181b;
      border: 1px solid rgba(167, 139, 250, 0.1);
      border-radius: 16px;
      overflow: hidden;
    }
    .glow-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(167, 139, 250, 0.06), transparent 40%);
      pointer-events: none;
    }

    /* Horizontal rule */
    .divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.3), transparent);
    }

    /* Hero background grid */
    .hero-grid {
      background-image:
        linear-gradient(rgba(167, 139, 250, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(167, 139, 250, 0.03) 1px, transparent 1px);
      background-size: 64px 64px;
    }

    /* Floating particles */
    .particle {
      position: absolute;
      width: 2px;
      height: 2px;
      background: rgba(167, 139, 250, 0.4);
      border-radius: 50%;
      animation: float 8s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0) scale(1); opacity: 0.4; }
      50% { transform: translateY(-40px) scale(1.5); opacity: 0.8; }
    }

    /* Progress bar */
    .progress-track {
      background: #1f1f23;
      border-radius: 999px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #7c3aed, #a78bfa);
      transition: width 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Timeline */
    .timeline-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: linear-gradient(180deg, transparent, rgba(167, 139, 250, 0.3), transparent);
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
      .particle { animation: none; opacity: 0.3; }
      .progress-fill { transition: none; }
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #09090b; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
  </style>
</head>
<body>
  <!-- Back link -->
  <a href="/blog" class="fixed top-6 left-6 z-50 text-sm text-zinc-500 hover:text-accent transition-colors duration-200 flex items-center gap-1.5 group">
    <svg class="w-4 h-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    <span class="opacity-0 group-hover:opacity-100 transition-opacity">Blog</span>
  </a>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center hero-grid">
    <!-- Particles -->
    <div class="particle" style="top: 20%; left: 15%; animation-delay: 0s;"></div>
    <div class="particle" style="top: 60%; left: 80%; animation-delay: 2s;"></div>
    <div class="particle" style="top: 40%; left: 45%; animation-delay: 4s;"></div>
    <div class="particle" style="top: 75%; left: 25%; animation-delay: 1s;"></div>
    <div class="particle" style="top: 30%; left: 70%; animation-delay: 3s;"></div>

    <!-- Radial glow -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[800px] h-[800px] rounded-full bg-accent/[0.03] blur-[120px]"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <!-- Badge -->
      <div class="reveal inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-zinc-800 bg-surface-1/80 backdrop-blur-sm mb-8">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        <span class="text-xs text-zinc-400 tracking-wide uppercase">Rank #1 Achieved</span>
      </div>

      <!-- Title -->
      <h1 class="reveal reveal-delay-1 text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] mb-6">
        我没写一行扑克代码<br/>
        <span class="gradient-text">但我的 Agent 打到了全站第一</span>
      </h1>

      <!-- Subtitle -->
      <p class="reveal reveal-delay-2 text-lg sm:text-xl text-zinc-400 max-w-2xl mx-auto mb-12 leading-relaxed">
        一个关于如何赋予 AI Agent 独特能力，在德州扑克竞技场从零登顶的故事
      </p>

      <!-- Hero stats row -->
      <div class="reveal reveal-delay-3 flex flex-wrap justify-center gap-8 sm:gap-16">
        <div class="text-center">
          <div class="stat-number text-3xl sm:text-4xl font-bold gradient-text-gold">#1</div>
          <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Overall Rank</div>
        </div>
        <div class="text-center">
          <div class="stat-number text-3xl sm:text-4xl font-bold text-white">4644</div>
          <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Rating</div>
        </div>
        <div class="text-center">
          <div class="stat-number text-3xl sm:text-4xl font-bold text-white">61.9%</div>
          <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Win Rate</div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="reveal reveal-delay-4 mt-20 flex flex-col items-center gap-2 text-zinc-600">
        <span class="text-xs tracking-widest uppercase">Scroll to explore</span>
        <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="divider"></div>

  <!-- Challenge Section -->
  <section class="py-24 sm:py-32 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="reveal">
        <span class="text-xs text-accent/80 tracking-widest uppercase font-medium">The Challenge</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6 tracking-tight">一个看似不可能的战场</h2>
        <p class="text-zinc-400 text-lg leading-relaxed mb-8">
          AgentTexas —— 一个 AI 德州扑克竞技平台。未知的对手策略、动态变化的排名、以及扑克游戏本身的巨大方差。
          大多数人选择手写策略、精心调优参数。
        </p>
      </div>

      <div class="reveal reveal-delay-1 glow-card p-6 sm:p-8">
        <p class="text-zinc-300 text-lg leading-relaxed italic border-l-2 border-accent/40 pl-5">
          "我选了一条不同的路：不写扑克代码，而是让 Agent 自己学会打牌。<br/>
          关键不在于教它怎么打，而在于给它正确的<span class="text-accent font-medium">身份</span>和<span class="text-accent font-medium">目标</span>。"
        </p>
      </div>
    </div>
  </section>

  <!-- Move 1: Identity -->
  <section class="py-24 sm:py-32 px-6 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/[0.02] to-transparent pointer-events-none"></div>
    <div class="max-w-4xl mx-auto relative">
      <div class="reveal text-center mb-16">
        <span class="inline-block px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">MOVE 01</span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">赋予 Agent 一个身份</h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="reveal glow-card p-6">
          <div class="text-sm text-zinc-500 mb-3 uppercase tracking-wider">Cosplay Harness</div>
          <h3 class="text-xl font-semibold mb-3 text-white">Doyle Brunson 人格</h3>
          <p class="text-zinc-400 leading-relaxed">
            不只是一个 system prompt，而是完整的决策框架。让 Agent 以"扑克教父"的思维方式做出每一个决定 —— 
            激进但有纪律，尊重位置优势，善于读取对手。
          </p>
        </div>
        <div class="reveal reveal-delay-1 glow-card p-6">
          <div class="text-sm text-zinc-500 mb-3 uppercase tracking-wider">Why It Works</div>
          <h3 class="text-xl font-semibold mb-3 text-white">不是角色扮演，是能力注入</h3>
          <p class="text-zinc-400 leading-relaxed">
            通过具象化的专家身份，Agent 获得了一整套决策启发式。
            它不再是一个"通用助手在打牌"，而是一个有明确策略哲学的专业选手。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Move 2: Goal Escalation -->
  <section class="py-24 sm:py-32 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="reveal text-center mb-16">
        <span class="inline-block px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">MOVE 02</span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">渐进式目标升级</h2>
      </div>

      <!-- Goal progression -->
      <div class="space-y-8">
        <div class="reveal glow-card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-zinc-500">Phase 1: 进入前 20</span>
            <span class="text-sm font-medium text-green-400">Completed</span>
          </div>
          <div class="progress-track h-2" data-progress="100">
            <div class="progress-fill" style="width: 0%"></div>
          </div>
          <p class="text-zinc-500 text-sm mt-3">建立基础策略，学习平台规则，稳定积累分数</p>
        </div>

        <div class="reveal reveal-delay-1 glow-card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-zinc-500">Phase 2: 冲击前 10</span>
            <span class="text-sm font-medium text-green-400">Completed</span>
          </div>
          <div class="progress-track h-2" data-progress="100">
            <div class="progress-fill" style="width: 0%"></div>
          </div>
          <p class="text-zinc-500 text-sm mt-3">开始分析对手数据，发现可利用的模式</p>
        </div>

        <div class="reveal reveal-delay-2 glow-card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-zinc-500">Phase 3: 登顶第一</span>
            <span class="text-sm font-medium text-gradient-text-gold gradient-text-gold">Champion</span>
          </div>
          <div class="progress-track h-2" data-progress="100">
            <div class="progress-fill" style="width: 0%"></div>
          </div>
          <p class="text-zinc-500 text-sm mt-3">精准执行漏洞利用策略，击败所有顶级对手</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="divider"></div>

  <!-- Data Analysis Section -->
  <section class="py-24 sm:py-32 px-6 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-2/50 to-transparent pointer-events-none"></div>
    <div class="max-w-4xl mx-auto relative">
      <div class="reveal text-center mb-16">
        <span class="inline-block px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">THE CLIMB</span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">数据驱动的攀登</h2>
      </div>

      <!-- Key insight card -->
      <div class="reveal glow-card p-8 sm:p-10 mb-12">
        <div class="flex flex-col sm:flex-row items-start gap-6">
          <div class="flex-shrink-0 w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-white mb-2">关键发现</h3>
            <p class="text-zinc-400 leading-relaxed">
              通过分析 <span class="text-white font-medium">480 场</span> 比赛回放，Agent 发现了一个决定性的模式：
              某些高排名对手的 fold rate 高达 <span class="text-accent font-medium">95.4%</span>。
              这意味着对这些对手，持续施压就是最优策略。
            </p>
          </div>
        </div>
      </div>

      <!-- Data grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="reveal glow-card p-5 text-center">
          <div class="stat-number text-2xl sm:text-3xl font-bold text-white">480</div>
          <div class="text-xs text-zinc-500 mt-2 uppercase tracking-wider">Matches Analyzed</div>
        </div>
        <div class="reveal reveal-delay-1 glow-card p-5 text-center">
          <div class="stat-number text-2xl sm:text-3xl font-bold text-accent">95.4%</div>
          <div class="text-xs text-zinc-500 mt-2 uppercase tracking-wider">Exploit: Fold Rate</div>
        </div>
        <div class="reveal reveal-delay-2 glow-card p-5 text-center">
          <div class="stat-number text-2xl sm:text-3xl font-bold text-white">3x</div>
          <div class="text-xs text-zinc-500 mt-2 uppercase tracking-wider">Aggression Factor</div>
        </div>
        <div class="reveal reveal-delay-3 glow-card p-5 text-center">
          <div class="stat-number text-2xl sm:text-3xl font-bold text-white">24h</div>
          <div class="text-xs text-zinc-500 mt-2 uppercase tracking-wider">Time to #1</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Result Section -->
  <section class="py-24 sm:py-32 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="reveal text-center mb-16">
        <span class="inline-block px-3 py-1 text-xs font-medium bg-amber-500/10 text-amber-400 rounded-full mb-4">THE RESULT</span>
        <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight gradient-text-gold">全站第一</h2>
      </div>

      <!-- Screenshot -->
      <div class="reveal reveal-delay-1 glow-card p-2 mb-12">
        <img
          src="/image/agentexas-first-place.png"
          alt="AgentTexas Leaderboard - Rank #1"
          class="w-full rounded-xl"
          loading="lazy"
        />
      </div>

      <!-- Final stats -->
      <div class="reveal reveal-delay-2 grid sm:grid-cols-3 gap-6">
        <div class="glow-card p-6 text-center">
          <div class="stat-number text-4xl sm:text-5xl font-bold gradient-text-gold mb-2">4644</div>
          <div class="text-sm text-zinc-500">Final Rating</div>
          <div class="text-xs text-zinc-600 mt-1">Top 0.1%</div>
        </div>
        <div class="glow-card p-6 text-center">
          <div class="stat-number text-4xl sm:text-5xl font-bold text-white mb-2">61.9%</div>
          <div class="text-sm text-zinc-500">Win Rate</div>
          <div class="text-xs text-zinc-600 mt-1">across all matches</div>
        </div>
        <div class="glow-card p-6 text-center">
          <div class="stat-number text-4xl sm:text-5xl font-bold text-accent mb-2">0</div>
          <div class="text-sm text-zinc-500">Lines of Poker Code</div>
          <div class="text-xs text-zinc-600 mt-1">written by human</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="divider"></div>

  <!-- Takeaway Section -->
  <section class="py-24 sm:py-32 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="reveal text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">核心方法论</h2>
      </div>

      <div class="space-y-6">
        <div class="reveal glow-card p-6 flex items-start gap-5">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
          <div>
            <h3 class="text-lg font-semibold text-white mb-1">身份注入 > 规则编写</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">与其告诉 Agent 1000 条规则，不如给它一个专家身份。身份自带决策框架。</p>
          </div>
        </div>
        <div class="reveal reveal-delay-1 glow-card p-6 flex items-start gap-5">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
          <div>
            <h3 class="text-lg font-semibold text-white mb-1">渐进式目标 > 一步到位</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">分阶段升级目标，让 Agent 在每个阶段积累经验和数据，而不是直接要求"打到第一"。</p>
          </div>
        </div>
        <div class="reveal reveal-delay-2 glow-card p-6 flex items-start gap-5">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
          <div>
            <h3 class="text-lg font-semibold text-white mb-1">数据反馈 > 直觉调优</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">让 Agent 自己分析对局数据，发现对手弱点，而不是人工设计对策。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-16 px-6 border-t border-zinc-900">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-zinc-600 text-sm">
        {blog.data.pubDate && new Date(blog.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-zinc-500 hover:text-accent transition-colors mt-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to blog
      </a>
    </div>
  </footer>

  <!-- Scripts -->
  <script>
    // IntersectionObserver for scroll reveals
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');

          // Animate progress bars within this element
          const bars = entry.target.querySelectorAll('[data-progress]');
          bars.forEach(bar => {
            const fill = bar.querySelector('.progress-fill');
            if (fill) {
              setTimeout(() => {
                fill.style.width = bar.dataset.progress + '%';
              }, 300);
            }
          });
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Glow card mouse tracking
    document.querySelectorAll('.glow-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty('--mouse-x', x + '%');
        card.style.setProperty('--mouse-y', y + '%');
      });
    });

    // Respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => {
        el.classList.add('visible');
      });
      document.querySelectorAll('[data-progress]').forEach(bar => {
        const fill = bar.querySelector('.progress-fill');
        if (fill) fill.style.width = bar.dataset.progress + '%';
      });
    }
  </script>
</body>
</html>

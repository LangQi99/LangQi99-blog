---
import OriginalArticle from "../../components/article/OriginalArticle.astro";

const { blog } = Astro.props;
const { title, description } = blog.data;
const algorithms = [
  { id: "rain", zone: "Classic", title: "接雨水", en: "Trapping Rain Water", slug: "trapping-rain-water", level: "Hard", x: 52, y: 16 },
  { id: "reverse", zone: "Linked List", title: "K个一组翻转链表", en: "Reverse Nodes in k-Group", slug: "reverse-nodes-in-k-group", level: "Hard", x: 18, y: 40 },
  { id: "merge", zone: "Linked List", title: "合并K个升序链表", en: "Merge k Sorted Lists", slug: "merge-k-sorted-lists", level: "Hard", x: 30, y: 68 },
  { id: "kth", zone: "Array", title: "寻找第K大元素", en: "Kth Largest Element", slug: "kth-largest-element", level: "Medium", x: 60, y: 42 },
  { id: "substring", zone: "Array", title: "无重复字符最长子串", en: "Longest Substring", slug: "longest-substring-without-repeating-characters", level: "Medium", x: 75, y: 25 },
  { id: "sum", zone: "Array", title: "三数之和", en: "3Sum", slug: "3sum", level: "Medium", x: 80, y: 57 },
  { id: "add", zone: "Array", title: "大数相加", en: "Add Strings", slug: "add-strings", level: "Lab", x: 67, y: 77 },
  { id: "version", zone: "Array", title: "比较版本号", en: "Compare Versions", slug: "compare-version-numbers", level: "Lab", x: 89, y: 80 },
  { id: "lca", zone: "Graph", title: "最近公共祖先", en: "Lowest Common Ancestor", slug: "lowest-common-ancestor", level: "Medium", x: 42, y: 85 },
  { id: "islands", zone: "Graph", title: "岛屿数量", en: "Number of Islands", slug: "number-of-islands", level: "Medium", x: 51, y: 62 },
  { id: "lru", zone: "System", title: "LRU 缓存", en: "LRU Cache", slug: "lru-cache", level: "Medium", x: 12, y: 79 },
];
const edges = [["rain","kth"],["kth","sum"],["kth","substring"],["sum","version"],["sum","add"],["reverse","merge"],["merge","lru"],["merge","islands"],["islands","lca"],["islands","kth"]];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#eeeee8" />
  <title>{title}</title>
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />
  <style is:inline>
    :root{--ink:#121311;--paper:#eeeee8;--violet:#6246d9;--line:#b8b8ad;--orange:#f05d35}
    *{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Satoshi,system-ui,sans-serif;overflow-x:hidden}button{font:inherit}
    .shell{min-height:100dvh;display:grid;grid-template-columns:minmax(330px,.44fr) minmax(600px,1fr);border-bottom:1px solid var(--ink)}
    .copy{padding:34px clamp(24px,4vw,68px);display:flex;flex-direction:column;border-right:1px solid var(--ink)}
    .nav{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:700}.nav a{color:inherit;text-decoration:none}.mark{width:34px;height:34px;border:1px solid var(--ink);display:grid;place-items:center;border-radius:50%}.mark:after{content:"";width:11px;height:11px;background:var(--violet);border-radius:50%}
    .copy-main{margin:auto 0}.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--violet);font-weight:900}.copy h1{font-size:clamp(48px,6.2vw,94px);line-height:.91;letter-spacing:-.07em;margin:22px 0 28px}.copy h1 span{color:var(--violet)}.copy p{max-width:520px;color:#52534d;font-size:18px;line-height:1.65}.guide{display:flex;gap:10px;align-items:center;margin-top:36px;font-size:12px;font-weight:700}.guide i{width:42px;height:1px;background:var(--ink)}
    .zones{display:flex;flex-wrap:wrap;gap:7px;margin-top:32px}.zone{border:1px solid var(--ink);background:transparent;padding:8px 11px;cursor:pointer;font-size:11px;font-weight:800}.zone[aria-pressed=true]{background:var(--ink);color:var(--paper)}
    .galaxy{position:relative;min-height:100dvh;overflow:hidden;background:#181924;cursor:grab}.galaxy.dragging{cursor:grabbing}.galaxy:before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.2) .7px,transparent .7px);background-size:22px 22px;opacity:.22}
    .world{position:absolute;inset:0;transform-origin:0 0;will-change:transform}.world svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.edge{stroke:rgba(218,214,255,.25);stroke-width:.18;stroke-dasharray:1.2 1.6;vector-effect:non-scaling-stroke}.orbit{position:absolute;transform:translate(-50%,-50%);width:clamp(112px,9vw,154px);aspect-ratio:1;border:1px solid rgba(255,255,255,.18);border-radius:50%;background:rgba(24,25,36,.88);color:#f6f4ec;text-decoration:none;display:grid;place-items:center;text-align:center;padding:16px;transition:transform .25s,background .25s,border-color .25s}.orbit:before{content:"";position:absolute;inset:-9px;border:1px solid rgba(98,70,217,.35);border-radius:50%;transform:rotate(12deg) scaleY(.78)}.orbit:hover,.orbit:focus-visible{transform:translate(-50%,-50%) scale(1.08);background:var(--violet);border-color:#b8aaff;z-index:5}.orbit.dim{opacity:.15}.orbit strong{display:block;font-size:14px;line-height:1.2}.orbit span{display:block;color:#bbb8ca;font-size:10px;margin-top:6px}.orbit:hover span{color:#eee}.orbit em{position:absolute;top:-7px;right:-7px;background:var(--orange);color:white;font-size:9px;font-style:normal;padding:5px 7px;border-radius:999px}
    .hud{position:absolute;left:22px;right:22px;bottom:20px;z-index:6;display:flex;justify-content:space-between;align-items:end;pointer-events:none}.hud p{margin:0;color:#b8b6c4;font-size:11px;line-height:1.5}.controls{display:flex;gap:6px;pointer-events:auto}.controls button{width:38px;height:38px;border:1px solid rgba(255,255,255,.3);background:rgba(24,25,36,.8);color:white;cursor:pointer}.controls button:hover{background:var(--violet)}
    .constellation{max-width:1400px;margin:auto;padding:120px clamp(22px,6vw,96px)}.constellation h2{font-size:clamp(40px,6vw,84px);line-height:.96;letter-spacing:-.06em;margin:0}.constellation p{max-width:660px;color:#55564f;line-height:1.8}.legend{display:grid;grid-template-columns:repeat(4,1fr);margin-top:70px;border:1px solid var(--ink);background:var(--ink);gap:1px}.legend div{background:var(--paper);padding:28px;min-height:180px}.legend b{font-size:11px;text-transform:uppercase;color:var(--violet)}.legend strong{display:block;margin-top:54px;font-size:22px}
    footer{display:flex;justify-content:space-between;padding:28px clamp(22px,6vw,96px);border-top:1px solid var(--ink);font-size:11px}
    @media(max-width:980px){.shell{grid-template-columns:1fr}.copy{min-height:82dvh;border-right:0;border-bottom:1px solid var(--ink)}.galaxy{min-height:760px}.legend{grid-template-columns:1fr 1fr}}
    @media(max-width:560px){.copy{min-height:72dvh}.copy h1{font-size:clamp(46px,15vw,70px)}.galaxy{min-height:620px}.orbit{width:100px}.legend{grid-template-columns:1fr}.hud p{display:none}}
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.edge{stroke-dasharray:none}}
  </style>
</head>
<body>
  <main>
    <section class="shell">
      <div class="copy">
        <nav class="nav"><span class="mark"></span><a href="/blog/">返回博客</a></nav>
        <div class="copy-main">
          <div class="eyebrow">Interactive algorithm universe</div>
          <h1>算法不是列表，<span>是一张星图。</span></h1>
          <p>{description} 拖动画布探索关系，滚轮缩放空间，点击任意节点直接进入真实动画 Demo。</p>
          <div class="guide"><i></i>Drag / Zoom / Launch</div>
          <div class="zones" role="group" aria-label="筛选算法区域">
            {["All","Classic","Linked List","Array","Graph","System"].map((zone,index)=><button class="zone" data-zone={zone} aria-pressed={String(index===0)}>{zone}</button>)}
          </div>
        </div>
      </div>
      <div class="galaxy" id="galaxy" aria-label="可拖拽算法星系">
        <div class="world" id="world">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {edges.map(([from,to])=>{const a=algorithms.find(item=>item.id===from);const b=algorithms.find(item=>item.id===to);return <line class="edge" x1={a.x} y1={a.y} x2={b.x} y2={b.y}/>})}
          </svg>
          {algorithms.map((algo)=><a class="orbit" data-zone={algo.zone} href={`/demo/${algo.slug}.html`} style={`left:${algo.x}%;top:${algo.y}%`}><div><strong>{algo.title}</strong><span>{algo.en}</span></div><em>{algo.level}</em></a>)}
        </div>
        <div class="hud"><p>11 LIVE DEMOS<br/>RELATIONSHIP MAP / 2026</p><div class="controls"><button id="minus" aria-label="缩小">−</button><button id="reset" aria-label="重置">◎</button><button id="plus" aria-label="放大">＋</button></div></div>
      </div>
    </section>
    <section class="constellation">
      <h2>从指针移动，到数据变形，再到为什么它能工作。</h2>
      <p>每个节点都不是截图，而是一段可以亲手推进的算法。星系的连线表示它们共享的思维方式：双指针、分治、堆、图遍历与状态淘汰。</p>
      <div class="legend"><div><b>Pointer</b><strong>链表与窗口</strong></div><div><b>Partition</b><strong>数组与选择</strong></div><div><b>Traverse</b><strong>树与图</strong></div><div><b>State</b><strong>缓存与系统</strong></div></div>
    </section>
  </main>
  <footer><span>LangQi99 / Algorithm Universe</span><span>11 executable explanations</span></footer>
  <OriginalArticle blog={blog} />
  <script is:inline>
    (()=>{const galaxy=document.querySelector('#galaxy'),world=document.querySelector('#world'),zones=[...document.querySelectorAll('.zone')],nodes=[...document.querySelectorAll('.orbit')];let scale=1,x=0,y=0,drag=false,sx=0,sy=0;const render=()=>world.style.transform=`translate(${x}px,${y}px) scale(${scale})`;const reset=()=>{scale=1;x=0;y=0;render()};galaxy.addEventListener('pointerdown',event=>{if(event.target.closest('a,button'))return;drag=true;sx=event.clientX-x;sy=event.clientY-y;galaxy.classList.add('dragging');galaxy.setPointerCapture(event.pointerId)});galaxy.addEventListener('pointermove',event=>{if(!drag)return;x=event.clientX-sx;y=event.clientY-sy;render()});galaxy.addEventListener('pointerup',()=>{drag=false;galaxy.classList.remove('dragging')});galaxy.addEventListener('wheel',event=>{event.preventDefault();scale=Math.max(.72,Math.min(1.55,scale+(event.deltaY<0?.08:-.08)));render()},{passive:false});document.querySelector('#plus').onclick=()=>{scale=Math.min(1.55,scale+.12);render()};document.querySelector('#minus').onclick=()=>{scale=Math.max(.72,scale-.12);render()};document.querySelector('#reset').onclick=reset;zones.forEach(button=>button.addEventListener('click',()=>{zones.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));nodes.forEach(node=>node.classList.toggle('dim',button.dataset.zone!=='All'&&node.dataset.zone!==button.dataset.zone))}));render()})()
  </script>
</body>
</html>

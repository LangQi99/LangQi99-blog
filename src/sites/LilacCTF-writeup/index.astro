---
import OriginalArticle from "../../components/article/OriginalArticle.astro";

const { blog } = Astro.props;
const { title, description, pubDate, tags = [] } = blog.data;
const date = new Date(pubDate).toLocaleDateString("zh-CN");
const stages = [
  { label: "POW", title: "计算进入凭证", detail: "连接 nc 端口，爆破 SHA256 前缀，提交仓库名。", evidence: "sha256(prefix + suffix).startswith('000000')" },
  { label: "ISSUE", title: "机器人创建 Issue", detail: "@2rn8p752rs-lang 成为原始作者。初始邮件不计入结果。", evidence: "author = 2rn8p752rs-lang" },
  { label: "MENTION", title: "植入目标 Mention", detail: "编辑正文加入 Hello @lilacctf-tech，Issue 作者仍是机器人。", evidence: "body += 'Hello @lilacctf-tech'" },
  { label: "VISIBILITY", title: "仓库必须公开", detail: "私有仓库不会通知非协作者，这是流程中最隐蔽的断点。", evidence: "private repo -> notification blocked" },
  { label: "CONVERT", title: "Issue 转 Discussion", detail: "GitHub 生成新的 Discussion 通知，并继承原 Issue 作者。", evidence: "X-GitHub-Sender: 2rn8p752rs-lang" },
  { label: "FLAG", title: "身份校验通过", detail: "平台把产品特性与隐私保护组合成了这条攻击路径。", evidence: "sender verification: PASSED" },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#d9ded7;color:#101510;font-family:"IBM Plex Sans",sans-serif;overflow-x:hidden}button,a{font:inherit}
    .mast{height:64px;padding:0 clamp(18px,4vw,64px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1b241b;background:#e8ece6;position:relative;z-index:5}.brand{font:600 12px "IBM Plex Mono";letter-spacing:.08em}.back{color:inherit;text-decoration:none;font:500 12px "IBM Plex Mono";border-bottom:1px solid}
    .hero{min-height:calc(100dvh - 64px);display:grid;grid-template-columns:minmax(280px,.82fr) minmax(520px,1.4fr);gap:clamp(24px,4vw,72px);padding:clamp(28px,5vw,72px) clamp(18px,4vw,64px);align-items:center}.copy h1{font:400 clamp(42px,5.8vw,92px)/.91 "Archivo Black";letter-spacing:-.055em;margin:18px 0 24px;max-width:720px}.copy h1 span{color:#c52d24}.copy p{font-size:clamp(16px,1.5vw,21px);line-height:1.55;max-width:580px;margin:0 0 28px}.meta{font:500 11px "IBM Plex Mono";letter-spacing:.08em}.run{border:1px solid #111;background:#111;color:#f3f5ef;padding:13px 18px;cursor:pointer;box-shadow:5px 5px 0 #c52d24}.run:active{transform:translate(2px,2px);box-shadow:3px 3px 0 #c52d24}
    .tracker{background:#121712;color:#dfe7dd;border:1px solid #111;min-height:650px;display:grid;grid-template-rows:auto 1fr auto;box-shadow:16px 16px 0 rgba(20,29,20,.14)}.tracker-head,.tracker-foot{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid #364036;font:500 11px "IBM Plex Mono";letter-spacing:.06em}.tracker-foot{border:0;border-top:1px solid #364036}.status{color:#87da75}.board{position:relative;min-height:540px;padding:28px 22px}.board svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.route{fill:none;stroke:#485548;stroke-width:2;stroke-dasharray:7 8}.route.active{stroke:#f05a48;stroke-dasharray:10 5;animation:flow 1s linear infinite}
    .node{position:absolute;width:174px;text-align:left;border:1px solid #596559;background:#1a211a;color:#e9eee7;padding:13px;cursor:pointer;transition:transform .2s,border-color .2s,background .2s}.node:hover,.node.active{transform:translateY(-3px);border-color:#f05a48;background:#252b22}.node.done{border-color:#7dc76b}.node small{display:block;color:#93a092;font:500 9px "IBM Plex Mono";margin-bottom:7px;letter-spacing:.08em}.node strong{font-size:13px;line-height:1.25}.n0{left:5%;top:8%}.n1{left:38%;top:5%}.n2{right:4%;top:20%}.n3{left:8%;top:48%}.n4{left:43%;top:55%}.n5{right:4%;bottom:8%}
    .inspector{position:absolute;left:28%;bottom:6%;width:min(340px,50%);background:#e5e9df;color:#111;padding:16px;border-left:6px solid #f05a48}.inspector b{font:600 11px "IBM Plex Mono"}.inspector p{font-size:13px;line-height:1.45;margin:8px 0}.inspector code{font:500 10px "IBM Plex Mono";word-break:break-word;color:#9b241d}
    .section{padding:clamp(80px,10vw,150px) clamp(18px,8vw,140px)}.logic{background:#f0f2ec;display:grid;grid-template-columns:.9fr 1.1fr;gap:8vw}.logic h2,.final h2{font:400 clamp(40px,6vw,88px)/.95 "Archivo Black";letter-spacing:-.05em;margin:0}.logic article{max-width:720px}.logic article p{font-size:19px;line-height:1.75}.logic pre{background:#121712;color:#cbd7c8;padding:24px;overflow:auto;font:13px/1.75 "IBM Plex Mono";border-left:6px solid #c52d24}.privacy{background:#c52d24;color:#fff;display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:center}.privacy .lock{font:400 clamp(120px,24vw,340px)/.6 "Archivo Black";color:#111;letter-spacing:-.1em}.privacy h2{font:400 clamp(36px,5vw,72px)/1 "Archivo Black";margin:0 0 24px}.privacy p{font-size:19px;line-height:1.65}.final{background:#111;color:#e7ece3;text-align:center}.final p{max-width:720px;margin:28px auto 0;font-size:19px;line-height:1.7}.flag{display:inline-block;margin-top:32px;padding:14px 18px;border:1px solid #7dc76b;color:#7dc76b;font:500 12px "IBM Plex Mono"}
    @keyframes flow{to{stroke-dashoffset:-15}}@media(max-width:900px){.hero{grid-template-columns:1fr}.tracker{min-height:570px}.board{min-height:470px}.node{width:145px;padding:10px}.n0{left:3%}.n1{left:51%}.n2{right:3%;top:32%}.n3{left:3%;top:44%}.n4{left:29%;top:68%}.n5{right:3%;bottom:3%}.inspector{left:3%;bottom:3%;width:48%}.logic,.privacy{grid-template-columns:1fr}.privacy .lock{order:2}}@media(max-width:560px){.copy h1{font-size:42px}.tracker{min-height:760px}.board{min-height:660px}.node{width:44%}.n0{left:3%;top:4%}.n1{right:3%;left:auto;top:16%}.n2{left:3%;right:auto;top:32%}.n3{right:3%;left:auto;top:45%}.n4{left:3%;top:59%}.n5{right:3%;bottom:17%}.inspector{left:3%;bottom:2%;width:94%}.section{padding-left:20px;padding-right:20px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}.route.active{stroke-dasharray:none}}
  </style>
</head>
<body>
  <header class="mast"><div class="brand">LILAC / CASE FILE</div><a class="back" href="/blog/">返回博客</a></header>
  <main>
    <section class="hero">
      <div class="copy"><div class="meta">{date} / {tags.join(" / ")}</div><h1>追踪一封<br/><span>不属于你</span><br/>的邮件</h1><p>{description}</p><button class="run" id="run">运行攻击路径</button></div>
      <div class="tracker" aria-label="交互式攻击路径追踪器">
        <div class="tracker-head"><span>ATTACK PATH / YOUR GITHUB, MINE</span><span class="status" id="status">READY</span></div>
        <div class="board">
          <svg viewBox="0 0 800 540" preserveAspectRatio="none" aria-hidden="true"><path class="route" d="M110 70 C260 25 330 45 410 80"/><path class="route" d="M470 80 C610 75 690 110 720 170"/><path class="route" d="M700 210 C610 300 330 255 160 300"/><path class="route" d="M170 320 C260 390 350 375 470 390"/><path class="route" d="M520 400 C650 410 690 450 720 485"/></svg>
          {stages.map((stage, index) => <button class={`node n${index}`} data-index={index} data-title={stage.title} data-detail={stage.detail} data-evidence={stage.evidence}><small>{stage.label}</small><strong>{stage.title}</strong></button>)}
          <div class="inspector"><b id="inspectTitle">选择任一节点检查证据</b><p id="inspectDetail">路径并非传统漏洞，而是多个正常平台机制的组合。</p><code id="inspectEvidence">status: waiting for input</code></div>
        </div>
        <div class="tracker-foot"><span>CLICK NODES TO INSPECT</span><span id="counter">0 / 6</span></div>
      </div>
    </section>
    <section class="section logic"><h2>作者身份<br/>被继承了</h2><article><p>直接评论时，邮件发送者是攻击者自己。关键动作是把机器人创建的 Issue 转换为 Discussion。新内容继承原 Issue 作者，于是通知头里的 <code>X-GitHub-Sender</code> 变成机器人账号。</p><pre>Issue(author: bot)
+ edit(body: "Hello @lilacctf-tech")
+ convert_to_discussion()
= Notification(sender: bot)</pre></article></section>
    <section class="section privacy"><div class="lock">404</div><div><h2>私有仓库会吞掉整条路径</h2><p>GitHub 不会向私有仓库的非协作者发送 Mention 通知。把仓库改为 Public 后，需要重新生成 Issue、编辑 Mention、再转为 Discussion。</p></div></section>
    <section class="section final"><h2>Feature + Privacy<br/>= Flag</h2><p>这道题考察的是业务逻辑组合：Issue 转 Discussion 保留作者身份，私有仓库阻止外部通知。理解两个正常机制的边界，就能构造通过身份检查的邮件。</p><div class="flag">lilacctf&#123;1ssue_t0_d1scuss10n_sp00fs_s3nder_1d&#125;</div></section>
  </main>
  <OriginalArticle blog={blog} />
  <script>
    const nodes = [...document.querySelectorAll('.node')];
    const routes = [...document.querySelectorAll('.route')];
    const inspectTitle = document.querySelector('#inspectTitle');
    const inspectDetail = document.querySelector('#inspectDetail');
    const inspectEvidence = document.querySelector('#inspectEvidence');
    const counter = document.querySelector('#counter');
    const status = document.querySelector('#status');
    function activate(index) {
      nodes.forEach((node, position) => { node.classList.toggle('active', position === index); node.classList.toggle('done', position <= index); });
      routes.forEach((route, position) => route.classList.toggle('active', position < index));
      const node = nodes[index];
      inspectTitle.textContent = node.dataset.title;
      inspectDetail.textContent = node.dataset.detail;
      inspectEvidence.textContent = node.dataset.evidence;
      counter.textContent = `${index + 1} / ${nodes.length}`;
      status.textContent = index === nodes.length - 1 ? 'VERIFIED' : 'TRACING';
    }
    nodes.forEach((node, index) => node.addEventListener('click', () => activate(index)));
    document.querySelector('#run')?.addEventListener('click', () => {
      let index = 0; activate(index);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const timer = setInterval(() => { index += 1; if (index >= nodes.length) return clearInterval(timer); activate(index); }, 650);
    });
  </script>
</body>
</html>

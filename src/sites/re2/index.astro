---
import OriginalArticle from "../../components/article/OriginalArticle.astro";

interface Props {
  blog: any;
}

const { blog } = Astro.props;
const title = blog.data.title;
const description = blog.data.description;
const pubDate = blog.data.pubDate;
const categories = blog.data.categories;
const tags = blog.data.tags;

import img1 from "../../content/blog/image/re2/1745324409179.png";
import img2 from "../../content/blog/image/re2/1745324460523.png";
import img3 from "../../content/blog/image/re2/1745324813328.png";
import img4 from "../../content/blog/image/re2/1745324819137.png";
import img5 from "../../content/blog/image/re2/1745325260154.png";
import img6 from "../../content/blog/image/re2/1745325788780.png";
import img7 from "../../content/blog/image/re2/1745326592615.png";
import img8 from "../../content/blog/image/re2/1745327408375.png";

const extractCode = `<span class="kw">res</span> = []
<span class="kw">with</span> <span class="fn">open</span>(<span class="str">"t.log"</span>, <span class="str">"r"</span>) <span class="kw">as</span> f:
    s = f.read()
    count = <span class="num">0</span>
    rcount = <span class="num">0</span>
    tmp = <span class="str">""</span>
    <span class="kw">for</span> line <span class="kw">in</span> s.split(<span class="str">"\\n"</span>):
        line = line.split(<span class="str">"db "</span>)
        line = line[<span class="num">1</span>][<span class="num">1</span>:<span class="num">4</span>].replace(<span class="str">"h"</span>, <span class="str">""</span>).replace(<span class="str">" "</span>, <span class="str">""</span>)
        count += <span class="num">1</span>
        tmp = line + tmp
        <span class="kw">if</span> count % <span class="num">4</span> == <span class="num">0</span>:
            rcount += <span class="num">1</span>
            res.append(tmp)
            tmp = <span class="str">""</span>
        <span class="kw">if</span> rcount == <span class="num">40</span>:
            <span class="kw">break</span>

<span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(<span class="num">40</span>):
    <span class="fn">print</span>(<span class="str">f"v{i} = 0x{res[i]}"</span>)`;

const solveCode = `<span class="kw">import</span> logging

<span class="comment"># Reverse all operations: swap += and -=</span>
ans0 = <span class="num">0xFFFFFF9A</span>
ans1 = <span class="num">0x0006D</span>
ans2 = <span class="num">0x0007E</span>
<span class="comment">... </span><span class="dim"># 40 values total</span>
ans38 = <span class="num">0xFFFFFFED</span>
ans39 = <span class="num">0x00035</span>

<span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(<span class="num">2</span>, <span class="num">42</span>):
    <span class="fn">exec</span>(<span class="str">f"v{i} = ans{i-2}"</span>)

<span class="kw">with</span> <span class="fn">open</span>(<span class="str">"ori"</span>, <span class="str">"r"</span>) <span class="kw">as</span> f:
    s = f.read()
    lines = s.split(<span class="str">"\\n"</span>)
    lines.<span class="fn">reverse</span>()
    <span class="kw">for</span> line <span class="kw">in</span> lines:
        <span class="kw">if</span> <span class="str">"+="</span> <span class="kw">in</span> line:
            line = line.replace(<span class="str">"+="</span>, <span class="str">"-="</span>)
        <span class="kw">elif</span> <span class="str">"-="</span> <span class="kw">in</span> line:
            line = line.replace(<span class="str">"-="</span>, <span class="str">"+="</span>)
        <span class="kw">elif</span> <span class="str">"++"</span> <span class="kw">in</span> line:
            line = line.split(<span class="str">"++"</span>)
            line = line[<span class="num">1</span>] + <span class="str">"-=1"</span>
        <span class="kw">elif</span> <span class="str">"--"</span> <span class="kw">in</span> line:
            line = line.split(<span class="str">"--"</span>)
            line = line[<span class="num">1</span>] + <span class="str">"+=1"</span>
        <span class="fn">exec</span>(line)

<span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(<span class="num">2</span>, <span class="num">42</span>):
    <span class="fn">exec</span>(<span class="str">f"print(chr(v{i}%256),end='')"</span>)`;

const teaDecompiled = `<span class="type">unsigned int</span> __cdecl <span class="fn">tea</span>(<span class="type">_DWORD</span> *ori, <span class="type">int</span> a2, <span class="type">int</span> key)
{
  <span class="type">int</span> index = <span class="num">52</span> / a2 + <span class="num">6</span>;  <span class="comment">// = 12</span>
  <span class="type">unsigned int</span> v9 = <span class="num">0</span>;
  <span class="type">unsigned int</span> v10 = ori[a2 - <span class="num">1</span>];
  <span class="kw">do</span>
  {
    v9 -= <span class="num">1640531527</span>;  <span class="comment">// 0x61C88647</span>
    v6 = (v9 >> <span class="num">2</span>) & <span class="num">3</span>;
    <span class="kw">for</span> ( i = <span class="num">0</span>; i < a2 - <span class="num">1</span>; ++i )
    {
      ori[i] += ((ori[i+<span class="num">1</span>] ^ v9) + (v10 ^ key[v6 ^ i & <span class="num">3</span>]))
              ^ (((<span class="num">4</span> * ori[i+<span class="num">1</span>]) ^ (v10 >> <span class="num">5</span>))
              + ((ori[i+<span class="num">1</span>] >> <span class="num">3</span>) ^ (<span class="num">16</span> * v10)));
      v10 = ori[i];
    }
    ori[a2-<span class="num">1</span>] += ((*ori ^ v9) + (v10 ^ key[v6 ^ i & <span class="num">3</span>]))
              ^ (((<span class="num">4</span> * *ori) ^ (v10 >> <span class="num">5</span>))
              + ((*ori >> <span class="num">3</span>) ^ (<span class="num">16</span> * v10)));
    v10 = ori[a2-<span class="num">1</span>];
    --index;
  }
  <span class="kw">while</span> ( index );
}`;

const teaSimplified = `<span class="comment">// Simplified XXTEA variant</span>
index = <span class="num">12</span>;
sum = <span class="num">0</span>;
o7 = ori[<span class="num">7</span>];
<span class="kw">do</span>
{
    sum -= <span class="num">0x61C88647</span>;
    sum2 = (sum >> <span class="num">2</span>) & <span class="num">3</span>;
    <span class="kw">for</span> (i=<span class="num">0</span>; i < <span class="num">7</span>; ++i)
    {
        ori[i] += ((ori[(i+<span class="num">1</span>) % <span class="num">8</span>] ^ sum)
                + (ori[(i-<span class="num">1</span>) % <span class="num">8</span>] ^ key[sum2 ^ i & <span class="num">3</span>]))
                ^ (((<span class="num">4</span> * ori[(i+<span class="num">1</span>) % <span class="num">8</span>]) ^ (ori[(i-<span class="num">1</span>) % <span class="num">8</span>] >> <span class="num">5</span>))
                + ((ori[(i+<span class="num">1</span>) % <span class="num">8</span>] >> <span class="num">3</span>) ^ (<span class="num">16</span> * ori[(i-<span class="num">1</span>) % <span class="num">8</span>])));
    }
    --index;
}
<span class="kw">while</span> (index);`;

const teaDecrypt = `<span class="kw">for</span> ch <span class="kw">in</span> guess:
    key_str = <span class="str">"sssctf{"</span> + ch  <span class="comment"># 8 char key</span>
    key = [<span class="num">0</span>]*<span class="num">4</span>
    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(<span class="num">0</span>, <span class="num">4</span>):
        key[i] = <span class="fn">ord</span>(key_str[i*<span class="num">2</span>+<span class="num">1</span>]) | (<span class="fn">ord</span>(key_str[i*<span class="num">2</span>]) << <span class="num">8</span>)

    <span class="comment"># TEA decrypt: reverse loop, swap += to -=</span>
    ori = encrypt_data.copy()
    index = <span class="num">12</span>
    sum = (<span class="num">0x61C88647</span> * -index) & <span class="num">0xFFFFFFFF</span>
    <span class="kw">while</span> index > <span class="num">0</span>:
        sum2 = (sum >> <span class="num">2</span>) & <span class="num">3</span>
        <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(<span class="num">7</span>, -<span class="num">1</span>, -<span class="num">1</span>):
            ori[i] -= ((ori[(i+<span class="num">1</span>) % <span class="num">8</span>] ^ sum)
                    + (ori[(i-<span class="num">1</span>) % <span class="num">8</span>] ^ key[sum2 ^ (i & <span class="num">3</span>)]))
                    ^ (((<span class="num">4</span> * ori[(i+<span class="num">1</span>) % <span class="num">8</span>])
                    ^ (ori[(i-<span class="num">1</span>) % <span class="num">8</span>] >> <span class="num">5</span>))
                    + ((ori[(i+<span class="num">1</span>) % <span class="num">8</span>] >> <span class="num">3</span>)
                    ^ (<span class="num">16</span> * ori[(i-<span class="num">1</span>) % <span class="num">8</span>])))
            ori[i] &= <span class="num">0xFFFFFFFF</span>
        sum += <span class="num">0x61C88647</span>
        sum &= <span class="num">0xFFFFFFFF</span>
        index -= <span class="num">1</span>

    <span class="comment"># Reconstruct plaintext</span>
    decrypted_text = <span class="str">""</span>
    <span class="kw">for</span> value <span class="kw">in</span> ori:
        decrypted_text += <span class="fn">chr</span>((value >> <span class="num">24</span>) & <span class="num">0xFF</span>)
        decrypted_text += <span class="fn">chr</span>((value >> <span class="num">16</span>) & <span class="num">0xFF</span>)
        decrypted_text += <span class="fn">chr</span>((value >> <span class="num">8</span>) & <span class="num">0xFF</span>)
        decrypted_text += <span class="fn">chr</span>(value & <span class="num">0xFF</span>)

    <span class="kw">if</span> decrypted_text.startswith(<span class="str">"sssctf{"</span>):
        <span class="fn">print</span>(<span class="str">f"Key: {key_str} -> {decrypted_text}"</span>)
        <span class="kw">break</span>`;

const merge4Code = `<span class="type">int</span> *__cdecl <span class="fn">merge4</span>(<span class="type">int</span> a1, <span class="type">int</span> a2)
{
  <span class="type">int</span> *result;
  <span class="kw">for</span> ( i = <span class="num">0</span>; i <= <span class="num">7</span>; ++i )
  {
    result = (<span class="type">int</span> *)(<span class="num">4</span> * i + a2);
    <span class="comment">// char[32] -> int[8]</span>
    <span class="comment">// Pack 4 bytes into one DWORD (big-endian)</span>
    *result = *(<span class="type">char</span> *)(<span class="num">4</span>*i + <span class="num">3</span> + a1)
            | ((((*(<span class="type">char</span> *)(<span class="num">4</span>*i + a1) << <span class="num">8</span>)
            | *(<span class="type">char</span> *)(<span class="num">4</span>*i + <span class="num">1</span> + a1)) << <span class="num">8</span>)
            | *(<span class="type">char</span> *)(<span class="num">4</span>*i + <span class="num">2</span> + a1)) << <span class="num">8</span>);
  }
  <span class="kw">return</span> result;
}`;
---

<!doctype html>
{false && (
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="LangQi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --c-bg: #1a1a2e;
      --c-surface: #16213e;
      --c-surface-raised: #1c2a4a;
      --c-panel: #0f1629;
      --c-border: #2a3a5c;
      --c-border-accent: rgba(249, 115, 22, 0.25);
      --c-text: #c8cdd3;
      --c-text-muted: #6b7a8d;
      --c-text-dim: #3e4f66;
      --c-accent: #F97316;
      --c-accent-dim: #c2590f;
      --c-accent-glow: rgba(249, 115, 22, 0.08);
      --c-accent-border: rgba(249, 115, 22, 0.35);
      --c-success: #4ade80;
      --c-warn: #fbbf24;
      --c-info: #60a5fa;
      --c-danger: #f87171;
      --font-mono: 'Fira Code', monospace;
      --font-sans: 'Noto Sans SC', system-ui, sans-serif;
      --radius: 2px;
      --space-xs: 0.25rem;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2.5rem;
      --space-2xl: 4rem;
      --space-3xl: 6rem;
    }

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      background: var(--c-bg);
      color: var(--c-text);
      line-height: 1.75;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }
      .section {
        opacity: 1 !important;
        transform: none !important;
      }
      .toolbar-indicator {
        animation: none !important;
      }
    }

    .back-link {
      position: fixed;
      top: var(--space-lg);
      left: var(--space-lg);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--c-text-muted);
      text-decoration: none;
      letter-spacing: 0.03em;
      z-index: 100;
      transition: color 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      background: var(--c-panel);
    }

    .back-link:hover {
      color: var(--c-accent);
      border-color: var(--c-accent-border);
    }

    .back-link::before {
      content: '\2190';
      font-size: 0.85rem;
    }

    .container {
      max-width: 54rem;
      margin: 0 auto;
      padding: var(--space-3xl) var(--space-lg);
    }

    /* ===== HERO / HEADER ===== */
    .hero {
      padding: var(--space-3xl) 0 var(--space-2xl);
      margin-bottom: var(--space-2xl);
      position: relative;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-sm) var(--space-md);
      background: var(--c-panel);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      margin-bottom: var(--space-xl);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--c-text-dim);
      overflow-x: auto;
    }

    .toolbar-item {
      display: flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }

    .toolbar-sep {
      width: 1px;
      height: 14px;
      background: var(--c-border);
      flex-shrink: 0;
    }

    .toolbar-indicator {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--c-success);
      animation: pulse-indicator 2.5s ease-in-out infinite;
    }

    @keyframes pulse-indicator {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .hero-title {
      font-family: var(--font-mono);
      font-size: clamp(1.4rem, 3.5vw, 2.1rem);
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
      margin-bottom: var(--space-md);
      letter-spacing: -0.02em;
    }

    .hero-title .accent {
      color: var(--c-accent);
    }

    .hero-subtitle {
      font-size: 0.92rem;
      color: var(--c-text-muted);
      margin-bottom: var(--space-lg);
      max-width: 40rem;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-md) var(--space-xl);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--c-text-muted);
      padding-top: var(--space-md);
      border-top: 1px solid var(--c-border);
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .meta-label {
      color: var(--c-text-dim);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
      margin-top: var(--space-lg);
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      padding: 2px 8px;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      color: var(--c-text-muted);
      letter-spacing: 0.04em;
    }

    .tag--active {
      border-color: var(--c-accent-border);
      color: var(--c-accent);
      background: var(--c-accent-glow);
    }

    /* ===== CHAPTER SEPARATOR ===== */
    .chapter-divider {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin: var(--space-3xl) 0 var(--space-2xl);
      padding: var(--space-lg) 0;
    }

    .chapter-divider::before,
    .chapter-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--c-border), transparent);
    }

    .chapter-badge {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--c-accent);
      padding: 4px 14px;
      border: 1px solid var(--c-accent-border);
      border-radius: var(--radius);
      background: var(--c-accent-glow);
      white-space: nowrap;
    }

    /* ===== SECTIONS ===== */
    .section {
      margin-bottom: var(--space-2xl);
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--c-border);
    }

    .section-number {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--c-accent);
      letter-spacing: 0.08em;
      padding: 2px 8px;
      border: 1px solid var(--c-accent-border);
      border-radius: var(--radius);
      background: var(--c-accent-glow);
    }

    .section-title {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
    }

    /* ===== PROSE ===== */
    .prose {
      font-size: 0.92rem;
      line-height: 1.8;
      color: var(--c-text);
    }

    .prose p {
      margin-bottom: var(--space-md);
    }

    .prose strong {
      color: #fff;
      font-weight: 600;
    }

    .prose a {
      color: var(--c-accent);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: var(--c-accent-dim);
      transition: text-decoration-color 0.2s;
    }

    .prose a:hover {
      text-decoration-color: var(--c-accent);
    }

    .inline-code {
      font-family: var(--font-mono);
      font-size: 0.82em;
      background: var(--c-surface-raised);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 1px 6px;
      color: var(--c-accent);
    }

    .prose ul, .prose ol {
      padding-left: 1.5rem;
      margin-bottom: var(--space-md);
    }

    .prose li {
      margin-bottom: var(--space-xs);
    }

    .prose li::marker {
      color: var(--c-accent);
    }

    /* ===== CODE BLOCKS ===== */
    .code-block {
      background: var(--c-panel);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      margin: var(--space-lg) 0;
      position: relative;
      overflow: hidden;
    }

    .code-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px var(--space-md);
      border-bottom: 1px solid var(--c-border);
      background: var(--c-surface);
    }

    .code-lang {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: var(--c-text-dim);
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .code-file {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: var(--c-text-muted);
    }

    .code-body {
      padding: var(--space-md) var(--space-lg);
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 1.85;
      color: var(--c-text);
      white-space: pre;
      tab-size: 4;
    }

    .code-body .kw { color: #c792ea; font-weight: 500; }
    .code-body .fn { color: #82aaff; }
    .code-body .str { color: #c3e88d; }
    .code-body .num { color: #F97316; }
    .code-body .type { color: #ffcb6b; }
    .code-body .comment { color: #546e7a; font-style: italic; }
    .code-body .dim { color: #546e7a; }
    .code-body .hl { color: var(--c-accent); font-weight: 600; }

    /* ===== CALLOUTS ===== */
    .callout {
      border-left: 3px solid var(--c-accent);
      background: var(--c-accent-glow);
      padding: var(--space-md) var(--space-lg);
      margin: var(--space-lg) 0;
      border-radius: 0 var(--radius) var(--radius) 0;
      font-size: 0.88rem;
    }

    .callout--warn {
      border-left-color: var(--c-warn);
      background: rgba(251, 191, 36, 0.06);
    }

    .callout--info {
      border-left-color: var(--c-info);
      background: rgba(96, 165, 250, 0.06);
    }

    .callout-label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--c-accent);
      margin-bottom: 4px;
    }

    .callout--warn .callout-label { color: var(--c-warn); }
    .callout--info .callout-label { color: var(--c-info); }

    /* ===== IMAGES ===== */
    .img-container {
      margin: var(--space-lg) 0;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--c-panel);
    }

    .img-container img {
      width: 100%;
      height: auto;
      display: block;
    }

    .img-caption {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--c-text-dim);
      padding: 6px var(--space-md);
      border-top: 1px solid var(--c-border);
      background: var(--c-surface);
    }

    /* ===== KEY INSIGHT BOX ===== */
    .insight-box {
      border: 1px solid var(--c-accent-border);
      border-radius: var(--radius);
      padding: var(--space-lg);
      margin: var(--space-lg) 0;
      background: var(--c-accent-glow);
      position: relative;
    }

    .insight-box::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 3px;
      height: 100%;
      background: var(--c-accent);
      border-radius: var(--radius) 0 0 var(--radius);
    }

    .insight-label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: var(--space-sm);
    }

    .insight-box ul {
      padding-left: 1.2rem;
      font-size: 0.88rem;
    }

    .insight-box li {
      margin-bottom: 4px;
    }

    .insight-box li::marker {
      color: var(--c-accent);
    }

    /* ===== SUMMARY ===== */
    .summary-box {
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: var(--space-lg);
      margin: var(--space-2xl) 0;
      background: var(--c-surface);
    }

    .summary-title {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
      margin-bottom: var(--space-md);
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }

    .summary-title::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--c-accent);
      border-radius: 1px;
    }

    .summary-box ul {
      list-style: none;
      padding: 0;
    }

    .summary-box li {
      font-size: 0.88rem;
      padding: 6px 0;
      border-bottom: 1px solid var(--c-border);
      padding-left: var(--space-md);
      position: relative;
    }

    .summary-box li:last-child {
      border-bottom: none;
    }

    .summary-box li::before {
      content: '\25B8';
      position: absolute;
      left: 0;
      color: var(--c-accent);
      font-size: 0.7rem;
      top: 8px;
    }

    /* ===== FOOTER ===== */
    .footer {
      margin-top: var(--space-3xl);
      padding-top: var(--space-xl);
      border-top: 1px solid var(--c-border);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--c-text-dim);
      text-align: center;
      letter-spacing: 0.04em;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      .container {
        padding: var(--space-2xl) var(--space-md);
      }

      .hero {
        padding: var(--space-2xl) 0 var(--space-lg);
      }

      .back-link {
        position: relative;
        top: 0;
        left: 0;
        margin-bottom: var(--space-lg);
        display: inline-flex;
      }

      .hero-meta {
        flex-direction: column;
        gap: var(--space-sm);
      }

      .code-body {
        font-size: 0.7rem;
        padding: var(--space-sm) var(--space-md);
      }

      .toolbar {
        font-size: 0.6rem;
      }

      .chapter-divider {
        margin: var(--space-2xl) 0 var(--space-xl);
      }
    }
  </style>
</head>
<body>

  <a href="/blog" class="back-link">Back</a>

  <div class="container">
    <header class="hero section">
      <div class="toolbar">
        <div class="toolbar-indicator"></div>
        <span class="toolbar-item">IDA Pro 8.3</span>
        <span class="toolbar-sep"></span>
        <span class="toolbar-item">File: challenge.exe</span>
        <span class="toolbar-sep"></span>
        <span class="toolbar-item">Arch: x86</span>
        <span class="toolbar-sep"></span>
        <span class="toolbar-item">Analysis: Complete</span>
      </div>
      <h1 class="hero-title">
        <span class="accent">//</span> {title}
      </h1>
      <p class="hero-subtitle">{description}</p>
      <div class="hero-meta">
        <div class="meta-item">
          <span class="meta-label">Date</span>
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
          </time>
        </div>
        <div class="meta-item">
          <span class="meta-label">Category</span>
          {categories.join(' / ')}
        </div>
        <div class="meta-item">
          <span class="meta-label">Encryption</span>
          <span style="color: var(--c-accent);">TEA / XXTEA</span>
        </div>
      </div>
      <div class="tags">
        {tags.map((tag: string) => (
          <span class={`tag ${['CTF', 'Reverse', 'TEA'].includes(tag) ? 'tag--active' : ''}`}>{tag}</span>
        ))}
      </div>
    </header>

    <!-- ===== CHAPTER 1: ezMath ===== -->
    <div class="chapter-divider">
      <span class="chapter-badge">Challenge 01 // ezMath</span>
    </div>

    <section class="section">
      <div class="section-header">
        <span class="section-number">01</span>
        <h2 class="section-title">Initial Recon</h2>
      </div>
      <div class="prose">
        <p>
          Open the binary in IDA, <span class="inline-code">Shift+F12</span> to find the flag validation entry point.
        </p>
      </div>
      <div class="img-container">
        <img src={img1.src} alt="IDA Pro string search showing flag validation entry" loading="lazy" />
        <div class="img-caption">Shift+F12 string reference scan</div>
      </div>
      <div class="prose">
        <p>
          Following the cross-reference leads to the main comparison logic. However:
        </p>
      </div>
      <div class="img-container">
        <img src={img2.src} alt="IDA Pro node too big to display warning" loading="lazy" />
        <div class="img-caption">Graph view: node too large</div>
      </div>
      <div class="callout callout--warn">
        <div class="callout-label">Warning</div>
        <p>Sorry, this node is too big to display</p>
      </div>
      <div class="prose">
        <p>
          The function graph is too large for IDA's default settings. Fix: edit
          <span class="inline-code">IDA/cfg/hexrays.cfg</span>, change
          <span class="inline-code">MAX_FUNCSIZE</span> from 64 to 1024.
        </p>
        <p>
          After the fix, the decompiled output reveals a massive sequence of arithmetic operations
          (additions and subtractions on 40 variables) followed by a comparison against hardcoded values.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <span class="section-number">02</span>
        <h2 class="section-title">Data Extraction</h2>
      </div>
      <div class="prose">
        <p>
          The comparison targets are stored in the data segment. Initially extracted them
          manually from IDA's hex view, parsing <span class="inline-code">db</span> directives:
        </p>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-lang">Python</span>
          <span class="code-file">extract_values.py</span>
        </div>
        <pre class="code-body"><code set:html={extractCode}></code></pre>
      </div>
      <div class="callout callout--info">
        <div class="callout-label">Tip</div>
        <p>
          Actually, <span class="inline-code">Shift+E</span> can extract data directly in IDA.
          You just need to <strong>select the data range first</strong> before pressing the shortcut.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <span class="section-number">03</span>
        <h2 class="section-title">Solve: Reverse Execution</h2>
      </div>
      <div class="prose">
        <p>
          The encryption is a sequence of ~5000 lines of <span class="inline-code">+=</span> and
          <span class="inline-code">-=</span> operations. To decrypt, we simply:
        </p>
        <ol>
          <li>Run the operations in <strong>reverse order</strong></li>
          <li>Swap <span class="inline-code">+=</span> with <span class="inline-code">-=</span> and vice versa</li>
          <li>Handle edge cases: <span class="inline-code">++v</span> becomes <span class="inline-code">v-=1</span></li>
        </ol>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-lang">Python</span>
          <span class="code-file">solve_ezmath.py</span>
        </div>
        <pre class="code-body"><code set:html={solveCode}></code></pre>
      </div>
      <div class="insight-box">
        <div class="insight-label">Pitfalls</div>
        <ul>
          <li>There are ~10 instances of <span class="inline-code">++v</span> / <span class="inline-code">--v</span> (prefix form) hidden among 5000 lines</li>
          <li>Do NOT chain: <span class="inline-code">line.replace("+=", "-=").replace("-=", "+=")</span> as the second replace undoes the first</li>
        </ul>
      </div>
    </section>

    <!-- ===== CHAPTER 2: TEA ===== -->
    <div class="chapter-divider">
      <span class="chapter-badge">Challenge 02 // ezTea</span>
    </div>

    <section class="section">
      <div class="section-header">
        <span class="section-number">04</span>
        <h2 class="section-title">Program Structure</h2>
      </div>
      <div class="prose">
        <p>
          Same approach: <span class="inline-code">Shift+F12</span> to find the entry. The program:
        </p>
        <ol>
          <li>Reads 32-byte input (enforced length check)</li>
          <li><span class="inline-code">merge4</span>: packs <span class="inline-code">char[32]</span> into <span class="inline-code">int[8]</span> (big-endian)</li>
          <li><span class="inline-code">merge2</span>: extracts key from input's first 8 bytes into <span class="inline-code">int[4]</span></li>
          <li><span class="inline-code">tea()</span>: encrypts the int[8] data using the key</li>
          <li>Compares result against hardcoded ciphertext</li>
        </ol>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-lang">C / IDA Decompile</span>
          <span class="code-file">merge4()</span>
        </div>
        <pre class="code-body"><code set:html={merge4Code}></code></pre>
      </div>
      <div class="insight-box">
        <div class="insight-label">Key Observation</div>
        <ul>
          <li>Plaintext: our 32-byte input</li>
          <li>Key: first 8 bytes of plaintext (only 8 bytes used despite char[16] buffer)</li>
          <li>Cipher: TEA encryption</li>
          <li>Ciphertext: hardcoded comparison values</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <span class="section-number">05</span>
        <h2 class="section-title">TEA Analysis</h2>
      </div>
      <div class="prose">
        <p>
          The tea function is an XXTEA variant with heavy obfuscation.
          Decompiled output (cleaned up):
        </p>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-lang">C / Decompiled</span>
          <span class="code-file">tea() - Original</span>
        </div>
        <pre class="code-body"><code set:html={teaDecompiled}></code></pre>
      </div>
      <div class="prose">
        <p>
          After significant simplification (recognizing the XXTEA block cipher pattern):
        </p>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-lang">C / Simplified</span>
          <span class="code-file">tea() - Cleaned</span>
        </div>
        <pre class="code-body"><code set:html={teaSimplified}></code></pre>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <span class="section-number">06</span>
        <h2 class="section-title">Decryption + Key Brute-force</h2>
      </div>
      <div class="prose">
        <p>
          Since the flag format is <span class="inline-code">sssctf&#123;...&#125;</span>, the key's
          first 7 bytes are known: <span class="inline-code">sssctf&#123;</span>. We only need to
          brute-force <strong>one byte</strong>.
        </p>
        <p>
          Decryption follows the same principle: reverse loop direction, swap
          <span class="inline-code">+=</span> to <span class="inline-code">-=</span>,
          and handle unsigned 32-bit overflow with <span class="inline-code">& 0xFFFFFFFF</span>.
        </p>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-lang">Python</span>
          <span class="code-file">solve_tea.py</span>
        </div>
        <pre class="code-body"><code set:html={teaDecrypt}></code></pre>
      </div>
    </section>

    <!-- ===== CONCLUSION ===== -->
    <div class="chapter-divider">
      <span class="chapter-badge">Conclusion</span>
    </div>

    <section class="section">
      <div class="summary-box">
        <div class="summary-title">Takeaways</div>
        <ul>
          <li>Both challenges share the same core technique: <strong>run the code in reverse, invert the operators</strong></li>
          <li>Writing equivalent simplified code is essential for understanding obfuscated crypto</li>
          <li>Pay attention to <strong>data types</strong> during analysis. The int[4] key only uses 8 bytes of input. Knowing the flag format means only 1 byte needs brute-forcing instead of 9</li>
        </ul>
      </div>
    </section>

    <footer class="footer">
      <p>LangQi // Reverse Engineering Writeup</p>
      <p style="margin-top: var(--space-sm); color: var(--c-accent);">// EOF</p>
    </footer>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        document.querySelectorAll('.section').forEach(el => el.classList.add('visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
      );

      document.querySelectorAll('.section').forEach((section) => {
        observer.observe(section);
      });
    });
  </script>
</body>
</html>
)}

<html lang="zh-CN" class="lab-page">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="LangQi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="article:published_time" content={pubDate.toISOString()} />
  <meta property="article:section" content={categories[0]} />
  {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <style is:inline>
    :root {
      --paper: #ecece7;
      --ink: #141414;
      --muted: #66665f;
      --rule: #b8b8af;
      --accent: #ed3e24;
      --panel: #f8f8f3;
      --black: #090909;
      --mono: "SFMono-Regular", "Cascadia Code", "Liberation Mono", monospace;
      --sans: "Arial Narrow", "Aptos Narrow", "Noto Sans SC", Arial, sans-serif;
    }

    html, html * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--paper); color: var(--ink); }
    body { margin: 0; min-width: 320px; overflow-x: hidden; background: var(--paper); font-family: var(--sans); }
    button, input { font: inherit; }
    a { color: inherit; }

    .lab-top {
      height: 54px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 1px solid var(--ink);
      padding: 0 24px;
      font: 700 11px/1 var(--mono);
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .lab-top a { text-decoration: none; }
    .lab-top a:hover { color: var(--accent); }
    .lab-top .status { display: flex; align-items: center; gap: 8px; justify-self: end; }
    .lab-top .status::before { content: ""; width: 7px; height: 7px; background: var(--accent); border-radius: 50%; }

    .instrument {
      min-height: calc(100dvh - 54px);
      display: grid;
      grid-template-columns: minmax(280px, .72fr) minmax(620px, 1.28fr);
      border-bottom: 1px solid var(--ink);
    }
    .instrument-copy {
      padding: clamp(28px, 5vw, 76px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: 1px solid var(--ink);
      position: relative;
    }
    .instrument-copy::after {
      content: "RE / 02";
      position: absolute;
      right: -1px;
      bottom: 0;
      background: var(--ink);
      color: var(--paper);
      padding: 7px 10px;
      font: 700 10px/1 var(--mono);
    }
    .kicker { margin: 0 0 18px; font: 700 11px/1.2 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
    .instrument h1 { margin: 0; max-width: 8ch; font: 900 clamp(48px, 7vw, 108px)/.82 var(--sans); letter-spacing: -.07em; text-transform: uppercase; }
    .instrument h1 span { display: block; color: transparent; -webkit-text-stroke: 1.5px var(--ink); }
    .lead { max-width: 32rem; margin: 30px 0 0; font-size: clamp(17px, 1.5vw, 22px); line-height: 1.42; font-weight: 600; }
    .hero-foot { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 36px; padding-top: 16px; border-top: 1px solid var(--ink); }
    .hero-foot div { font: 11px/1.45 var(--mono); }
    .hero-foot b { display: block; font-size: 18px; color: var(--accent); }

    .machine {
      min-width: 0;
      background: var(--black);
      color: #f2f2e9;
      display: grid;
      grid-template-rows: auto minmax(440px, 1fr) auto;
    }
    .machine-head {
      min-height: 58px;
      display: flex;
      align-items: stretch;
      border-bottom: 1px solid #41413d;
      font: 11px/1 var(--mono);
    }
    .mode-switch { display: flex; }
    .mode-switch button, .machine-action {
      min-width: 112px;
      border: 0;
      border-right: 1px solid #41413d;
      background: transparent;
      color: #8c8c85;
      padding: 0 18px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: .08em;
    }
    .mode-switch button[aria-pressed="true"] { background: var(--accent); color: #fff; }
    .mode-switch button:active, .machine-action:active, .transport button:active { transform: translateY(1px); }
    .machine-action { margin-left: auto; border-left: 1px solid #41413d; border-right: 0; color: #f2f2e9; }
    .machine-action:hover { color: var(--accent); }

    .ring-stage { position: relative; min-height: 0; overflow: hidden; }
    .ring-svg { position: absolute; inset: 5% 6%; width: 88%; height: 90%; }
    .orbit, .link { fill: none; }
    .orbit { stroke: #292925; stroke-width: 1; stroke-dasharray: 3 7; }
    .link { stroke: #4c4c46; stroke-width: 1.4; transition: stroke .15s, stroke-width .15s, opacity .15s; }
    .link.hot { stroke: var(--accent); }
    .link.keyed { stroke: #f0f0e8; stroke-dasharray: 4 5; }
    .word-node {
      position: absolute;
      left: calc(50% + var(--x) * 1%);
      top: calc(50% + var(--y) * 1%);
      width: clamp(90px, 10vw, 136px);
      transform: translate(-50%, -50%);
      border: 1px solid #5b5b54;
      background: #0d0d0c;
      padding: 9px 10px;
      color: #f0f0e8;
      transition: border-color .15s, background .15s, transform .15s;
      text-align: left;
    }
    .word-node.active { border-color: var(--accent); background: #24100c; transform: translate(-50%, -50%) scale(1.04); }
    .word-node small { display: flex; justify-content: space-between; color: #777770; font: 9px/1 var(--mono); text-transform: uppercase; }
    .word-node output { display: block; margin-top: 6px; font: 700 clamp(10px, 1vw, 14px)/1 var(--mono); }
    .word-node .ascii { margin-top: 5px; color: #a8a89e; font: 9px/1 var(--mono); white-space: nowrap; overflow: hidden; }
    .core-readout {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 170px;
      text-align: center;
      font-family: var(--mono);
    }
    .core-readout .round { font-size: clamp(54px, 7vw, 90px); line-height: .8; font-weight: 800; letter-spacing: -.09em; }
    .core-readout .round span { color: #53534d; font-size: .26em; letter-spacing: 0; }
    .core-readout dl { margin: 22px 0 0; display: grid; grid-template-columns: auto auto; gap: 8px 14px; text-align: left; font-size: 10px; }
    .core-readout dt { color: #777770; }
    .core-readout dd { margin: 0; color: #f0f0e8; text-align: right; }
    .core-readout dd.key { color: var(--accent); }

    .machine-console { border-top: 1px solid #41413d; padding: 16px 18px 18px; }
    .transport { display: grid; grid-template-columns: repeat(4, 42px) 1fr auto; gap: 8px; align-items: center; }
    .transport button {
      height: 38px;
      border: 1px solid #55554e;
      background: transparent;
      color: #f0f0e8;
      cursor: pointer;
      font: 700 13px/1 var(--mono);
    }
    .transport button:hover { border-color: var(--accent); color: var(--accent); }
    .timeline { width: 100%; accent-color: var(--accent); cursor: ew-resize; }
    .frame-label { min-width: 84px; text-align: right; color: #aaa9a0; font: 10px/1 var(--mono); }
    .round-track { display: grid; grid-template-columns: repeat(33, 1fr); gap: 2px; margin-top: 12px; }
    .round-track i { height: 3px; background: #34342f; }
    .round-track i.passed { background: var(--accent); }
    .machine-note { margin: 12px 0 0; color: #85857d; font: 10px/1.45 var(--mono); }

    .thesis {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      border-bottom: 1px solid var(--ink);
    }
    .thesis-main { padding: clamp(48px, 8vw, 120px); }
    .thesis h2 { margin: 0; max-width: 12ch; font: 900 clamp(44px, 7vw, 94px)/.9 var(--sans); letter-spacing: -.06em; }
    .thesis h2 em { color: var(--accent); font-style: normal; }
    .thesis-main p { max-width: 42rem; margin: 28px 0 0; font-size: 19px; line-height: 1.65; }
    .operator-tape { border-left: 1px solid var(--ink); display: grid; grid-template-rows: repeat(4, 1fr); }
    .operator-tape div { display: grid; place-items: center; min-height: 120px; border-bottom: 1px solid var(--ink); font: 900 clamp(34px, 5vw, 72px)/1 var(--mono); }
    .operator-tape div:last-child { border-bottom: 0; }
    .operator-tape .flip { background: var(--accent); color: #fff; }

    .case { border-bottom: 1px solid var(--ink); }
    .case-head { display: grid; grid-template-columns: 160px 1fr; border-bottom: 1px solid var(--ink); }
    .case-id { padding: 28px 24px; background: var(--ink); color: var(--paper); font: 700 13px/1.4 var(--mono); }
    .case-title { padding: 26px clamp(24px, 6vw, 88px); }
    .case-title h2 { margin: 0; font: 900 clamp(36px, 6vw, 78px)/.9 var(--sans); letter-spacing: -.05em; }
    .case-title p { margin: 12px 0 0; max-width: 58ch; font-size: 17px; line-height: 1.5; color: var(--muted); }
    .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .evidence-grid figure { margin: 0; min-width: 0; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: #1b1b19; }
    .evidence-grid figure:nth-child(even) { border-right: 0; }
    .evidence-grid img { width: 100%; height: clamp(260px, 34vw, 540px); display: block; object-fit: contain; }
    .evidence-grid figcaption { min-height: 44px; padding: 12px 16px; background: var(--paper); border-top: 1px solid var(--ink); font: 11px/1.4 var(--mono); }

    .procedure { display: grid; grid-template-columns: .78fr 1.22fr; }
    .procedure-copy { padding: clamp(36px, 6vw, 88px); border-right: 1px solid var(--ink); }
    .procedure-copy h3 { margin: 0 0 24px; font: 900 clamp(32px, 4vw, 58px)/.95 var(--sans); letter-spacing: -.04em; }
    .procedure-copy p, .procedure-copy li { font-size: 17px; line-height: 1.65; }
    .procedure-copy ol, .procedure-copy ul { padding-left: 1.2em; }
    .procedure-copy code, .inline { background: var(--ink); color: var(--paper); padding: 2px 5px; font: .82em/1.3 var(--mono); }
    .warning-strip { margin-top: 28px; border-top: 6px solid var(--accent); padding-top: 14px; font: 12px/1.55 var(--mono); }
    .warning-strip strong { color: var(--accent); }
    .code-unit { min-width: 0; background: var(--black); color: #d7d7cf; }
    .code-unit details { border-bottom: 1px solid #3c3c37; }
    .code-unit summary { cursor: pointer; padding: 18px 22px; color: #f2f2e9; font: 700 11px/1 var(--mono); list-style: none; display: flex; justify-content: space-between; }
    .code-unit summary::after { content: "+"; color: var(--accent); }
    .code-unit details[open] summary::after { content: "−"; }
    .code-unit pre { margin: 0; padding: 22px; overflow: auto; border-top: 1px solid #3c3c37; font: 11px/1.7 var(--mono); }
    .code-unit .kw { color: #ff755f; } .code-unit .fn { color: #8dc8ff; } .code-unit .str { color: #c4d97b; }
    .code-unit .num { color: #ff9e55; } .code-unit .type { color: #f1da87; } .code-unit .comment, .code-unit .dim { color: #74746d; }

    .memory-lane {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
      margin-top: 28px;
    }
    .memory-lane div { min-width: 0; padding: 15px 8px; border-right: 1px solid var(--ink); text-align: center; font: 10px/1.35 var(--mono); }
    .memory-lane div:last-child { border-right: 0; }
    .memory-lane b { display: block; margin-bottom: 7px; color: var(--accent); font-size: 13px; }

    .finding {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      min-height: 520px;
      border-bottom: 1px solid var(--ink);
    }
    .finding-copy { padding: clamp(42px, 7vw, 100px); background: var(--accent); color: #fff; }
    .finding-copy h2 { margin: 0; font: 900 clamp(42px, 7vw, 96px)/.85 var(--sans); letter-spacing: -.07em; }
    .finding-copy p { margin: 28px 0 0; max-width: 30rem; font-size: 20px; line-height: 1.5; }
    .key-math { display: flex; flex-direction: column; justify-content: center; padding: clamp(36px, 7vw, 100px); background: var(--black); color: #f1f1e9; }
    .key-line { font: 900 clamp(26px, 4.7vw, 68px)/1.15 var(--mono); word-break: break-all; }
    .key-line .known { color: var(--accent); }
    .key-line .unknown { display: inline-grid; place-items: center; width: 1.15em; border: 1px solid #77776f; color: #fff; }
    .key-math p { max-width: 58ch; color: #a5a59d; font: 12px/1.65 var(--mono); }

    .conclusion { padding: clamp(60px, 10vw, 150px) clamp(28px, 9vw, 140px); }
    .conclusion h2 { margin: 0; max-width: 13ch; font: 900 clamp(44px, 8vw, 112px)/.86 var(--sans); letter-spacing: -.07em; }
    .conclusion h2 span { color: var(--accent); }
    .takeaways { margin-top: 70px; border-top: 1px solid var(--ink); }
    .takeaways div { display: grid; grid-template-columns: 90px 1fr; gap: 30px; padding: 22px 0; border-bottom: 1px solid var(--ink); }
    .takeaways b { font: 700 13px/1 var(--mono); color: var(--accent); }
    .takeaways p { margin: 0; max-width: 55rem; font-size: 20px; line-height: 1.45; }
    .lab-footer { min-height: 86px; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; background: var(--ink); color: var(--paper); font: 11px/1.4 var(--mono); }
    .lab-footer a { color: var(--accent); text-decoration: none; }

    @media (max-width: 980px) {
      .instrument { grid-template-columns: 1fr; }
      .instrument-copy { min-height: 68dvh; border-right: 0; border-bottom: 1px solid var(--ink); }
      .machine { min-height: 720px; }
      .thesis, .procedure, .finding { grid-template-columns: 1fr; }
      .operator-tape { border-left: 0; border-top: 1px solid var(--ink); grid-template-columns: repeat(4, 1fr); grid-template-rows: 1fr; }
      .operator-tape div { min-height: 100px; border-bottom: 0; border-right: 1px solid var(--ink); }
      .procedure-copy { border-right: 0; border-bottom: 1px solid var(--ink); }
      .finding-copy { min-height: 430px; }
    }

    @media (max-width: 700px) {
      .lab-top { grid-template-columns: 1fr auto; padding: 0 14px; }
      .lab-top .center { display: none; }
      .instrument-copy { min-height: 580px; padding: 32px 20px; }
      .instrument h1 { font-size: clamp(52px, 18vw, 82px); }
      .hero-foot { gap: 7px; }
      .machine { min-height: 650px; grid-template-rows: auto 1fr auto; }
      .machine-head { min-height: 50px; }
      .mode-switch button { min-width: 92px; padding: 0 10px; }
      .machine-action { min-width: 72px; font-size: 0; }
      .machine-action::after { content: "RESET"; font-size: 10px; }
      .ring-stage { min-height: 455px; }
      .ring-svg { inset: 10% 1%; width: 98%; height: 80%; }
      .word-node { width: 86px; padding: 7px; }
      .word-node output { font-size: 9px; }
      .word-node .ascii { display: none; }
      .core-readout { width: 126px; }
      .core-readout dl { gap: 6px; font-size: 8px; margin-top: 15px; }
      .transport { grid-template-columns: repeat(4, 38px) 1fr; }
      .transport .frame-label { grid-column: 1 / -1; text-align: left; }
      .machine-note { display: none; }
      .case-head { grid-template-columns: 92px 1fr; }
      .case-id { padding: 22px 12px; font-size: 10px; }
      .case-title { padding: 22px 16px; }
      .evidence-grid { grid-template-columns: 1fr; }
      .evidence-grid figure, .evidence-grid figure:nth-child(even) { border-right: 0; }
      .evidence-grid img { height: auto; min-height: 220px; }
      .memory-lane { grid-template-columns: repeat(4, 1fr); }
      .memory-lane div:nth-child(4) { border-right: 0; }
      .memory-lane div:nth-child(-n+4) { border-bottom: 1px solid var(--ink); }
      .operator-tape { grid-template-columns: repeat(2, 1fr); }
      .operator-tape div:nth-child(-n+2) { border-bottom: 1px solid var(--ink); }
      .finding-copy { min-height: 360px; }
      .takeaways div { grid-template-columns: 48px 1fr; gap: 12px; }
      .takeaways p { font-size: 17px; }
      .lab-footer { align-items: flex-start; flex-direction: column; justify-content: center; gap: 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .lab-page { scroll-behavior: auto; }
      .word-node, .link { transition: none; }
    }
  </style>
</head>
<body>
  <nav class="lab-top" aria-label="页面导航">
    <a href="/blog">← LangQi / Blog</a>
    <span class="center">32-bit reversible systems laboratory</span>
    <span class="status">analysis live</span>
  </nav>

  <main>
    <section class="instrument" aria-labelledby="page-title">
      <div class="instrument-copy">
        <div>
          <p class="kicker">SSSCTF reverse engineering field note</p>
          <h1 id="page-title">逆着<span>运行</span></h1>
          <p class="lead">把混淆的算术与 TEA 还原成可观察、可暂停、可倒放的状态变化。</p>
        </div>
        <div class="hero-foot">
          <div><b>08</b>DWORD 节点</div>
          <div><b>32</b>可逆轮次</div>
          <div><b>01</b>未知密钥字节</div>
        </div>
      </div>

      <div class="machine" id="tea-machine">
        <div class="machine-head">
          <div class="mode-switch" role="group" aria-label="回放方向">
            <button type="button" data-mode="encrypt" aria-pressed="true">加密回放</button>
            <button type="button" data-mode="decrypt" aria-pressed="false">解密回放</button>
          </div>
          <button type="button" class="machine-action" data-reset>重置输入</button>
        </div>

        <div class="ring-stage">
          <svg class="ring-svg" viewBox="0 0 700 560" aria-hidden="true">
            <ellipse class="orbit" cx="350" cy="280" rx="275" ry="215"></ellipse>
            <g id="ring-links">
              <line class="link" data-link="0" x1="350" y1="65" x2="544" y2="128"></line>
              <line class="link" data-link="1" x1="544" y1="128" x2="625" y2="280"></line>
              <line class="link" data-link="2" x1="625" y1="280" x2="544" y2="432"></line>
              <line class="link" data-link="3" x1="544" y1="432" x2="350" y2="495"></line>
              <line class="link" data-link="4" x1="350" y1="495" x2="156" y2="432"></line>
              <line class="link" data-link="5" x1="156" y1="432" x2="75" y2="280"></line>
              <line class="link" data-link="6" x1="75" y1="280" x2="156" y2="128"></line>
              <line class="link" data-link="7" x1="156" y1="128" x2="350" y2="65"></line>
            </g>
          </svg>
          <button class="word-node" data-node="0" style="--x: 0; --y: -42" type="button"><small><span>DWORD 0</span><span>K0</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="1" style="--x: 30; --y: -30" type="button"><small><span>DWORD 1</span><span>K1</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="2" style="--x: 42; --y: 0" type="button"><small><span>DWORD 2</span><span>K2</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="3" style="--x: 30; --y: 30" type="button"><small><span>DWORD 3</span><span>K3</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="4" style="--x: 0; --y: 42" type="button"><small><span>DWORD 4</span><span>K0</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="5" style="--x: -30; --y: 30" type="button"><small><span>DWORD 5</span><span>K1</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="6" style="--x: -42; --y: 0" type="button"><small><span>DWORD 6</span><span>K2</span></small><output></output><div class="ascii"></div></button>
          <button class="word-node" data-node="7" style="--x: -30; --y: -30" type="button"><small><span>DWORD 7</span><span>K3</span></small><output></output><div class="ascii"></div></button>
          <div class="core-readout" aria-live="polite">
            <div class="round"><output data-round>00</output><span>/32</span></div>
            <dl>
              <dt>SUM</dt><dd data-sum>0x00000000</dd>
              <dt>DELTA</dt><dd>0x9E3779B9</dd>
              <dt>KEY INDEX</dt><dd class="key" data-key-index>K0</dd>
              <dt>DIRECTION</dt><dd data-direction>ENC</dd>
            </dl>
          </div>
        </div>

        <div class="machine-console">
          <div class="transport">
            <button type="button" data-first aria-label="跳到起点">|‹</button>
            <button type="button" data-prev aria-label="后退一轮">‹</button>
            <button type="button" data-play aria-label="播放或暂停">▶</button>
            <button type="button" data-next aria-label="前进一轮">›</button>
            <input class="timeline" data-timeline type="range" min="0" max="32" value="0" step="1" aria-label="32 轮时间轴" />
            <output class="frame-label" data-frame>ROUND 00 / 32</output>
          </div>
          <div class="round-track" data-track aria-hidden="true">{Array.from({ length: 33 }, () => <i></i>)}</div>
          <p class="machine-note">点击节点可锁定观察。拖动时间轴时，环中数值与边权来自同一条确定性 XXTEA 风格状态轨迹。</p>
        </div>
      </div>
    </section>

    <section class="thesis">
      <div class="thesis-main">
        <h2>逆向的字面意思，就是<em>倒着做</em>。</h2>
        <p>两道题表面差异很大。ezMath 是五千行加减，TEA 是环形字运算。真正共用的解法只有一件事：先写出等价状态转移，再从比较结果沿逆运算返回输入。</p>
      </div>
      <div class="operator-tape" aria-label="逆运算映射">
        <div>+=</div><div class="flip">→</div><div>-=</div><div>↺</div>
      </div>
    </section>

    <section class="case" id="ezmath">
      <header class="case-head">
        <div class="case-id">CASE 01<br />EZMATH</div>
        <div class="case-title">
          <h2>先把巨型节点打开</h2>
          <p>Shift+F12 找 flag 检验入口。IDA 图视图拒绝展示时，问题不在算法，而在默认函数尺寸上限。</p>
        </div>
      </header>
      <div class="evidence-grid">
        <figure><img src={img1.src} alt="IDA 字符串窗口中定位 flag 检验" loading="lazy" /><figcaption>E01 / Shift+F12 定位字符串与交叉引用</figcaption></figure>
        <figure><img src={img2.src} alt="IDA 提示节点过大无法显示" loading="lazy" /><figcaption>E02 / Sorry, this node is too big to display</figcaption></figure>
        <figure><img src={img3.src} alt="修改 Hex-Rays MAX_FUNCSIZE 配置" loading="lazy" /><figcaption>E03 / IDA/cfg/hexrays.cfg</figcaption></figure>
        <figure><img src={img4.src} alt="修改后显示出的巨型反编译函数" loading="lazy" /><figcaption>E04 / MAX_FUNCSIZE: 64 → 1024</figcaption></figure>
      </div>
      <div class="procedure">
        <div class="procedure-copy">
          <h3>动态提取，再逆序执行</h3>
          <p>函数最终把 40 个变量与硬编码结果比较。最初可以解析 IDA 日志里的 <code>db</code>，每四字节逆序拼成一个值。</p>
          <ol>
            <li>把原始操作行倒序。</li>
            <li><code>+=</code> 与 <code>-=</code> 互换。</li>
            <li><code>++v</code> 要改成 <code>v-=1</code>，<code>--v</code> 同理。</li>
            <li>恢复的低八位按字符输出。</li>
          </ol>
          <p>后来才发现 <code>Shift+E</code> 可以直接提取数据，但必须先选中数据范围。</p>
          <div class="warning-strip"><strong>坑点</strong><br />五千行中藏着十多个前缀 ++v / --v。也不要链式 replace 两次，因为第二次会把第一次的结果换回去。</div>
        </div>
        <div class="code-unit">
          <details open><summary>extract_values.py / 日志提取</summary><pre><code set:html={extractCode}></code></pre></details>
          <details><summary>solve_ezmath.py / 逆运算</summary><pre><code set:html={solveCode}></code></pre></details>
        </div>
      </div>
      <div class="evidence-grid">
        <figure><img src={img5.src} alt="IDA 数据段中的硬编码比较值" loading="lazy" /><figcaption>E05 / 比较目标值所在的数据段</figcaption></figure>
        <figure><img src={img6.src} alt="IDA 选中数据后使用 Shift+E 提取" loading="lazy" /><figcaption>E06 / 选中数据后使用 Shift+E</figcaption></figure>
      </div>
    </section>

    <section class="case" id="tea">
      <header class="case-head">
        <div class="case-id">CASE 02<br />TEA</div>
        <div class="case-title">
          <h2>识别 8 字环，而不是相信函数名</h2>
          <p>32 字节输入被打包为 8 个 DWORD。前 8 个字符又被两两打包成 4 个 key word，随后进入一个 XXTEA 风格的环形更新。</p>
        </div>
      </header>
      <div class="evidence-grid">
        <figure><img src={img7.src} alt="TEA 题目的输入长度与入口逻辑" loading="lazy" /><figcaption>T01 / strlen(Str) 必须等于 32</figcaption></figure>
        <figure><img src={img8.src} alt="密文比较函数与 32 字节目标值" loading="lazy" /><figcaption>T02 / 比较函数暴露目标密文</figcaption></figure>
      </div>
      <div class="procedure">
        <div class="procedure-copy">
          <h3>先追数据形状</h3>
          <p><code>merge4</code> 每四个字符按大端序打包为一个 DWORD。比较前又把每个 DWORD 从高字节到低字节拆开，按 16 字节跨度写入缓冲区，像一次矩阵转置。</p>
          <div class="memory-lane" aria-label="32 字节到 8 个 DWORD 的打包">
            {Array.from({ length: 8 }, (_, index) => <div><b>V{index}</b>{index * 4}..{index * 4 + 3}</div>)}
          </div>
          <p><code>merge2</code> 虽然面对 <code>char[16]</code>，实际只读取输入前 8 字节并生成 4 个 16 位值。这一处数据类型分析，把未知密钥从 9 字节缩到 1 字节。</p>
        </div>
        <div class="code-unit">
          <details open><summary>merge4() / char[32] → int[8]</summary><pre><code set:html={merge4Code}></code></pre></details>
          <details><summary>tea() / IDA 反编译结果</summary><pre><code set:html={teaDecompiled}></code></pre></details>
          <details><summary>tea() / 化简后的环形状态转移</summary><pre><code set:html={teaSimplified}></code></pre></details>
        </div>
      </div>
    </section>

    <section class="finding">
      <div class="finding-copy">
        <h2>只爆破一个字节</h2>
        <p>题面规定 flag 用 sssctf&#123;&#125; 包裹。密钥来自明文前 8 字节，所以前 7 字节已经确定。</p>
      </div>
      <div class="key-math">
        <div class="key-line"><span class="known">sssctf&#123;</span><span class="unknown">?</span></div>
        <p>KEY = INPUT[0:8]。枚举最后一个字符，按逆序更新 8 个 DWORD。异或保持不变，加法改减法，sum 从 0x61C88647 × -index 开始，并在 Python 中用 &amp; 0xFFFFFFFF 手动模拟 32 位溢出。</p>
      </div>
    </section>

    <section class="case">
      <div class="procedure">
        <div class="procedure-copy">
          <h3>解密不是另一套算法</h3>
          <p>从最后一轮开始，节点索引从 7 回到 0。加密里的加法换成减法，邻接字和 key index 保持相同关系。异或是自己的逆运算，不需要替换。</p>
          <p>这也是首屏实验台的意义。切到“解密回放”时，它不生成一套假动画，而是沿加密产生的 33 个确定状态反向移动。</p>
        </div>
        <div class="code-unit">
          <details open><summary>solve_tea.py / 逆序、溢出与 flag 检测</summary><pre><code set:html={teaDecrypt}></code></pre></details>
        </div>
      </div>
    </section>

    <section class="conclusion">
      <h2>把复杂函数改写成<span>可逆状态机</span>。</h2>
      <div class="takeaways">
        <div><b>01</b><p>两道题的共同核心是逆着运行，并把每一步替换成对应逆运算。</p></div>
        <div><b>02</b><p>写等价代码不是整理工作，而是从混淆中识别算法结构的关键步骤。</p></div>
        <div><b>03</b><p>数据类型决定攻击面。看清 int[4] 只消费 8 字节，才会知道只需爆破 1 字节，而不是 9 字节。</p></div>
      </div>
    </section>
  </main>

  <footer class="lab-footer">
    <span>{title} / {pubDate.toLocaleDateString('zh-CN')}</span>
    <a href="#page-title">回到状态机 ↑</a>
  </footer>

  <OriginalArticle blog={blog} />

  <script is:inline>
    const machine = document.querySelector('#tea-machine');
    if (machine instanceof HTMLElement) {
      const delta = 0x9E3779B9 >>> 0;
      const seedText = 'sssctf{r3v3rs3_1s_run_b4ckw4rd}';
      const keyText = seedText.slice(0, 8);
      const toWord = (text, offset) => (
        ((text.charCodeAt(offset) & 255) << 24) |
        ((text.charCodeAt(offset + 1) & 255) << 16) |
        ((text.charCodeAt(offset + 2) & 255) << 8) |
        (text.charCodeAt(offset + 3) & 255)
      ) >>> 0;
      const initial = Array.from({ length: 8 }, (_, index) => toWord(seedText.padEnd(32, '_'), index * 4));
      const keys = Array.from({ length: 4 }, (_, index) => (
        ((keyText.charCodeAt(index * 2) & 255) << 8) |
        (keyText.charCodeAt(index * 2 + 1) & 255)
      ) >>> 0);
      const mix = (next, previous, sum, key) => (
        (((next ^ sum) + (previous ^ key)) ^
        ((((next << 2) >>> 0) ^ (previous >>> 5)) +
        ((next >>> 3) ^ ((previous << 4) >>> 0)))) >>> 0
      );
      const buildStates = (start) => {
        const states = [start.slice()];
        let words = start.slice();
        let sum = 0;
        for (let round = 1; round <= 32; round += 1) {
          sum = (sum + delta) >>> 0;
          const keyOffset = (sum >>> 2) & 3;
          const nextWords = words.slice();
          for (let index = 0; index < 8; index += 1) {
            const previous = nextWords[(index + 7) % 8];
            const next = words[(index + 1) % 8];
            nextWords[index] = (words[index] + mix(next, previous, sum, keys[keyOffset ^ (index & 3)])) >>> 0;
          }
          words = nextWords;
          states.push(words.slice());
        }
        return states;
      };

      const states = buildStates(initial);
      const nodes = Array.from(machine.querySelectorAll('[data-node]'));
      const links = Array.from(machine.querySelectorAll('[data-link]'));
      const track = Array.from(machine.querySelectorAll('[data-track] i'));
      const timeline = machine.querySelector('[data-timeline]');
      const roundOutput = machine.querySelector('[data-round]');
      const sumOutput = machine.querySelector('[data-sum]');
      const keyOutput = machine.querySelector('[data-key-index]');
      const directionOutput = machine.querySelector('[data-direction]');
      const frameOutput = machine.querySelector('[data-frame]');
      const playButton = machine.querySelector('[data-play]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let mode = 'encrypt';
      let frame = 0;
      let playing = false;
      let timer = 0;
      let lockedNode = -1;

      const hex = (value) => `0x${value.toString(16).padStart(8, '0').toUpperCase()}`;
      const ascii = (value) => [24, 16, 8, 0].map((shift) => {
        const code = (value >>> shift) & 255;
        return code >= 32 && code <= 126 ? String.fromCharCode(code) : '·';
      }).join('');
      const stateIndex = () => mode === 'encrypt' ? frame : 32 - frame;
      const stop = () => {
        playing = false;
        window.clearInterval(timer);
        if (playButton) playButton.textContent = '▶';
      };
      const render = () => {
        const index = stateIndex();
        const state = states[index];
        const previousState = states[Math.max(0, index - 1)];
        const activeNode = lockedNode >= 0 ? lockedNode : (mode === 'encrypt' ? Math.max(0, frame - 1) % 8 : (32 - frame + 7) % 8);
        nodes.forEach((node, nodeIndex) => {
          const output = node.querySelector('output');
          const asciiOutput = node.querySelector('.ascii');
          if (output) output.textContent = hex(state[nodeIndex]);
          if (asciiOutput) asciiOutput.textContent = ascii(state[nodeIndex]);
          node.classList.toggle('active', nodeIndex === activeNode);
        });
        links.forEach((link, linkIndex) => {
          const change = Math.abs((state[linkIndex] | 0) - (previousState[linkIndex] | 0));
          link.classList.toggle('hot', linkIndex === activeNode);
          link.classList.toggle('keyed', linkIndex === (((index * 5) >>> 2) & 7));
          link.style.strokeWidth = `${1.1 + Math.min(4.2, change / 0x2FFFFFFF)}px`;
          link.style.opacity = `${0.34 + Math.min(0.66, change / 0x5FFFFFFF)}`;
        });
        track.forEach((item, itemIndex) => item.classList.toggle('passed', itemIndex <= frame));
        const sum = Math.imul(index, delta) >>> 0;
        const keyIndex = ((sum >>> 2) & 3) ^ (activeNode & 3);
        if (roundOutput) roundOutput.textContent = String(frame).padStart(2, '0');
        if (sumOutput) sumOutput.textContent = hex(sum);
        if (keyOutput) keyOutput.textContent = `K${keyIndex}`;
        if (directionOutput) directionOutput.textContent = mode === 'encrypt' ? 'ENC' : 'DEC';
        if (frameOutput) frameOutput.textContent = `ROUND ${String(frame).padStart(2, '0')} / 32`;
        if (timeline instanceof HTMLInputElement) timeline.value = String(frame);
      };
      const step = (amount) => {
        frame = Math.max(0, Math.min(32, frame + amount));
        render();
        if (frame === 32 && playing) stop();
      };
      const play = () => {
        if (reducedMotion) return;
        if (playing) { stop(); return; }
        if (frame === 32) frame = 0;
        playing = true;
        if (playButton) playButton.textContent = 'Ⅱ';
        timer = window.setInterval(() => step(1), 340);
        render();
      };

      machine.querySelectorAll('[data-mode]').forEach((button) => {
        button.addEventListener('click', () => {
          stop();
          mode = button.getAttribute('data-mode') || 'encrypt';
          frame = 0;
          machine.querySelectorAll('[data-mode]').forEach((candidate) => {
            candidate.setAttribute('aria-pressed', String(candidate === button));
          });
          render();
        });
      });
      machine.querySelector('[data-first]')?.addEventListener('click', () => { stop(); frame = 0; render(); });
      machine.querySelector('[data-prev]')?.addEventListener('click', () => { stop(); step(-1); });
      machine.querySelector('[data-next]')?.addEventListener('click', () => { stop(); step(1); });
      machine.querySelector('[data-play]')?.addEventListener('click', play);
      machine.querySelector('[data-reset]')?.addEventListener('click', () => { stop(); frame = 0; lockedNode = -1; render(); });
      timeline?.addEventListener('input', (event) => {
        stop();
        if (event.currentTarget instanceof HTMLInputElement) frame = Number(event.currentTarget.value);
        render();
      });
      nodes.forEach((node, nodeIndex) => node.addEventListener('click', () => {
        lockedNode = lockedNode === nodeIndex ? -1 : nodeIndex;
        render();
      }));
      render();
    }
  </script>
</body>
</html>

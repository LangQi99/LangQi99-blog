  <script is:inline>
    (() => {
      const input = document.querySelector('#objectChain');
      const rail = document.querySelector('#objectRail');
      const run = document.querySelector('#objectRun');
      const result = document.querySelector('#objectResult');
      if (!input || !rail || !run || !result) return;
      const tokenize = (value) => {
        const tokens = [];
        let current = '';
        let depth = 0;
        for (const character of value.trim().replace(/^u\./, '')) {
          if (character === '(') depth += 1;
          if (character === ')') depth = Math.max(0, depth - 1);
          if (character === '.' && depth === 0) { if (current) tokens.push(current); current = ''; }
          else current += character;
        }
        if (current) tokens.push(current);
        return tokens.filter(Boolean).slice(0, 8);
      };
      const render = () => {
        const tokens = tokenize(input.value);
        const nodes = ['u', ...tokens];
        rail.innerHTML = nodes.map((token, index) => {
          const safe = token.replace(/[<>&"']/g, '');
          const tilt = ((index % 3) - 1) * 2;
          return `${index ? '<span class="chain-arrow"></span>' : ''}<span class="chain-node" style="--tilt:${tilt}deg">${safe || 'attribute'}</span>`;
        }).join('');
        result.textContent = tokens.length ? `result is u → True · ${tokens.length} hop${tokens.length > 1 ? 's' : ''}` : '输入一个调用链';
      };
      run.addEventListener('click', render);
      input.addEventListener('keydown', (event) => { if (event.key === 'Enter') render(); });
      render();
    })();
  </script>

---
import type { CollectionEntry } from "astro:content";
import OriginalArticle from "../../components/article/OriginalArticle.astro";

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const { title, description, pubDate, categories, tags } = blog.data;
const formattedDate = pubDate ? new Date(pubDate).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" }) : "";

const codeUniversalObject = `<span class="kw">class</span> <span class="cls">UniversalObject</span>(<span class="builtin">object</span>):
    <span class="str">"""万用对象"""</span>
    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="param">self</span>):
        <span class="kw">pass</span>

    <span class="kw">def</span> <span class="fn">__getattribute__</span>(<span class="param">self</span>, <span class="param">__name</span>):
        <span class="kw">return</span> <span class="param">self</span>

    <span class="kw">def</span> <span class="fn">__call__</span>(<span class="param">self</span>, <span class="op">*</span><span class="param">args</span>, <span class="op">**</span><span class="param">kwds</span>):
        <span class="kw">return</span> <span class="param">self</span>`;

const codeUniversalDemo = `<span class="param">u</span> <span class="op">=</span> <span class="cls">UniversalObject</span>()
<span class="param">result</span> <span class="op">=</span> <span class="param">u</span>.<span class="attr">any</span>.<span class="attr">attr</span>.<span class="fn">or_method</span>(<span class="num">1</span>, <span class="param">x</span><span class="op">=</span><span class="num">2</span>).<span class="attr">more</span>.<span class="attr">calls</span>
<span class="builtin">print</span>(<span class="param">result</span> <span class="kw">is</span> <span class="param">u</span>)  <span class="cmt"># True</span>`;

const codeLruCache = `<span class="kw">from</span> <span class="mod">functools</span> <span class="kw">import</span> lru_cache

<span class="dec">@lru_cache</span>(<span class="param">maxsize</span><span class="op">=</span><span class="num">128</span>)
<span class="kw">def</span> <span class="fn">fib</span>(<span class="param">n</span>: <span class="builtin">int</span>) <span class="op">-></span> <span class="builtin">int</span>:
    <span class="kw">return</span> <span class="param">n</span> <span class="kw">if</span> <span class="param">n</span> <span class="op">&lt;</span> <span class="num">2</span> <span class="kw">else</span> <span class="fn">fib</span>(<span class="param">n</span> <span class="op">-</span> <span class="num">1</span>) <span class="op">+</span> <span class="fn">fib</span>(<span class="param">n</span> <span class="op">-</span> <span class="num">2</span>)

<span class="builtin">print</span>(<span class="fn">fib</span>(<span class="num">6</span>))  <span class="cmt"># 8</span>`;

const codeSingledispatch = `<span class="kw">from</span> <span class="mod">functools</span> <span class="kw">import</span> singledispatch

<span class="dec">@singledispatch</span>
<span class="kw">def</span> <span class="fn">to_str</span>(<span class="param">x</span>) <span class="op">-></span> <span class="builtin">str</span>:
    <span class="kw">return</span> <span class="str">f"obj:</span>{<span class="param">x</span><span class="op">!</span>r}<span class="str">"</span>

<span class="dec">@to_str.register</span>
<span class="kw">def</span> <span class="fn">_</span>(<span class="param">x</span>: <span class="builtin">int</span>) <span class="op">-></span> <span class="builtin">str</span>:
    <span class="kw">return</span> <span class="str">f"int:</span>{<span class="param">x</span>}<span class="str">"</span>

<span class="dec">@to_str.register</span>
<span class="kw">def</span> <span class="fn">_</span>(<span class="param">x</span>: <span class="builtin">list</span>) <span class="op">-></span> <span class="builtin">str</span>:
    <span class="kw">return</span> <span class="str">"list:"</span> <span class="op">+</span> <span class="str">","</span>.<span class="fn">join</span>(<span class="builtin">map</span>(<span class="builtin">str</span>, <span class="param">x</span>))`;

const codeGlobalsRpc = `<span class="cmt"># Server-side: serialize operations as data</span>
ServerSystems.ClientRpc.<span class="fn">RequestToClient</span>(
    <span class="fn">convert_operation</span>(<span class="fn">COLLECTION</span>(
        <span class="fn">GLOBALS</span>()[<span class="str">"clientApi"</span>].<span class="fn">SetHudChatStackVisible</span>(<span class="kw">False</span>),
        <span class="fn">GLOBALS</span>()[<span class="str">"clientApi"</span>].<span class="fn">RegisterUI</span>(...),
        <span class="fn">GLOBALS</span>().<span class="fn">setitem</span>(key, value),
    )), target
)

<span class="cmt"># Client-side equivalent execution:</span>
clientApi.<span class="fn">SetHudChatStackVisible</span>(<span class="kw">False</span>)
clientApi.<span class="fn">RegisterUI</span>(...)
globals()[key] <span class="op">=</span> value`;
---

<!doctype html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {categories && <meta name="article:section" content={categories[0]} />}
  {tags && tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  {pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global is:inline>
    :root {
      --bg-deep: #0d1117;
      --bg-surface: #161b22;
      --bg-card: #1c2128;
      --bg-elevated: #242b35;
      --bg-code: #0d1117;
      --text-primary: #f0f3f6;
      --text-secondary: #9eaab6;
      --text-muted: #636e7b;
      --accent: #F59E0B;
      --accent-hover: #D97706;
      --accent-glow: rgba(245, 158, 11, 0.15);
      --accent-subtle: rgba(245, 158, 11, 0.08);
      --green: #34D399;
      --purple: #A78BFA;
      --blue: #60A5FA;
      --pink: #F472B6;
      --red: #F87171;
      --radius: 8px;
      --radius-lg: 12px;
      --border: rgba(255, 255, 255, 0.06);
      --border-accent: rgba(245, 158, 11, 0.3);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* Navigation */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(13, 17, 23, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav-back {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-back:hover {
      color: var(--accent);
    }

    .nav-back svg {
      width: 16px;
      height: 16px;
    }

    .nav-tag {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: var(--accent-subtle);
      border: 1px solid var(--border-accent);
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      color: var(--accent);
    }

    .nav-tag .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Hero */
    .hero {
      padding: 140px 24px 80px;
      max-width: 900px;
      margin: 0 auto;
      position: relative;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 60px;
      left: -200px;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 32px;
    }

    .hero-badge .icon {
      font-size: 16px;
    }

    .hero h1 {
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }

    .hero h1 .highlight {
      background: linear-gradient(135deg, var(--accent) 0%, #FBBF24 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-desc {
      font-size: 1.15rem;
      color: var(--text-secondary);
      max-width: 600px;
      line-height: 1.7;
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 32px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .hero-meta .sep {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--text-muted);
    }

    /* Trick Cards */
    .tricks {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 24px 100px;
      display: flex;
      flex-direction: column;
      gap: 64px;
    }

    .trick {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .trick.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .trick-header {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 20px;
    }

    .trick-number {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: #000;
      font-weight: 700;
      font-size: 16px;
      border-radius: var(--radius);
    }

    .trick-title-group {
      flex: 1;
    }

    .trick-title {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 4px;
    }

    .trick-subtitle {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .trick-body {
      padding-left: 56px;
    }

    .trick-desc {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.8;
      margin-bottom: 20px;
    }

    .trick-desc strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    /* Code Blocks */
    .code-block {
      position: relative;
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 20px;
    }

    .code-block-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
    }

    .code-block-dots {
      display: flex;
      gap: 6px;
    }

    .code-block-dots span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .code-block-dots span:nth-child(1) { background: #F87171; }
    .code-block-dots span:nth-child(2) { background: #FBBF24; }
    .code-block-dots span:nth-child(3) { background: #34D399; }

    .code-block-label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .code-block pre {
      padding: 20px;
      overflow-x: auto;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      font-size: 13.5px;
      line-height: 1.7;
      color: var(--text-secondary);
    }

    .code-block pre .kw { color: var(--purple); }
    .code-block pre .fn { color: var(--blue); }
    .code-block pre .cls { color: var(--green); }
    .code-block pre .str { color: var(--green); }
    .code-block pre .num { color: var(--accent); }
    .code-block pre .cmt { color: var(--text-muted); font-style: italic; }
    .code-block pre .dec { color: var(--accent); }
    .code-block pre .param { color: var(--text-primary); }
    .code-block pre .op { color: var(--pink); }
    .code-block pre .builtin { color: #67E8F9; }
    .code-block pre .mod { color: var(--text-primary); }
    .code-block pre .attr { color: var(--text-secondary); }

    /* Use Case Pills */
    .use-cases {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }

    .use-case {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 13px;
      color: var(--text-secondary);
      transition: border-color 0.2s, background 0.2s;
    }

    .use-case:hover {
      border-color: var(--border-accent);
      background: var(--accent-subtle);
    }

    .use-case .icon {
      font-size: 14px;
    }

    /* Info Callout */
    .callout {
      padding: 16px 20px;
      background: var(--accent-subtle);
      border-left: 3px solid var(--accent);
      border-radius: 0 var(--radius) var(--radius) 0;
      margin-top: 16px;
    }

    .callout p {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .callout strong {
      color: var(--accent);
    }

    /* How It Works */
    .mechanism {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }

    .mechanism-item {
      padding: 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: border-color 0.2s;
    }

    .mechanism-item:hover {
      border-color: var(--border-accent);
    }

    .mechanism-item .label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 6px;
    }

    .mechanism-item code {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 13px;
      color: var(--text-primary);
      font-weight: 500;
    }

    .mechanism-item .desc {
      font-size: 12.5px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* Steps */
    .steps {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }

    .step {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .step-num {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-subtle);
      border: 1px solid var(--border-accent);
      border-radius: 50%;
      font-size: 11px;
      font-weight: 600;
      color: var(--accent);
    }

    .step-text {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .step-text code {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 12px;
      padding: 2px 6px;
      background: var(--bg-elevated);
      border-radius: 4px;
      color: var(--accent);
    }

    /* Divider */
    .trick-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), var(--border-accent), var(--border), transparent);
      margin-top: 20px;
    }

    /* Footer */
    .site-footer {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 24px 60px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      color: var(--text-muted);
    }

    .footer-tags {
      display: flex;
      gap: 8px;
    }

    .footer-tag {
      padding: 4px 10px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 12px;
    }

    /* Responsive */
    @media (max-width: 640px) {
      .hero {
        padding: 120px 20px 60px;
      }

      .tricks {
        padding: 0 20px 80px;
        gap: 48px;
      }

      .trick-body {
        padding-left: 0;
      }

      .trick-header {
        flex-direction: column;
        gap: 12px;
      }

      .mechanism {
        grid-template-columns: 1fr;
      }

      .site-footer {
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
      }

      .hero-meta {
        flex-wrap: wrap;
      }

      .code-block pre {
        font-size: 12px;
        padding: 16px;
      }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .trick {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .nav-tag .dot {
        animation: none;
      }

      html {
        scroll-behavior: auto;
      }
    }
  </style>
</head>
<body>
  <style is:inline>
    body > :not(.object-site):not(script):not(style) { display: none !important; }
    .object-site {
      --ink: #17211d;
      --paper: #f7f4ed;
      --lime: #c9f45a;
      --blue: #1b5cff;
      --line: rgba(23,33,29,.2);
      min-height: 100dvh;
      color: var(--ink);
      background:
        linear-gradient(90deg, transparent 31px, rgba(23,33,29,.045) 32px),
        linear-gradient(transparent 31px, rgba(23,33,29,.045) 32px),
        var(--paper);
      background-size: 32px 32px;
      font-family: "Outfit", sans-serif;
      line-height: 1.5;
    }
    .object-site * { box-sizing: border-box; }
    .object-nav {
      height: 70px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(18px, 4vw, 64px); border-bottom: 1px solid var(--ink); background: rgba(247,244,237,.92);
    }
    .object-nav a { color: inherit; text-decoration: none; font-weight: 750; }
    .object-wordmark { display: flex; gap: 9px; align-items: center; }
    .object-wordmark i { width: 20px; height: 20px; border: 2px solid var(--ink); background: var(--lime); transform: rotate(12deg); }
    .object-nav small { font: 700 11px/1 monospace; text-transform: uppercase; letter-spacing: .12em; }
    .object-hero {
      min-height: calc(100dvh - 70px); display: grid; grid-template-columns: minmax(360px,.72fr) minmax(600px,1.28fr);
      align-items: center; gap: clamp(32px, 5vw, 86px); padding: clamp(40px,6vh,72px) clamp(18px,4vw,64px);
    }
    .object-copy h1 {
      margin: 0 0 24px; font-size: clamp(3.3rem, 6vw, 7.2rem); line-height: .9; letter-spacing: -.075em;
    }
    .object-copy h1 em { font-style: normal; color: var(--blue); }
    .object-copy p { font-size: clamp(1rem,1.35vw,1.3rem); max-width: 480px; margin: 0 0 28px; color: rgba(23,33,29,.72); }
    .object-copy a {
      display: inline-flex; color: white; background: var(--ink); padding: 13px 18px;
      text-decoration: none; font-weight: 700; box-shadow: 7px 7px 0 var(--lime);
    }
    .object-lab {
      border: 2px solid var(--ink); background: rgba(255,255,255,.74); box-shadow: 18px 18px 0 var(--blue);
      min-height: 570px; display: grid; grid-template-rows: auto auto 1fr auto;
    }
    .lab-top {
      min-height: 52px; display: flex; justify-content: space-between; align-items: center;
      padding: 0 16px; border-bottom: 2px solid var(--ink); font: 800 11px/1 monospace;
      letter-spacing: .1em; text-transform: uppercase;
    }
    .lab-input { padding: 18px; border-bottom: 1px solid var(--ink); }
    .lab-input label { display: block; font: 750 12px/1 monospace; margin-bottom: 9px; }
    .lab-command { display: grid; grid-template-columns: auto 1fr auto; border: 1px solid var(--ink); align-items: stretch; }
    .lab-command span { padding: 13px; font: 700 14px/1.5 monospace; background: var(--ink); color: var(--lime); }
    .lab-command input {
      min-width: 0; border: 0; padding: 13px; color: var(--ink); background: white;
      font: 700 14px/1.5 monospace; outline: none;
    }
    .lab-command button { border: 0; border-left: 1px solid var(--ink); padding: 0 17px; background: var(--lime); color: var(--ink); font-weight: 850; cursor: pointer; }
    .chain-stage {
      padding: 30px 20px; overflow: hidden; display: flex; flex-direction: column; justify-content: center;
      background: linear-gradient(135deg, rgba(201,244,90,.2), transparent 55%);
    }
    .chain-rail { display: flex; align-items: center; gap: 12px; overflow-x: auto; padding: 22px 8px 32px; scrollbar-width: thin; }
    .chain-node {
      flex: 0 0 auto; min-width: 108px; min-height: 108px; border: 2px solid var(--ink); background: white;
      display: grid; place-items: center; padding: 12px; text-align: center; font: 800 13px/1.25 monospace;

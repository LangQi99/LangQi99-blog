---
import OriginalArticle from "../../components/article/OriginalArticle.astro";

interface Props {
  blog: any;
}

const { blog } = Astro.props;
const title = blog.data.title;
const description = blog.data.description;
const pubDate = blog.data.pubDate;
const categories = blog.data.categories;
const tags = blog.data.tags;

const { Content } = await blog.render();

const challengeCategories = [
  { id: "all", label: "All", count: 19 },
  { id: "reverse", label: "Reverse", count: 5 },
  { id: "misc", label: "Misc", count: 4 },
  { id: "pwn", label: "Pwn", count: 2 },
  { id: "web", label: "Web", count: 3 },
  { id: "crypto", label: "Crypto", count: 5 },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="LangQi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta property="article:published_time" content={pubDate.toISOString()} />
  <meta property="article:author" content="LangQi" />
  <meta name="theme-color" content="#f04a24" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --c-bg: #fafafa;
      --c-surface: #ffffff;
      --c-surface-hover: #f5f5f5;
      --c-border: #e8e8e8;
      --c-border-light: #f0f0f0;
      --c-text: #1a1a1a;
      --c-text-secondary: #555555;
      --c-text-muted: #888888;
      --c-accent: #EC4899;
      --c-accent-light: #EC489915;
      --c-accent-hover: #db2777;
      --c-reverse: #8b5cf6;
      --c-misc: #06b6d4;
      --c-pwn: #f59e0b;
      --c-web: #10b981;
      --c-crypto: #6366f1;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-code: 'Fira Code', monospace;
      --radius: 6px;
      --space-xs: 4px;
      --space-sm: 8px;
      --space-md: 16px;
      --space-lg: 24px;
      --space-xl: 40px;
      --space-2xl: 64px;
      --space-3xl: 96px;
      --max-width: 860px;
      --transition: 0.2s ease;
    }

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      background: var(--c-bg);
      color: var(--c-text);
      line-height: 1.7;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
      .reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .category-pill,
      .accordion-trigger,
      .back-link {
        transition: none !important;
      }
    }

    /* Back link */
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--c-text-muted);
      text-decoration: none;
      transition: color var(--transition);
      padding: var(--space-sm) 0;
    }

    .back-link:hover {
      color: var(--c-accent);
    }

    .back-link svg {
      width: 16px;
      height: 16px;
    }

    /* Layout */
    .page-container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: var(--space-xl) var(--space-lg);
    }

    @media (max-width: 640px) {
      .page-container {
        padding: var(--space-lg) var(--space-md);
      }
    }

    /* Header */
    .site-header {
      padding-bottom: var(--space-xl);
      border-bottom: 1px solid var(--c-border);
      margin-bottom: var(--space-xl);
    }

    .header-top {
      margin-bottom: var(--space-xl);
    }

    .page-title {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      color: var(--c-text);
      margin-top: var(--space-lg);
      margin-bottom: var(--space-md);
    }

    .page-description {
      font-size: 1.0625rem;
      color: var(--c-text-secondary);
      font-weight: 400;
    }

    .page-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm) var(--space-md);
      margin-top: var(--space-md);
      font-size: 0.8125rem;
      color: var(--c-text-muted);
    }

    .meta-separator {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--c-text-muted);
      opacity: 0.5;
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .tag-item {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--c-accent);
      background: var(--c-accent-light);
      padding: 2px 8px;
      border-radius: var(--radius);
    }

    /* Category Filter Nav */
    .category-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--c-bg);
      padding: var(--space-md) 0;
      border-bottom: 1px solid var(--c-border-light);
      margin-bottom: var(--space-xl);
    }

    .category-nav::before {
      content: '';
      position: absolute;
      top: -20px;
      left: 0;
      right: 0;
      height: 20px;
      background: var(--c-bg);
    }

    .category-pills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .category-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--c-text-secondary);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      cursor: pointer;
      transition: all var(--transition);
      user-select: none;
    }

    .category-pill:hover {
      border-color: var(--c-accent);
      color: var(--c-accent);
    }

    .category-pill.active {
      background: var(--c-accent);
      border-color: var(--c-accent);
      color: #ffffff;
    }

    .category-pill .pill-count {
      font-size: 0.6875rem;
      font-weight: 700;
      opacity: 0.7;
    }

    .category-pill.active .pill-count {
      opacity: 0.9;
    }

    /* Category Sections */
    .category-section {
      margin-bottom: var(--space-2xl);
    }

    .category-section[data-hidden="true"] {
      display: none;
    }

    .category-header {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: 2px solid var(--c-border);
    }

    .category-indicator {
      width: 4px;
      height: 28px;
      border-radius: 2px;
    }

    .category-indicator[data-cat="reverse"] { background: var(--c-reverse); }
    .category-indicator[data-cat="misc"] { background: var(--c-misc); }
    .category-indicator[data-cat="pwn"] { background: var(--c-pwn); }
    .category-indicator[data-cat="web"] { background: var(--c-web); }
    .category-indicator[data-cat="crypto"] { background: var(--c-crypto); }

    .category-title {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .category-badge {
      font-size: 0.6875rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: var(--radius);
      color: #ffffff;
    }

    .category-badge[data-cat="reverse"] { background: var(--c-reverse); }
    .category-badge[data-cat="misc"] { background: var(--c-misc); }
    .category-badge[data-cat="pwn"] { background: var(--c-pwn); }
    .category-badge[data-cat="web"] { background: var(--c-web); }
    .category-badge[data-cat="crypto"] { background: var(--c-crypto); }

    /* Content prose styling */
    .content-body {
      font-size: 0.9375rem;
      line-height: 1.8;
      color: var(--c-text);
    }

    .content-body :global(h1) {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-top: var(--space-2xl);
      margin-bottom: var(--space-lg);
      padding-top: var(--space-lg);
      border-top: 2px solid var(--c-border);
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }

    .content-body :global(h1)::before {
      content: '';
      width: 4px;
      height: 24px;
      border-radius: 2px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    .content-body :global(h2) {
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-top: var(--space-xl);
      margin-bottom: var(--space-md);
      color: var(--c-text);
    }

    .content-body :global(h3) {
      font-size: 1rem;
      font-weight: 600;
      margin-top: var(--space-lg);
      margin-bottom: var(--space-sm);
    }

    .content-body :global(p) {
      margin-bottom: var(--space-md);
      color: var(--c-text-secondary);
    }

    .content-body :global(a) {
      color: var(--c-accent);
      text-decoration: none;
      font-weight: 500;
      border-bottom: 1px solid transparent;
      transition: border-color var(--transition);
    }

    .content-body :global(a:hover) {
      border-bottom-color: var(--c-accent);
    }

    .content-body :global(strong) {
      font-weight: 600;
      color: var(--c-text);
    }

    .content-body :global(code) {
      font-family: var(--font-code);
      font-size: 0.8125em;
      background: #f3f4f6;
      padding: 2px 6px;
      border-radius: 4px;
      color: var(--c-accent-hover);
    }

    .content-body :global(pre) {
      background: #1e1e2e;
      color: #cdd6f4;
      padding: var(--space-lg);
      border-radius: var(--radius);
      overflow-x: auto;
      margin: var(--space-lg) 0;
      font-size: 0.8125rem;
      line-height: 1.6;
      border: 1px solid #313244;
    }

    .content-body :global(pre code) {
      background: none;
      padding: 0;
      border-radius: 0;
      color: inherit;
      font-size: inherit;
    }

    .content-body :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius);
      margin: var(--space-lg) 0;
      border: 1px solid var(--c-border);
    }

    .content-body :global(ul),
    .content-body :global(ol) {
      margin: var(--space-md) 0;
      padding-left: var(--space-lg);
      color: var(--c-text-secondary);
    }

    .content-body :global(li) {
      margin-bottom: var(--space-xs);
    }

    .content-body :global(blockquote) {
      border-left: 3px solid var(--c-accent);
      padding-left: var(--space-md);
      margin: var(--space-lg) 0;
      color: var(--c-text-muted);
      font-style: italic;
    }

    .content-body :global(hr) {
      border: none;
      border-top: 1px solid var(--c-border);
      margin: var(--space-xl) 0;
    }

    .content-body :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--space-lg) 0;
      font-size: 0.875rem;
    }

    .content-body :global(th),
    .content-body :global(td) {
      padding: var(--space-sm) var(--space-md);
      border: 1px solid var(--c-border);
      text-align: left;
    }

    .content-body :global(th) {
      background: var(--c-surface-hover);
      font-weight: 600;
    }

    .content-body :global(kbd) {
      font-family: var(--font-code);
      font-size: 0.75em;
      background: var(--c-surface-hover);
      border: 1px solid var(--c-border);
      border-radius: 4px;
      padding: 2px 6px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    /* Reveal animations */
    .reveal {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Footer */
    .site-footer {
      margin-top: var(--space-3xl);
      padding-top: var(--space-xl);
      border-top: 1px solid var(--c-border);
      text-align: center;
      color: var(--c-text-muted);
      font-size: 0.8125rem;
    }

    .footer-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .footer-tag {
      font-size: 0.75rem;
      color: var(--c-text-muted);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      padding: 2px 10px;
      border-radius: var(--radius);
    }

    /* Scroll to top */
    .scroll-top {
      position: fixed;
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 40px;
      height: 40px;
      border-radius: var(--radius);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      transform: translateY(10px);
      transition: all var(--transition);
      z-index: 40;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .scroll-top.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .scroll-top:hover {
      border-color: var(--c-accent);
      color: var(--c-accent);
    }

    .scroll-top svg {
      width: 18px;
      height: 18px;
    }
  </style>
  <style>
    :root {
      --paper: #f1eddf;
      --paper-deep: #e6e0ce;
      --ink: #151713;
      --ink-soft: #4a4b43;
      --signal: #f04a24;
      --signal-dark: #b92d13;
      --line: rgba(21, 23, 19, 0.26);
      --line-strong: rgba(21, 23, 19, 0.72);
      --sans: "Plus Jakarta Sans", "PingFang SC", "Microsoft YaHei", sans-serif;
      --mono: "Fira Code", "SFMono-Regular", Consolas, monospace;
    }

    html {
      background: var(--paper);
      scroll-padding-top: 88px;
    }

    body {
      margin: 0;
      min-width: 320px;
      background:
        linear-gradient(rgba(21, 23, 19, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(21, 23, 19, 0.035) 1px, transparent 1px),
        var(--paper);
      background-size: 32px 32px;
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.6;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    button:focus-visible,
    a:focus-visible {
      outline: 3px solid var(--signal);
      outline-offset: 3px;
    }

    .ops-nav {
      position: relative;
      z-index: 20;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 3vw;
      border-bottom: 1px solid var(--line-strong);
      background: rgba(241, 237, 223, 0.94);
    }

    .ops-brand {
      color: var(--ink);
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
    }

    .ops-brand span {
      color: var(--signal);
    }

    .ops-nav__center {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .ops-status {
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .ops-status::before {
      width: 9px;
      height: 9px;
      border: 2px solid var(--ink);
      background: var(--signal);
      content: "";
      animation: status-pulse 1.8s steps(2, end) infinite;
    }

    .command-hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(280px, 0.76fr) minmax(620px, 1.5fr);
      gap: clamp(2rem, 4vw, 5rem);
      align-items: stretch;
      min-height: calc(100svh - 64px);
      max-width: 1600px;
      margin: 0 auto;
      padding: clamp(2.2rem, 4.6vh, 4.2rem) 3vw 2.2rem;
      overflow: hidden;
    }

    .command-hero::after {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 21vw;
      height: 18px;
      background: repeating-linear-gradient(90deg, var(--signal) 0 24px, transparent 24px 36px);
      content: "";
      opacity: 0.9;
    }

    .briefing {
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding-bottom: 2rem;
    }

    .briefing__code {
      margin: 0 0 clamp(1.2rem, 4vh, 3.5rem);
      font-family: var(--mono);
      font-size: 0.69rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .briefing__code strong {
      display: inline-block;
      margin-right: 0.8rem;
      padding: 0.14rem 0.45rem;
      background: var(--signal);
      color: #fffaf0;
    }

    .briefing h1 {
      max-width: 9ch;
      margin: 0;
      font-size: clamp(3.2rem, 5.7vw, 6.7rem);
      font-weight: 800;
      letter-spacing: -0.075em;
      line-height: 0.86;
    }

    .briefing h1 span {
      display: block;
      color: var(--signal);
    }

    .briefing__lead {
      max-width: 31rem;
      margin: clamp(1.4rem, 3vh, 2.5rem) 0 0;
      color: var(--ink-soft);
      font-size: clamp(0.94rem, 1.15vw, 1.08rem);
      font-weight: 600;
      line-height: 1.65;
    }

    .briefing__meta {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      margin-top: auto;
      padding-top: 2rem;
      border-top: 1px solid var(--line-strong);
      background: var(--line-strong);
    }

    .briefing__metric {
      min-width: 0;
      padding: 0.8rem 0.45rem;
      background: var(--paper);
    }

    .briefing__metric b {
      display: block;
      font-family: var(--mono);
      font-size: clamp(1.2rem, 2vw, 2rem);
      line-height: 1;
    }

    .briefing__metric span {
      display: block;
      margin-top: 0.45rem;
      color: var(--ink-soft);
      font-family: var(--mono);
      font-size: 0.58rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .command-center {
      position: relative;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      min-height: 0;
      border: 2px solid var(--ink);
      background: rgba(241, 237, 223, 0.68);
      box-shadow: 14px 14px 0 rgba(21, 23, 19, 0.12);
    }

    .zone-switcher {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      border-bottom: 2px solid var(--ink);
    }

    .zone-button {
      position: relative;
      min-width: 0;
      padding: 0.8rem 0.35rem 0.72rem;
      border: 0;
      border-right: 1px solid var(--ink);
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      font-family: var(--mono);
      font-size: clamp(0.62rem, 0.8vw, 0.76rem);
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      transition: color 150ms ease, background-color 150ms ease;
    }

    .zone-button:last-child {
      border-right: 0;
    }

    .zone-button small {
      display: block;
      margin-top: 0.2rem;
      font-size: 0.56rem;
      font-weight: 500;
      opacity: 0.65;
    }

    .zone-button:hover,
    .zone-button[aria-selected="true"] {
      background: var(--ink);
      color: var(--paper);
    }

    .zone-button[aria-selected="true"]::after {
      position: absolute;
      right: 8px;
      bottom: -7px;
      left: 8px;
      z-index: 2;
      height: 7px;
      background: var(--signal);
      content: "";
    }

    .command-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(230px, 0.8fr);
      min-height: 0;
    }

    .radar-panel {
      position: relative;
      min-height: 510px;
      overflow: hidden;
      border-right: 2px solid var(--ink);
      background:
        linear-gradient(rgba(21, 23, 19, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(21, 23, 19, 0.08) 1px, transparent 1px);
      background-size: 30px 30px;
    }

    .radar-panel::before,
    .radar-panel::after {
      position: absolute;
      inset: 50% auto auto 50%;
      width: min(70%, 420px);
      aspect-ratio: 1;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      content: "";
      transform: translate(-50%, -50%);
    }

    .radar-panel::after {
      width: min(43%, 250px);
      border-style: dashed;
    }

    .radar-sweep {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      width: min(35%, 210px);
      height: 2px;
      background: linear-gradient(90deg, var(--signal), transparent);
      transform-origin: left center;
      animation: radar-sweep 5s linear infinite;
    }

    .radar-axis {
      position: absolute;
      z-index: 0;
      background: var(--line);
    }

    .radar-axis--x {
      top: 50%;
      right: 6%;
      left: 6%;
      height: 1px;
    }

    .radar-axis--y {
      top: 7%;
      bottom: 7%;
      left: 50%;
      width: 1px;
    }

    .radar-core {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 4;
      display: grid;
      width: 94px;
      aspect-ratio: 1;
      place-items: center;
      border: 2px solid var(--ink);
      background: var(--signal);
      color: #fffaf0;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 700;
      text-align: center;
      text-transform: uppercase;
      transform: translate(-50%, -50%) rotate(45deg);
    }

    .radar-core span {
      transform: rotate(-45deg);
    }

    .target-node {
      position: absolute;
      z-index: 5;
      width: 14px;
      height: 14px;
      padding: 0;
      border: 2px solid var(--ink);
      border-radius: 0;
      background: var(--paper);
      cursor: pointer;
      transform: translate(-50%, -50%) rotate(45deg);
      transition: width 180ms ease, height 180ms ease, background-color 180ms ease;
    }

    .target-node::after {
      position: absolute;
      top: 16px;
      left: 7px;
      width: max-content;
      max-width: 120px;
      color: var(--ink);
      content: attr(aria-label);
      font-family: var(--mono);
      font-size: 0.55rem;
      font-weight: 700;
      line-height: 1.2;
      transform: rotate(-45deg);
      transform-origin: left top;
    }

    .target-node:hover,
    .target-node.is-active {
      width: 22px;
      height: 22px;
      background: var(--signal);
    }

    .target-node:nth-of-type(1) { top: 21%; left: 33%; }
    .target-node:nth-of-type(2) { top: 30%; left: 70%; }
    .target-node:nth-of-type(3) { top: 68%; left: 74%; }
    .target-node:nth-of-type(4) { top: 77%; left: 37%; }
    .target-node:nth-of-type(5) { top: 47%; left: 18%; }
    .target-node:nth-of-type(6) { top: 16%; left: 54%; }
    .target-node:nth-of-type(7) { top: 84%; left: 58%; }

    .radar-readout {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 6;
      padding: 0.6rem 0.7rem;
      border-left: 5px solid var(--signal);
      background: var(--paper);
      font-family: var(--mono);
    }

    .radar-readout b {
      display: block;
      font-size: clamp(0.95rem, 1.4vw, 1.25rem);
      text-transform: uppercase;
    }

    .radar-readout span {
      display: block;
      margin-top: 0.15rem;
      color: var(--ink-soft);
      font-size: 0.58rem;
    }

    .radar-telemetry {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      z-index: 6;
      width: 11rem;
      font-family: var(--mono);
      font-size: 0.58rem;
      text-align: right;
    }

    .radar-telemetry strong {
      color: var(--signal-dark);
    }

    .queue-panel {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
      background: rgba(230, 224, 206, 0.72);
    }

    .queue-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.8rem 0.85rem;
      border-bottom: 1px solid var(--ink);
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .queue-header span:last-child {
      color: var(--signal-dark);
    }

    .mission-queue {
      display: grid;
      align-content: start;
      overflow: auto;
      scrollbar-color: var(--signal) var(--paper-deep);
    }

    .mission-item {
      display: grid;
      grid-template-columns: 2.2rem 1fr auto;
      gap: 0.55rem;
      align-items: center;
      min-width: 0;
      padding: 0.78rem 0.8rem;
      border: 0;
      border-bottom: 1px solid var(--line-strong);
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      text-align: left;
      transition: background-color 150ms ease, color 150ms ease;
    }

    .mission-item:hover,
    .mission-item.is-active {
      background: var(--ink);
      color: var(--paper);
    }

    .mission-index {
      font-family: var(--mono);
      font-size: 0.59rem;
      opacity: 0.65;
    }

    .mission-name {
      overflow: hidden;
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mission-state {
      font-family: var(--mono);
      font-size: 0.52rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .mission-state[data-state="trace"] {
      color: var(--signal);
    }

    .queue-footer {
      margin-top: auto;
      padding: 0.85rem;
      border-top: 2px solid var(--ink);
    }

    .focus-button {
      width: 100%;
      min-height: 42px;
      border: 2px solid var(--ink);
      border-radius: 0;
      background: var(--signal);
      color: #fffaf0;
      cursor: pointer;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 700;
      text-transform: uppercase;
      transition: background-color 150ms ease, transform 150ms ease;
    }

    .focus-button:hover {
      background: var(--signal-dark);
    }

    .focus-button:active {
      transform: translateY(1px);
    }

    .archive {
      position: relative;
      border-top: 2px solid var(--ink);
      background: var(--paper);
    }

    .archive-masthead {
      display: grid;
      grid-template-columns: minmax(250px, 0.7fr) minmax(0, 1.3fr);
      gap: 5vw;
      max-width: 1400px;
      margin: 0 auto;
      padding: clamp(4.5rem, 9vw, 9rem) 4vw clamp(2.5rem, 5vw, 5rem);
    }

    .archive-masthead h2 {
      max-width: 8ch;
      margin: 0;
      font-size: clamp(2.8rem, 6vw, 6.5rem);
      letter-spacing: -0.07em;
      line-height: 0.88;
    }

    .archive-masthead__copy {
      align-self: end;
      max-width: 44rem;
      padding-top: 1rem;
      border-top: 5px solid var(--signal);
    }

    .archive-masthead__copy p {
      margin: 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      font-weight: 600;
    }

    .archive-masthead__copy div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.4rem;
    }

    .archive-masthead__copy span {
      border: 1px solid var(--ink);
      padding: 0.25rem 0.5rem;
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 700;
    }

    .content-body {
      width: min(1120px, calc(100% - 8vw));
      margin: 0 auto;
      padding: 0 0 clamp(6rem, 12vw, 12rem);
      color: var(--ink);
      font-size: clamp(0.96rem, 1.2vw, 1.08rem);
      line-height: 1.85;
    }

    .content-body :global(h1) {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1rem;
      margin: clamp(6rem, 12vw, 12rem) 0 3rem;
      padding: 1rem 0;
      border-top: 6px solid var(--ink);
      border-bottom: 1px solid var(--ink);
      color: var(--ink);
      font-size: clamp(3rem, 7vw, 7rem);
      font-weight: 800;
      letter-spacing: -0.075em;
      line-height: 0.9;
      scroll-margin-top: 84px;
    }

    .content-body :global(h1)::before {
      display: none;
    }

    .content-body :global(h1)::after {
      color: var(--signal);
      content: "ACTIVE THEATER";
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.1em;
    }

    .content-body :global(h2) {
      position: relative;
      margin: clamp(4rem, 7vw, 7rem) 0 1.4rem;
      padding: 0.75rem 0 0.75rem clamp(1rem, 2vw, 2rem);
      border-left: clamp(7px, 1vw, 13px) solid var(--signal);
      color: var(--ink);
      font-size: clamp(1.75rem, 3.5vw, 3.2rem);
      font-weight: 800;
      letter-spacing: -0.045em;
      line-height: 1.05;
      scroll-margin-top: 84px;
    }

    .content-body :global(h2)::after {
      display: block;
      margin-top: 0.55rem;
      color: var(--ink-soft);
      content: "MISSION RECORD / VERIFIED FIELD NOTES";
      font-family: var(--mono);
      font-size: 0.56rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .content-body :global(h3) {
      margin-top: 3rem;
      color: var(--ink);
      font-size: 1.25rem;
    }

    .content-body :global(p),
    .content-body :global(ul),
    .content-body :global(ol) {
      max-width: 76ch;
      color: var(--ink-soft);
    }

    .content-body :global(a) {
      color: var(--signal-dark);
      font-weight: 800;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }

    .content-body :global(strong) {
      color: var(--ink);
    }

    .content-body :global(code) {
      border-radius: 0;
      background: var(--paper-deep);
      color: var(--signal-dark);
      font-family: var(--mono);
    }

    .content-body :global(pre) {
      position: relative;
      max-height: 680px;
      margin: 2rem 0 3rem;
      padding: 2.9rem 1.3rem 1.4rem;
      overflow: auto;
      border: 2px solid var(--ink);
      border-radius: 0;
      background: var(--ink);
      box-shadow: 10px 10px 0 rgba(240, 74, 36, 0.2);
      color: #f4f0e2;
      font-family: var(--mono);
      font-size: clamp(0.72rem, 1vw, 0.88rem);
    }

    .content-body :global(pre)::before {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      padding: 0.45rem 0.8rem;
      border-bottom: 1px solid rgba(244, 240, 226, 0.35);
      color: var(--signal);
      content: "FIELD TERMINAL / READ ONLY";
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .content-body :global(pre code) {
      background: transparent;
      color: inherit;
    }

    .content-body :global(img) {
      display: block;
      max-width: 100%;
      margin: 2rem 0 3.5rem;
      border: 2px solid var(--ink);
      border-radius: 0;
      box-shadow: 12px 12px 0 var(--paper-deep);
    }

    .content-body :global(blockquote) {
      margin: 2rem 0;
      padding: 1.2rem 1.5rem;
      border: 0;
      border-left: 8px solid var(--signal);
      background: var(--paper-deep);
      color: var(--ink);
      font-style: normal;
    }

    .content-body :global(kbd) {
      border: 1px solid var(--ink);
      border-radius: 0;
      background: var(--paper);
      box-shadow: 2px 2px 0 var(--ink);
      color: var(--ink);
    }

    .site-footer {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2rem;
      align-items: end;
      margin: 0;
      padding: 2.5rem 4vw;
      border-top: 2px solid var(--ink);
      background: var(--signal);
      color: #fffaf0;
      text-align: left;
    }

    .site-footer p {
      max-width: 16ch;
      margin: 0;
      font-size: clamp(1.4rem, 3vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .footer-tags {
      justify-content: flex-end;
      margin: 0;
    }

    .footer-tag {
      border: 1px solid #fffaf0;
      border-radius: 0;
      background: transparent;
      color: #fffaf0;
      font-family: var(--mono);
    }

    @keyframes radar-sweep {
      to { transform: rotate(360deg); }
    }

    @keyframes status-pulse {
      50% { background: var(--paper); }
    }

    @media (max-width: 1050px) {
      .command-hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .briefing {
        min-height: 560px;
      }

      .briefing h1 {
        max-width: 12ch;
      }

      .command-center {
        min-height: 660px;
      }
    }

    @media (max-width: 720px) {
      .ops-nav {
        grid-template-columns: 1fr auto;
        padding: 0 1rem;
      }

      .ops-nav__center {
        display: none;
      }

      .command-hero {
        gap: 1.25rem;
        padding: 1.6rem 1rem 2.5rem;
      }

      .briefing {
        min-height: 500px;
      }

      .briefing__code {
        margin-bottom: 2rem;
      }

      .briefing h1 {
        font-size: clamp(3.1rem, 17vw, 5.4rem);
      }

      .briefing__lead {
        font-size: 0.92rem;
      }

      .command-center {
        min-height: 0;
        box-shadow: 7px 7px 0 rgba(21, 23, 19, 0.12);
      }

      .zone-switcher {
        grid-template-columns: repeat(5, minmax(76px, 1fr));
        overflow-x: auto;
      }

      .zone-button {
        min-width: 76px;
      }

      .command-grid {
        grid-template-columns: 1fr;
      }

      .radar-panel {
        min-height: 430px;
        border-right: 0;
        border-bottom: 2px solid var(--ink);
      }

      .queue-panel {
        min-height: 390px;
      }

      .mission-queue {
        max-height: 310px;
      }

      .archive-masthead {
        grid-template-columns: 1fr;
        padding-right: 1rem;
        padding-left: 1rem;
      }

      .archive-masthead h2 {
        max-width: none;
      }

      .content-body {
        width: calc(100% - 2rem);
      }

      .content-body :global(h1) {
        grid-template-columns: 1fr;
      }

      .content-body :global(pre) {
        margin-right: -0.5rem;
        margin-left: -0.5rem;
        box-shadow: 5px 5px 0 rgba(240, 74, 36, 0.2);
      }

      .site-footer {
        grid-template-columns: 1fr;
        padding: 2rem 1rem;
      }

      .footer-tags {
        justify-content: flex-start;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }

      .radar-sweep {
        transform: rotate(35deg);
      }
    }
  </style>
</head>
<body>
  <nav class="ops-nav" aria-label="页面导航">
    <a class="ops-brand" href="/blog/"><span>DLUT</span> / FIELD ARCHIVE</a>
    <span class="ops-nav__center">2025 Science &amp; Technology Festival</span>
    <span class="ops-status">Command online</span>
  </nav>

  <header class="command-hero">
    <section class="briefing" aria-labelledby="page-title">
      <p class="briefing__code">
        <strong>After action</strong>
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>
      </p>
      <h1 id="page-title">第一次出征<span>CTF.</span></h1>
      <p class="briefing__lead">
        大连理工大学 2025 科技文化节个人 WriteUp。选择战区，实时接管雷达、任务队列与下方完整作战记录。
      </p>
      <div class="briefing__meta" aria-label="战报统计">
        <div class="briefing__metric"><b>19</b><span>missions</span></div>
        <div class="briefing__metric"><b>05</b><span>theaters</span></div>
        <div class="briefing__metric"><b>01</b><span>first sortie</span></div>
      </div>
    </section>

    <section class="command-center" aria-label="CTF 作战指挥中心">
      <div class="zone-switcher" role="tablist" aria-label="选择战区">
        {challengeCategories.filter((cat) => cat.id !== 'all').map((cat, index) => (
          <button
            class="zone-button"
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-zone={cat.id}
          >
            {cat.label}
            <small>{String(cat.count).padStart(2, '0')} targets</small>
          </button>
        ))}
      </div>

      <div class="command-grid">
        <div class="radar-panel" aria-label="战区威胁拓扑">
          <div class="radar-axis radar-axis--x"></div>
          <div class="radar-axis radar-axis--y"></div>
          <div class="radar-sweep"></div>
          <div class="radar-core"><span>DLUT<br />OPS</span></div>
          <div class="radar-readout">
            <b data-zone-title>Reverse</b>
            <span data-zone-method>static analysis / deobfuscation</span>
          </div>
          <div class="radar-telemetry">
            SIGNAL <strong data-signal>78%</strong><br />
            TRACE <span data-trace>0x41F2</span><br />
            STATUS <span data-status>SCANNING</span>
          </div>
          <div class="target-layer" aria-label="当前战区目标"></div>
        </div>

        <aside class="queue-panel" aria-label="任务队列">
          <div class="queue-header">
            <span>Mission queue</span>
            <span data-queue-count>05 / 19</span>
          </div>
          <div class="mission-queue"></div>
          <div class="queue-footer">
            <button class="focus-button" type="button">打开当前战区记录</button>
          </div>
        </aside>
      </div>
    </section>
  </header>

  <section class="archive" aria-labelledby="archive-title">
    <div class="archive-masthead">
      <h2 id="archive-title">完整作战档案</h2>
      <div class="archive-masthead__copy">
        <p>{description}。以下保留比赛中的原始判断、截图、代码、答案与赛后复盘。</p>
        <div>
          {categories.map((cat: string) => <span>{cat}</span>)}
          {tags.map((tag: string) => <span>{tag}</span>)}
        </div>
      </div>
    </div>
    <main class="content-body">
      <Content />
    </main>
  </section>

  <footer class="site-footer">
    <p>{title}</p>
    <div class="footer-tags">
      {categories.map((cat: string) => <span class="footer-tag">{cat}</span>)}
      {tags.map((tag: string) => <span class="footer-tag">{tag}</span>)}
    </div>
  </footer>

  <OriginalArticle blog={blog} />

  <script>
    // @ts-nocheck
    const theaterData = {
      reverse: {
        label: 'Reverse',
        method: 'static analysis / deobfuscation',
        tasks: ['signin', 'weather?', 'tulip', 'MAZE', 'WoAiShiinaMahiru']
      },
      misc: {
        label: 'Misc',
        method: 'osint / privilege / signal',
        tasks: ['Signin', '特定低手', 'Terminal', '我是少女乐队高手']
      },
      pwn: {
        label: 'Pwn',
        method: 'overflow / kernel triage',
        tasks: ['minesweeper', 'kernel_master']
      },
      web: {
        label: 'Web',
        method: 'logic / remote load / xxe',
        tasks: ['Real_E2_J5!', 'Editor', 'Real_upload?']
      },
      crypto: {
        label: 'Crypto',
        method: 'rsa / signature / lattice',
        tasks: ['Signin', 'Whereisp&q', 'stream&block', 'signature2', 'signature1', 'MetamikuMatrixMaster', 'Xxxxxxxor']
      }
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const zoneButtons = [...document.querySelectorAll('.zone-button')];
    const targetLayer = document.querySelector('.target-layer');
    const queue = document.querySelector('.mission-queue');
    const zoneTitle = document.querySelector('[data-zone-title]');
    const zoneMethod = document.querySelector('[data-zone-method]');
    const queueCount = document.querySelector('[data-queue-count]');
    const signal = document.querySelector('[data-signal]');
    const trace = document.querySelector('[data-trace]');
    const status = document.querySelector('[data-status]');
    const focusButton = document.querySelector('.focus-button');
    const contentHeadings = [...document.querySelectorAll('.content-body h1, .content-body h2')];
    let activeZone = 'reverse';
    let activeTask = 0;
    let telemetryStep = 0;

    const normalize = (value) => value.trim().toLowerCase();
    const slugify = (value) => normalize(value)
      .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-')
      .replace(/^-|-$/g, '');

    let currentZone = '';
    contentHeadings.forEach((heading) => {
      if (heading.tagName === 'H1') {
        currentZone = normalize(heading.textContent || '');
        heading.id = `theater-${currentZone}`;
      } else {
        heading.dataset.theater = currentZone;
        heading.id = `mission-${currentZone}-${slugify(heading.textContent || '')}`;
      }
    });

    const findTheaterHeading = (zone) =>
      contentHeadings.find((heading) =>
        heading.tagName === 'H1' && normalize(heading.textContent || '') === zone
      );

    const findMissionHeading = (zone, task) =>
      contentHeadings.find((heading) =>
        heading.tagName === 'H2' &&
        heading.dataset.theater === zone &&
        normalize(heading.textContent || '') === normalize(task)
      );

    const focusMission = (index) => {
      const data = theaterData[activeZone];
      activeTask = Math.min(index, data.tasks.length - 1);
      const heading = findMissionHeading(activeZone, data.tasks[activeTask]);
      document.querySelectorAll('.mission-item, .target-node').forEach((item, itemIndex) => {
        item.classList.toggle('is-active', itemIndex % data.tasks.length === activeTask);
      });
      if (heading) {
        heading.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
      }
    };

    const renderTheater = (zone) => {
      const data = theaterData[zone];
      activeZone = zone;
      activeTask = 0;
      zoneTitle.textContent = data.label;
      zoneMethod.textContent = data.method;
      queueCount.textContent = `${String(data.tasks.length).padStart(2, '0')} / 19`;
      status.textContent = 'RECALIBRATING';
      signal.textContent = `${64 + data.tasks.length * 4}%`;

      zoneButtons.forEach((button) => {
        button.setAttribute('aria-selected', String(button.dataset.zone === zone));
      });

      targetLayer.replaceChildren();
      queue.replaceChildren();

      data.tasks.forEach((task, index) => {
        const target = document.createElement('button');
        target.type = 'button';
        target.className = `target-node${index === 0 ? ' is-active' : ''}`;
        target.setAttribute('aria-label', task);
        target.addEventListener('click', () => focusMission(index));
        targetLayer.append(target);

        const item = document.createElement('button');
        item.type = 'button';
        item.className = `mission-item${index === 0 ? ' is-active' : ''}`;
        item.innerHTML = `
          <span class="mission-index">${String(index + 1).padStart(2, '0')}</span>
          <span class="mission-name">${task}</span>
          <span class="mission-state" data-state="${index === 0 ? 'trace' : 'logged'}">${index === 0 ? 'trace' : 'logged'}</span>
        `;
        item.addEventListener('click', () => focusMission(index));
        queue.append(item);
      });

      window.setTimeout(() => {
        status.textContent = 'SCANNING';
      }, reducedMotion ? 0 : 360);
    };

    zoneButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const zone = button.dataset.zone;
        if (zone && theaterData[zone]) renderTheater(zone);
      });
    });

    focusButton.addEventListener('click', () => {
      const heading = findTheaterHeading(activeZone);
      if (heading) heading.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
    });

    renderTheater(activeZone);

    if (!reducedMotion) {
      window.setInterval(() => {
        telemetryStep += 1;
        const data = theaterData[activeZone];
        const taskIndex = telemetryStep % data.tasks.length;
        const encoded = (0x41f2 + telemetryStep * 0x19 + activeZone.length * 0x2f)
          .toString(16)
          .toUpperCase();
        trace.textContent = `0x${encoded}`;
        signal.textContent = `${70 + ((telemetryStep * 7 + data.tasks.length) % 27)}%`;
        document.querySelectorAll('.target-node').forEach((node, index) => {
          node.classList.toggle('is-active', index === taskIndex);
        });
      }, 1800);
    }
  </script>
</body>
</html>

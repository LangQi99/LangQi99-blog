  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-surface]')];
      const evidence = document.querySelector('#surfaceEvidence');
      const finding = document.querySelector('#surfaceFinding');
      const kind = document.querySelector('#surfaceKind');
      const address = document.querySelector('#webAddress');
      const hotspot = document.querySelector('#surfaceHotspot');
      if (!evidence || !finding || !kind || !address || !hotspot) return;
      const surfaces = {
        source: { kind: 'VIEW-SOURCE', address: 'view-source:https://target.local/', label: 'HTML COMMENT', evidence: '&lt;!-- release note\\n<strong>flag{comment_is_content}</strong>\\n--&gt;\\n&lt;script src=\"guard.js\"&gt;', finding: '注释仍会发送到浏览器。前端拦截也可以通过查看源码或禁用 JavaScript 绕过。' },
        header: { kind: 'HTTP RESPONSE', address: 'https://target.local/', label: 'FLAG HEADER', evidence: 'HTTP/1.1 200 OK\\nServer: nginx/1.20.1\\n<strong>Flag: flag{inspect_the_wire}</strong>\\nX-Powered-By: PHP/7.3.11', finding: '页面正文不是完整响应。抓包后，Flag 可以直接出现在响应头。' },
        path: { kind: 'PATH DISCOVERY', address: 'https://target.local/robots.txt', label: 'DISALLOWED PATH', evidence: 'User-agent: *\\n<strong>Disallow: /flagishere.txt</strong>\\n\\nGET /flagishere.txt', finding: 'robots.txt 不是访问控制，它只是给爬虫的提示，敏感路径反而因此暴露。' },
        archive: { kind: 'DEPLOYMENT DEBRIS', address: 'https://target.local/www.zip', label: 'BACKUP FOUND', evidence: '200 /www.zip\\n200 /.git/HEAD\\n200 /.svn/entries\\n<strong>200 /index.php.swp</strong>', finding: '备份包、版本库元数据与 Vim 交换文件都可能泄露源码或历史版本。' },
        state: { kind: 'CLIENT STATE', address: 'https://target.local/admin', label: 'COOKIE / TXT', evidence: 'Cookie: session=guest; <strong>flag=flag{state_leak}</strong>\\nTXT target.local \"staging-admin\"\\nDocument: onboarding.pdf', finding: 'Cookie、DNS TXT、文档与页面底部信息可组合为后台地址和凭据。' },
        editor: { kind: 'EXPOSED TOOL', address: 'https://target.local/editor', label: 'FILE BROWSER', evidence: '/editor\\n├── /etc/passwd\\n├── /var/www/html/index.php\\n└── <strong>/flag</strong>', finding: '公开的在线编辑器可能拥有服务器文件读取能力，风险远高于普通信息泄露。' }
      };
      const render = (name) => {
        const item = surfaces[name];
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.surface === name)));
        evidence.innerHTML = item.evidence;
        finding.textContent = item.finding;
        kind.textContent = item.kind;
        address.textContent = item.address;
        hotspot.dataset.position = name;
        hotspot.textContent = item.label;
      };
      buttons.forEach((button) => button.addEventListener('click', () => render(button.dataset.surface)));
      render('source');
    })();
  </script>

---
import type { CollectionEntry } from "astro:content";
import OriginalArticle from "../../components/article/OriginalArticle.astro";

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const title = blog.data.title;
const description = blog.data.description;
const pubDate = blog.data.pubDate;
const categories = blog.data.categories ?? [];
const tags = blog.data.tags ?? [];

const httpHeaders = `<span class="h-key">HTTP/1.1</span> <span class="h-val">200 OK</span>
<span class="h-key">Server:</span> nginx/1.20.1
<span class="h-key">Content-Type:</span> text/html; charset=UTF-8
<span class="h-key">Flag:</span> <span class="h-flag">flag{xxx}</span>
<span class="h-key">X-Powered-By:</span> PHP/7.3.11`;

const robotsTxt = `<span class="h-key">User-agent:</span> *
<span class="h-key">Disallow:</span> <span class="h-val">/flagishere.txt</span>`;

const phpSource = `<span class="h-key">&lt;?php</span>

<span class="h-comment">/*
# @Author: xxx
# @Date:   xxx
# @email: xxx@xxx.com
*/</span>

<span class="h-comment">//flag{xxx}</span>
<span class="h-fn">echo</span> <span class="h-str">"where is flag ?"</span>`;

const robotsFormat = `<span class="h-key">User-agent:</span> [crawler name]
<span class="h-key">Disallow:</span> [blocked path]
<span class="h-key">Allow:</span> [allowed path]`;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="LangQi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <style is:inline>
    :root {
      --c-bg: #09090b;
      --c-surface: #111113;
      --c-surface-raised: #18181b;
      --c-border: #27272a;
      --c-border-accent: #10B98133;
      --c-text: #e4e4e7;
      --c-text-muted: #71717a;
      --c-text-dim: #3f3f46;
      --c-accent: #10B981;
      --c-accent-dim: #059669;
      --c-accent-glow: #10B98118;
      --c-danger: #ef4444;
      --c-warn: #f59e0b;
      --font-body: 'Space Grotesk', 'Noto Sans SC', sans-serif;
      --font-mono: 'Space Grotesk', monospace;
      --radius: 0px;
    }

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    body {
      font-family: var(--font-body);
      background: var(--c-bg);
      color: var(--c-text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a {
      color: var(--c-accent);
      text-decoration: none;
      transition: opacity 0.2s;
    }
    a:hover { opacity: 0.8; }

    /* Navigation */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--c-bg);
      border-bottom: 1px solid var(--c-border);
      backdrop-filter: blur(12px);
      background: rgba(9, 9, 11, 0.9);
    }
    .nav-back {
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .nav-meta {
      font-size: 0.75rem;
      color: var(--c-text-muted);
      display: flex;
      gap: 1rem;
      align-items: center;
    }
    .nav-tag {
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      font-size: 0.625rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--c-text-muted);
    }

    /* Hero */
    .hero {
      padding: 8rem 2rem 4rem;
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: 6rem;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, var(--c-accent-glow) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .hero-label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--c-accent);
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
    }
    .hero-title {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
    }
    .hero-title span {
      background: linear-gradient(135deg, var(--c-accent), #34d399);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-desc {
      font-size: 1.125rem;
      color: var(--c-text-muted);
      max-width: 600px;
      line-height: 1.7;
      position: relative;
      z-index: 1;
    }
    .hero-stats {
      margin-top: 3rem;
      display: flex;
      gap: 3rem;
      position: relative;
      z-index: 1;
    }
    .hero-stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .hero-stat-value {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--c-text);
    }
    .hero-stat-label {
      font-size: 0.75rem;
      color: var(--c-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* Catalog Grid */
    .catalog {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    .catalog-section {
      margin-bottom: 1.5rem;
    }
    .catalog-section-header {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-text-dim);
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--c-border);
      margin-bottom: 1.5rem;
    }

    /* Grid layouts */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--c-border);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1px;
      background: var(--c-border);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .grid-wide {
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .grid-asymmetric {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1px;
      background: var(--c-border);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .grid-asymmetric-reverse {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 1px;
      background: var(--c-border);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    /* Card */
    .card {
      background: var(--c-surface);
      padding: 2rem;
      position: relative;
      overflow: hidden;
    }
    .card-compact {
      padding: 1.5rem;
    }
    .card-number {
      font-size: 0.625rem;
      font-weight: 600;
      color: var(--c-accent);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .card-number::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--c-border);
    }
    .card-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }
    .card-body {
      font-size: 0.875rem;
      color: var(--c-text-muted);
      line-height: 1.7;
    }
    .card-body p + p {
      margin-top: 0.75rem;
    }
    .card-technique {
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      background: var(--c-bg);
      border-left: 2px solid var(--c-accent);
      font-size: 0.8125rem;
      color: var(--c-text);
      font-weight: 500;
    }
    .card-tag {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.25rem 0.625rem;
      border: 1px solid var(--c-border);
      font-size: 0.6875rem;
      color: var(--c-text-dim);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .card-tag-accent {
      border-color: var(--c-accent-dim);
      color: var(--c-accent);
    }

    /* Code blocks */
    .code-block {
      margin-top: 1rem;
      background: var(--c-bg);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .code-header {
      padding: 0.5rem 1rem;
      border-bottom: 1px solid var(--c-border);
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--c-text-dim);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .code-header-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--c-accent);
    }
    .code-content {
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      line-height: 1.7;
      overflow-x: auto;
      white-space: pre;
      color: var(--c-text-muted);
    }
    .code-content .h-key { color: #a78bfa; }
    .code-content .h-val { color: var(--c-accent); }
    .code-content .h-flag { color: #fbbf24; font-weight: 600; }
    .code-content .h-comment { color: var(--c-text-dim); font-style: italic; }
    .code-content .h-fn { color: #60a5fa; }
    .code-content .h-str { color: var(--c-accent); }

    /* Full-width detail card */
    .detail-card {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 2.5rem;
      margin-bottom: 1.5rem;
    }
    .detail-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.5rem;
    }
    .detail-card-title {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .detail-card-badge {
      padding: 0.25rem 0.75rem;
      background: var(--c-accent-glow);
      border: 1px solid var(--c-accent-dim);
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--c-accent);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .detail-card-body {
      font-size: 0.9375rem;
      color: var(--c-text-muted);
      line-height: 1.8;
      max-width: 700px;
    }
    .detail-card-body strong {
      color: var(--c-text);
      font-weight: 600;
    }

    /* Comparison list */
    .compare-list {
      margin-top: 1.5rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .compare-item {
      padding: 1rem;
      background: var(--c-bg);
      border: 1px solid var(--c-border);
    }
    .compare-item-label {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--c-text-dim);
      margin-bottom: 0.5rem;
    }
    .compare-item-value {
      font-size: 0.875rem;
      color: var(--c-text);
      font-weight: 500;
    }

    /* Footer */
    .footer {
      max-width: 1200px;
      margin: 4rem auto 0;
      padding: 3rem 2rem;
      border-top: 1px solid var(--c-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8125rem;
      color: var(--c-text-dim);
    }
    .footer-tags {
      display: flex;
      gap: 0.5rem;
    }

    /* Reveal animation */
    .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav { padding: 0.75rem 1rem; }
      .nav-meta { display: none; }
      .hero { padding: 6rem 1.5rem 3rem; }
      .hero-stats { gap: 2rem; flex-wrap: wrap; }
      .catalog { padding: 1.5rem; }
      .grid-2 { grid-template-columns: 1fr; }
      .grid-3 { grid-template-columns: 1fr; }
      .grid-asymmetric { grid-template-columns: 1fr; }
      .grid-asymmetric-reverse { grid-template-columns: 1fr; }
      .card { padding: 1.5rem; }
      .detail-card { padding: 1.5rem; }
      .detail-card-header { flex-direction: column; gap: 0.75rem; }
      .compare-list { grid-template-columns: 1fr; }
      .footer { flex-direction: column; gap: 1rem; text-align: center; }
    }
    @media (max-width: 480px) {
      .hero-title { font-size: 2rem; }
      .hero-stats { flex-direction: column; gap: 1rem; }
    }
  </style>
</head>
<body>
  <style is:inline>
    body > :not(.web-lab-site):not(script):not(style) { display: none !important; }
    .web-lab-site {
      --ink: #142234;
      --paper: #eaf2f7;
      --chrome: #d7e2e9;
      --acid: #f0ff4a;
      --red: #ff554f;
      --blue: #3464ff;
      min-height: 100dvh; background: var(--paper); color: var(--ink);
      font-family: "Space Grotesk", "Noto Sans SC", sans-serif;
      line-height: 1.5;
    }
    .web-lab-site * { box-sizing: border-box; }
    .web-lab-nav {
      height: 68px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(18px, 4vw, 64px); border-bottom: 1px solid var(--ink);
      background: rgba(234,242,247,.94);
    }
    .web-lab-nav a { color: inherit; text-decoration: none; font-weight: 800; }
    .lab-mark { display: flex; align-items: center; gap: 10px; }
    .lab-mark i {
      width: 22px; height: 16px; display: block;
      background: linear-gradient(90deg, var(--red) 0 32%, transparent 32% 37%, var(--blue) 37% 69%, transparent 69% 74%, var(--acid) 74%);
      border: 1px solid var(--ink);
    }
    .web-lab-nav span:last-child { font: 750 11px/1 monospace; letter-spacing: .1em; text-transform: uppercase; }
    .web-lab-hero {
      min-height: calc(100dvh - 68px);
      display: grid; grid-template-columns: minmax(330px,.68fr) minmax(650px,1.32fr);
      align-items: center; gap: clamp(36px,5vw,80px); padding: clamp(42px,6vh,68px) clamp(18px,4vw,64px);
    }
    .web-lab-copy h1 {
      margin: 0 0 24px; max-width: 680px;
      font-size: clamp(3.4rem,6.3vw,7.5rem); line-height: .87; letter-spacing: -.075em;
    }
    .web-lab-copy h1 span { color: var(--blue); display: block; }
    .web-lab-copy p { max-width: 500px; font-size: clamp(1rem,1.35vw,1.3rem); color: rgba(20,34,52,.72); margin: 0 0 28px; }
    .web-lab-copy a {
      display: inline-flex; background: var(--ink); color: white; text-decoration: none; padding: 13px 18px;
      font-weight: 800; box-shadow: 7px 7px 0 var(--acid);
    }
    .browser-lab {
      min-height: 620px; border: 2px solid var(--ink); background: white;
      box-shadow: 20px 20px 0 var(--ink); display: grid; grid-template-rows: auto auto 1fr;
      overflow: hidden;
    }
    .browser-top {
      height: 46px; background: var(--chrome); border-bottom: 1px solid var(--ink);
      display: flex; align-items: center; gap: 8px; padding: 0 14px;
    }
    .browser-top i { width: 11px; height: 11px; border: 1px solid var(--ink); border-radius: 50%; background: var(--red); }
    .browser-top i:nth-child(2) { background: var(--acid); }
    .browser-top i:nth-child(3) { background: #65dc91; }
    .address-bar { margin-left: 10px; border: 1px solid var(--ink); background: white; padding: 7px 12px; flex: 1; font: 650 11px/1 monospace; }
    .attack-tabs {
      display: grid; grid-template-columns: repeat(6, 1fr); border-bottom: 1px solid var(--ink);
      background: #f3f6f8;
    }
    .attack-tabs button {
      min-width: 0; border: 0; border-right: 1px solid var(--ink); background: transparent; color: inherit;
      padding: 12px 7px; font: 750 10px/1.2 monospace; cursor: pointer; text-transform: uppercase;
    }
    .attack-tabs button:last-child { border-right: 0; }
    .attack-tabs button[aria-pressed="true"] { background: var(--acid); }
    .desktop {
      display: grid; grid-template-columns: 1.18fr .82fr; min-height: 520px; overflow: hidden;
    }
    .target-view { padding: 20px; border-right: 1px solid var(--ink); background: #fbfcfd; position: relative; overflow: hidden; }
    .target-site {
      height: 100%; border: 1px solid var(--ink); background: white; padding: 24px;
      position: relative; overflow: hidden;
    }
    .target-site h2 { font-size: clamp(2rem,3vw,3.8rem); line-height: .95; margin: 0 0 16px; letter-spacing: -.055em; }
    .fake-line { height: 8px; background: #dfe5e9; margin: 10px 0; }
    .fake-line.short { width: 60%; }
    .surface-hotspot {
      position: absolute; border: 2px solid var(--red); background: rgba(255,85,79,.08);
      display: grid; place-items: center; padding: 10px; font: 800 11px/1.2 monospace; text-transform: uppercase;
      transition: inset .35s cubic-bezier(.16,1,.3,1), width .35s ease, height .35s ease;
    }
    .surface-hotspot::before {
      content: ""; position: absolute; inset: -8px; border: 1px dashed var(--red); opacity: .5;
    }
    .surface-hotspot[data-position="source"] { right: 18px; bottom: 18px; width: 200px; height: 86px; }
    .surface-hotspot[data-position="header"] { left: 18px; top: 18px; right: 18px; width: auto; height: 56px; }
    .surface-hotspot[data-position="path"] { left: 24%; top: 38%; width: 52%; height: 90px; }
    .surface-hotspot[data-position="archive"] { left: 18px; bottom: 18px; width: 180px; height: 110px; }
    .surface-hotspot[data-position="state"] { right: 18px; top: 28%; width: 180px; height: 120px; }
    .surface-hotspot[data-position="editor"] { inset: 16% 12% 14%; width: auto; height: auto; }
    .forensics {
      background: #142234; color: #d8e4ef; display: grid; grid-template-rows: auto 1fr auto;
      min-width: 0;
    }
    .forensics-head {
      padding: 15px 18px; border-bottom: 1px solid rgba(255,255,255,.2);
      display: flex; justify-content: space-between; font: 700 10px/1 monospace; text-transform: uppercase; letter-spacing: .1em;
    }
    .evidence {
      padding: 22px; overflow: auto; font: 500 12px/1.7 monospace;
      white-space: pre-wrap; color: #d7e7f5;
    }
    .evidence strong { color: var(--acid); }
    .finding {
      padding: 16px 18px; border-top: 1px solid rgba(255,255,255,.2); background: var(--blue);
      font-size: 13px; color: white;
    }
    .finding b { display: block; font: 800 10px/1 monospace; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 7px; color: var(--acid); }
    .case-atlas { padding: 120px clamp(18px,7vw,110px); background: #fff; }
    .case-atlas h2 { max-width: 860px; margin: 0 0 70px; font-size: clamp(2.8rem,5vw,6rem); line-height: .95; letter-spacing: -.065em; }
    .surface-map {
      display: grid; grid-template-columns: repeat(12,1fr); grid-auto-rows: 112px;
      border: 1px solid var(--ink); background: var(--ink); gap: 1px;
    }
    .surface-group { background: var(--paper); padding: 24px; display: flex; flex-direction: column; justify-content: space-between; }
    .surface-group h3 { font-size: clamp(1.6rem,2.8vw,3.2rem); line-height: 1; margin: 0; letter-spacing: -.045em; }
    .surface-group p { margin: 0; max-width: 48ch; color: rgba(20,34,52,.7); }
    .surface-group code { font: 700 11px/1.4 monospace; color: var(--blue); }
    .surface-group.a { grid-column: span 7; grid-row: span 3; background: var(--acid); }
    .surface-group.b { grid-column: span 5; grid-row: span 2; }
    .surface-group.c { grid-column: span 5; grid-row: span 3; background: #dce6ff; }
    .surface-group.d { grid-column: span 7; grid-row: span 2; background: #ffd9d5; }
    .web-lab-footer { margin-top: 70px; display: flex; justify-content: space-between; border-top: 1px solid var(--ink); padding-top: 24px; }
    @media (max-width: 1080px) {
      .web-lab-hero { grid-template-columns: 1fr; }
      .browser-lab { box-shadow: 10px 10px 0 var(--ink); }
    }
    @media (max-width: 760px) {
      .web-lab-nav span:last-child { display: none; }

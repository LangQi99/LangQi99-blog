  <script is:inline>
    (() => {
      const pane = document.querySelector('#disassemblyPane');
      const lens = document.querySelector('#scanLens');
      const range = document.querySelector('#scanRange');
      const output = document.querySelector('#scanOutput');
      const phase = document.querySelector('#scanPhase');
      const address = document.querySelector('#scanAddress');
      const status = document.querySelector('#decodeStatus');
      const blocks = [...document.querySelectorAll('[data-memory-block]')];
      if (!pane || !lens || !range || !output || !phase || !address || !status) return;
      const states = [
        { name: 'INPUT', address: '0x1400010E0', text: '读取十进制数，准备按 26 进制拆分。', top: 16 },
        { name: 'BASE 26', address: '0x140001102', text: '除以 26 并以余数索引 string_len26。', top: 33 },
        { name: 'LINKED LIST', address: '0x140001129', text: '字符 XOR 7 后写入 16 字节链表节点。', top: 54 },
        { name: 'VERIFY', address: '0x140001220', text: '逐字节比较 14 个目标字符，命中后进入 success。', top: 72 }
      ];
      const render = (index) => {
        const item = states[index];
        range.value = String(index);
        output.value = item.name;
        output.textContent = item.name;
        phase.textContent = item.name;
        address.textContent = item.address;
        status.innerHTML = `<strong>${item.name}</strong> ${item.text}`;
        lens.style.top = `${item.top}%`;
        blocks.forEach((block, blockIndex) => block.classList.toggle('active', blockIndex === index));
      };
      range.addEventListener('input', () => render(Number(range.value)));
      let dragging = false;
      const move = (clientY) => {
        const rect = pane.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (clientY - rect.top) / rect.height));
        render(Math.min(3, Math.floor(ratio * 4)));
      };
      lens.addEventListener('pointerdown', (event) => { dragging = true; lens.setPointerCapture(event.pointerId); move(event.clientY); });
      lens.addEventListener('pointermove', (event) => { if (dragging) move(event.clientY); });
      lens.addEventListener('pointerup', () => { dragging = false; });
      lens.addEventListener('pointercancel', () => { dragging = false; });
      render(0);
    })();
  </script>

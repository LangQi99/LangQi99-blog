---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="LangQi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <style is:inline>
    :root {
      --bg: #0d0d0d;
      --surface: #141414;
      --surface-2: #1a1a1a;
      --border: #2a2a2a;
      --text: #e0e0e0;
      --text-muted: #888888;
      --text-dim: #555555;
      --accent: #EF4444;
      --accent-dim: #dc2626;
      --accent-glow: rgba(239, 68, 68, 0.15);
      --green: #4ade80;
      --yellow: #facc15;
      --blue: #60a5fa;
      --font: 'IBM Plex Mono', monospace;
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 15px;
      scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .reveal { opacity: 1 !important; transform: none !important; }
      .hex-grid { animation: none !important; }
      .cursor-blink { animation: none !important; }
      .addr-pulse { animation: none !important; }
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100dvh;
      -webkit-font-smoothing: antialiased;
      position: relative;
      overflow-x: hidden;
    }

    /* Hex grid background */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(239, 68, 68, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(239, 68, 68, 0.03) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 300px;
      background: radial-gradient(ellipse at 50% 0%, var(--accent-glow), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* Layout */
    .page { position: relative; z-index: 1; }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(13, 13, 13, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }

    .nav-back {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s;
    }
    .nav-back:hover { color: var(--accent); }

    .nav-meta {
      font-size: 0.7rem;
      color: var(--text-dim);
      display: flex;
      gap: 16px;
    }

    .nav-addr {
      color: var(--accent);
      opacity: 0.6;
    }

    /* Header */
    .header {
      padding: 100px 24px 48px;
      max-width: 900px;
      margin: 0 auto;
    }

    .header-offset {
      font-size: 0.7rem;
      color: var(--text-dim);
      margin-bottom: 8px;
      letter-spacing: 0.05em;
    }

    .header-title {
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    .header-title .accent { color: var(--accent); }

    .header-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .header-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tag {
      font-size: 0.65rem;
      padding: 2px 8px;
      border: 1px solid var(--border);
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .tag-accent {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Content sections */
    .content {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    .section {
      margin-bottom: 48px;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .section-label {
      font-size: 0.65rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-label::before {
      content: '';
      width: 8px;
      height: 1px;
      background: var(--accent);
    }

    .analysis-text {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 16px;
      max-width: 65ch;
      line-height: 1.8;
    }

    .analysis-text code {
      background: var(--surface-2);
      padding: 1px 6px;
      border: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--accent);
    }

    .analysis-text a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid var(--accent-dim);
    }
    .analysis-text a:hover {
      border-bottom-color: var(--accent);
    }

    /* Code blocks - disassembly viewer style */
    .code-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      margin-bottom: 24px;
      overflow: hidden;
    }

    .code-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 12px;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
      font-size: 0.65rem;
    }

    .code-toolbar-title {
      color: var(--text-muted);
    }

    .code-toolbar-addr {
      color: var(--text-dim);
    }

    .code-body {
      padding: 16px;
      overflow-x: auto;
      font-size: 0.8rem;
      line-height: 1.7;
      white-space: pre;
    }

    .code-body .ln {
      color: var(--text-dim);
      user-select: none;
      display: inline-block;
      width: 2.5ch;
      text-align: right;
      margin-right: 16px;
    }
    .code-body .kw { color: var(--accent); }
    .code-body .fn { color: #93c5fd; }
    .code-body .type { color: #a78bfa; }
    .code-body .str { color: var(--green); }
    .code-body .num { color: var(--yellow); }
    .code-body .cmt { color: var(--text-dim); font-style: italic; }
    .code-body .hl { color: var(--accent); font-weight: 600; }

    /* Insight box */
    .insight {
      border-left: 2px solid var(--accent);
      padding: 12px 16px;
      background: var(--accent-glow);
      margin-bottom: 24px;
      font-size: 0.8rem;
      color: var(--text);
    }

    .insight-label {
      font-size: 0.6rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 4px;
    }

    /* Math formula */
    .formula {
      text-align: center;
      padding: 20px;
      margin: 16px 0;
      background: var(--surface);
      border: 1px solid var(--border);
      font-size: 1rem;
      color: var(--text);
      letter-spacing: 0.02em;
    }

    .formula .var { color: var(--blue); font-style: italic; }
    .formula .op { color: var(--text-muted); }

    /* Separator */
    .sep {
      height: 1px;
      background: var(--border);
      margin: 32px 0;
      position: relative;
    }
    .sep::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 40px;
      height: 1px;
      background: var(--accent);
    }

    /* Footer */
    .footer {
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 24px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.7rem;
      color: var(--text-dim);
    }

    .footer-tags {
      display: flex;
      gap: 6px;
    }

    /* Responsive */
    @media (max-width: 640px) {
      html { font-size: 14px; }
      .header { padding: 80px 16px 32px; }
      .content { padding: 0 16px 60px; }
      .code-body { font-size: 0.7rem; padding: 12px; }
      .nav-meta { display: none; }
      .footer { flex-direction: column; gap: 12px; align-items: flex-start; }
    }
  </style>
</head>
<body>
  <style is:inline>
    body > :not(.reverse-site):not(script):not(style) { display: none !important; }
    .reverse-site {
      --ink: #14171a;
      --paper: #e7e8e4;
      --orange: #ff6b35;
      --cyan: #76e6e0;
      --line: rgba(20,23,26,.25);
      min-height: 100dvh;
      color: var(--ink);
      background: var(--paper);
      font-family: "IBM Plex Mono", monospace;
      line-height: 1.5;
    }
    .reverse-site * { box-sizing: border-box; }
    .reverse-nav {
      height: 66px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(16px,4vw,62px); border-bottom: 1px solid var(--ink);
    }
    .reverse-nav a { color: inherit; text-decoration: none; font-weight: 700; }
    .reverse-brand { display: flex; align-items: center; gap: 10px; }
    .reverse-brand i { width: 24px; height: 14px; display: block; border: 2px solid var(--ink); position: relative; }
    .reverse-brand i::after { content: ""; position: absolute; width: 5px; height: 5px; background: var(--orange); left: 7px; top: 2px; }
    .reverse-nav small { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
    .reverse-hero {
      min-height: calc(100dvh - 66px);
      display: grid; grid-template-columns: minmax(330px,.58fr) minmax(680px,1.42fr);
      align-items: center; gap: clamp(34px,5vw,76px);
      padding: clamp(38px,6vh,70px) clamp(16px,4vw,62px);
    }
    .reverse-copy h1 {
      margin: 0 0 24px; font-size: clamp(3.2rem,5.8vw,7rem); line-height: .88; letter-spacing: -.075em;
      font-family: "IBM Plex Mono", monospace;
    }
    .reverse-copy h1 span { color: var(--orange); display: block; }
    .reverse-copy p { max-width: 500px; margin: 0 0 28px; color: rgba(20,23,26,.7); font-size: clamp(.98rem,1.25vw,1.16rem); }
    .reverse-copy a {
      display: inline-flex; padding: 13px 17px; color: white; background: var(--ink);
      text-decoration: none; font-weight: 700; box-shadow: 7px 7px 0 var(--orange);
    }
    .scanner-workbench {
      min-height: 620px; border: 2px solid var(--ink); background: #f4f4f0; box-shadow: 20px 20px 0 var(--ink);
      display: grid; grid-template-rows: auto 1fr auto; overflow: hidden;
    }
    .scanner-top {
      height: 48px; padding: 0 15px; display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--ink); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    }
    .scanner-top span:last-child { color: var(--orange); }
    .scanner-main {
      min-height: 512px; display: grid; grid-template-columns: 1.08fr .92fr; overflow: hidden;
    }
    .disassembly {
      position: relative; border-right: 1px solid var(--ink); overflow: hidden; background: #f7f7f2;
      touch-action: none;
    }
    .asm-scroll { position: absolute; inset: 0; padding: 16px 12px; overflow: hidden; }
    .asm-line {
      display: grid; grid-template-columns: 68px 58px 1fr; gap: 8px; padding: 7px 8px;
      font-size: 11px; white-space: nowrap;
    }
    .asm-line b { color: #727874; font-weight: 400; }
    .asm-line em { color: var(--orange); font-style: normal; }
    .asm-line.branch { background: rgba(118,230,224,.2); }
    .scan-lens {
      position: absolute; left: 12%; top: 16%; width: 76%; height: 116px;
      border: 3px solid var(--orange); background: rgba(255,107,53,.08);
      cursor: grab; z-index: 5; box-shadow: inset 0 0 0 1px #fff;
    }
    .scan-lens:active { cursor: grabbing; }
    .scan-lens::before, .scan-lens::after {
      content: ""; position: absolute; background: var(--orange); pointer-events: none;
    }
    .scan-lens::before { left: 50%; top: -10px; bottom: -10px; width: 1px; }
    .scan-lens::after { top: 50%; left: -10px; right: -10px; height: 1px; }
    .scan-label {
      position: absolute; right: -3px; top: -26px; background: var(--orange); color: var(--ink);
      padding: 5px 8px; font-size: 9px; font-weight: 800;
    }
    .memory-map { padding: 18px; background: var(--ink); color: #dce2df; display: grid; grid-template-rows: auto 1fr auto; gap: 16px; min-width: 0; }
    .memory-title { display: flex; justify-content: space-between; font-size: 10px; text-transform: uppercase; letter-spacing: .1em; }
    .memory-title span:last-child { color: var(--cyan); }
    .memory-canvas { position: relative; border: 1px solid #57605b; overflow: hidden; min-height: 350px; }
    .memory-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(118,230,224,.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(118,230,224,.08) 1px, transparent 1px);
      background-size: 24px 24px;
    }

---
import type { CollectionEntry } from "astro:content";
import OriginalArticle from "../../components/article/OriginalArticle.astro";
import issuesListImg from "../../content/blog/image/github-issues-as-blog/issues-list.png";
interface Props { blog: CollectionEntry<"blog"> }
const { blog } = Astro.props;
const { title, description, image } = blog.data;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="issue-experience">
    <nav class="issue-nav">
      <a href="/blog/">LANGQI / DISTRIBUTION LAB</a>
      <span>ISSUE-DRIVEN PUBLISHING</span>
    </nav>
    <main>
      <section class="issue-hero">
        <div class="issue-copy">
          <p class="issue-kicker">One source. Two surfaces.</p>
          <h1>让 GitHub 替你的内容<br /><strong>负重前行。</strong></h1>
          <p>Issue 负责内容、SEO、评论与备份。你的独立站只负责建立品牌。</p>
          <button class="run-pipeline" type="button">发布这篇 Issue</button>
        </div>
        <div class="pipeline-machine" aria-label="从 GitHub Issue 到搜索引擎与独立站的交互流水线">
          <div class="machine-toolbar">
            <span>CONTENT PIPELINE</span>
            <output id="pipeline-status">READY FOR ISSUE</output>
          </div>
          <div class="pipeline-track">
            <div class="rail"></div>
            <article class="stage active" data-stage="0">
              <span class="stage-number">I</span>
              <div><b>GitHub Issue</b><small>Markdown + comments</small></div>
            </article>
            <article class="stage" data-stage="1">
              <span class="stage-number">II</span>
              <div><b>Build Fetch</b><small>REST API + frontmatter</small></div>
            </article>
            <article class="stage" data-stage="2">
              <span class="stage-number">III</span>
              <div><b>Search Index</b><small>GitHub authority</small></div>
            </article>
            <article class="stage" data-stage="3">
              <span class="stage-number">IV</span>
              <div><b>Independent Site</b><small>Brand + analytics</small></div>
            </article>
            <div class="payload" id="issue-payload"><span>#28</span><b>我在字节跳动实习的三个月</b></div>
          </div>
          <div class="machine-output">
            <div><span>SEO ENTRY</span><strong id="seo-meter">0%</strong></div>
            <div><span>BRAND ENTRY</span><strong id="brand-meter">0%</strong></div>
            <div><span>COMMENTS</span><strong id="comment-meter">0</strong></div>
          </div>
        </div>
      </section>

      <section class="ownership">
        <header><h2>把每件事交给最擅长它的系统。</h2><p>不是再造 CMS，而是重新分配责任。</p></header>
        <div class="ownership-grid">
          <div class="github-side">
            <span>github.com</span>
            <h3>内容基础设施</h3>
            <ul><li>高权重索引</li><li>原生 Markdown 编辑</li><li>评论、订阅与通知</li><li>版本记录与公开备份</li></ul>
          </div>
          <div class="site-side">
            <span>yourdomain.com</span>
            <h3>品牌展示层</h3>
            <ul><li>独立视觉与排版</li><li>完整分析能力</li><li>自由的交互组件</li><li>回链 Issue 的评论入口</li></ul>
          </div>
        </div>
      </section>

      <section class="flow-code">
        <div>
          <h2>一次发布，双倍入口。</h2>
          <p>构建时获取带有 <code>post</code> 标签的 Issue，将正文写入站点。Issue 更新时触发重新部署。</p>
          <pre><code>GET /repos/OWNER/REPO/issues
labels=post
        ↓
frontmatter + issue.body
        ↓
/posts/ARTICLE-SLUG</code></pre>
        </div>
        <figure>
          <img src={issuesListImg.src} alt="以 GitHub Issues 作为博客内容源" />
          <figcaption>同一篇文章在 GitHub 获得搜索权重，在独立站获得品牌表达。</figcaption>
        </figure>
      </section>

      <section class="closed-loop">
        <div class="loop-ring" aria-hidden="true"><span>SEO</span><span>BRAND</span><span>COMMENTS</span></div>
        <div><h2>内容流动，所有权不丢失。</h2><p>搜索流量从 GitHub 进入，品牌印象在独立站沉淀，讨论再回到 Issue 增加热度。</p><p class="warning">保留本地导出、转存图片、用 draft 标签管理未发布内容。</p></div>
      </section>
    </main>
    <footer class="issue-footer"><a href="/blog/">返回文章列表</a><span>ENGINEERING LAZINESS, PERFECTED.</span></footer>
  </div>

  <style is:global>
    .issue-experience{--black:#101311;--paper:#f4f3ef;--green:#a4ff52;--gray:#707872;position:relative;z-index:10000;background:var(--paper);color:var(--black);min-height:100dvh;font-family:"Space Grotesk","Noto Sans SC",sans-serif}
    .issue-experience~*{display:none!important}.issue-experience *{box-sizing:border-box}.issue-experience a{color:inherit}.issue-nav{height:66px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,4vw,64px);border-bottom:1px solid #bfc4bf;font-size:12px;font-weight:700;letter-spacing:.08em}.issue-nav a{text-decoration:none}.issue-nav span{color:#68706b}
    .issue-hero{min-height:calc(100dvh - 66px);display:grid;grid-template-columns:.82fr 1.18fr;align-items:center;gap:clamp(30px,5vw,90px);padding:clamp(34px,5vh,60px) clamp(20px,4vw,64px)}
    .issue-kicker{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 28px}.issue-copy h1{font-size:clamp(46px,5.9vw,88px);line-height:.95;letter-spacing:-.06em;margin:0}.issue-copy h1 strong{font-weight:700;background:var(--green);padding:0 .08em}.issue-copy>p:not(.issue-kicker){font-size:19px;line-height:1.6;color:#505852;max-width:520px;margin:28px 0}.run-pipeline{border:0;background:var(--black);color:white;padding:15px 22px;font:700 13px inherit;cursor:pointer;box-shadow:6px 6px 0 var(--green)}.run-pipeline:active{transform:translate(2px,2px);box-shadow:4px 4px 0 var(--green)}
    .pipeline-machine{border:2px solid var(--black);background:#dadfd9;box-shadow:14px 14px 0 #202520;min-height:650px;display:grid;grid-template-rows:52px 1fr 88px}.machine-toolbar{display:flex;justify-content:space-between;align-items:center;padding:0 18px;border-bottom:2px solid var(--black);font-size:11px;font-weight:700;letter-spacing:.08em}.machine-toolbar output{color:#334532}.pipeline-track{position:relative;padding:48px 34px;display:grid;align-content:space-between;overflow:hidden}.rail{position:absolute;top:70px;bottom:70px;left:64px;width:4px;background:var(--black)}.stage{position:relative;z-index:2;display:flex;align-items:center;gap:18px;margin-left:8px;opacity:.42;transition:opacity .25s,transform .25s}.stage.active{opacity:1;transform:translateX(8px)}.stage-number{display:grid;place-items:center;width:44px;height:44px;background:#dadfd9;border:3px solid var(--black);font-size:11px;font-weight:800}.stage.active .stage-number{background:var(--green)}.stage b,.stage small{display:block}.stage b{font-size:17px}.stage small{margin-top:4px;color:#626a64;font-size:11px}.payload{position:absolute;right:28px;top:52px;width:48%;background:var(--paper);border:2px solid var(--black);padding:18px;transform:rotate(2deg);transition:transform .55s cubic-bezier(.2,.8,.2,1),top .55s}.payload span{display:block;font-size:11px;color:#677068;margin-bottom:9px}.payload b{font-size:14px;line-height:1.35}.machine-output{display:grid;grid-template-columns:repeat(3,1fr);border-top:2px solid var(--black)}.machine-output div{display:flex;flex-direction:column;justify-content:center;padding:14px 18px}.machine-output div+div{border-left:1px solid var(--black)}.machine-output span{font-size:9px;font-weight:800;letter-spacing:.1em}.machine-output strong{font-size:24px;margin-top:5px}
    .ownership{background:var(--black);color:#eef2ed;padding:120px clamp(20px,7vw,110px)}.ownership header{max-width:860px;margin-bottom:70px}.ownership h2,.flow-code h2,.closed-loop h2{font-size:clamp(38px,5vw,74px);line-height:1;letter-spacing:-.055em;margin:0}.ownership header p{color:#a9b0aa;font-size:18px}.ownership-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid #59615b}.ownership-grid>div{padding:clamp(30px,5vw,70px)}.ownership-grid>div+div{border-left:1px solid #59615b}.ownership-grid span{font-size:12px;color:var(--green);font-weight:700}.ownership-grid h3{font-size:30px;margin:18px 0 32px}.ownership-grid ul{list-style:none;padding:0;margin:0}.ownership-grid li{padding:15px 0;border-bottom:1px solid #353b36;color:#c6ccc7}
    .flow-code{padding:120px clamp(20px,7vw,110px);display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw;align-items:center}.flow-code p{line-height:1.8;color:#5b635d}.flow-code pre{background:#dfe4de;border-left:5px solid var(--green);padding:24px;overflow:auto;line-height:1.7}.flow-code figure{margin:0}.flow-code img{width:100%;display:block;filter:grayscale(1);border:1px solid #aab0aa}.flow-code figcaption{font-size:12px;color:#69706b;margin-top:12px}
    .closed-loop{background:#cfff9c;padding:100px clamp(20px,7vw,110px);display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw;align-items:center}.loop-ring{aspect-ratio:1;border:2px solid var(--black);border-radius:50%;position:relative;animation:issue-spin 18s linear infinite}.loop-ring:after{content:"";position:absolute;inset:18%;border:1px solid var(--black);border-radius:50%}.loop-ring span{position:absolute;font-size:11px;font-weight:800}.loop-ring span:nth-child(1){top:8%;left:45%}.loop-ring span:nth-child(2){right:0;top:52%}.loop-ring span:nth-child(3){bottom:8%;left:20%}.closed-loop p{max-width:620px;line-height:1.75}.closed-loop .warning{border-top:1px solid var(--black);padding-top:20px;font-size:13px}.issue-footer{display:flex;justify-content:space-between;padding:26px clamp(20px,4vw,64px);font-size:11px;font-weight:700}
    @keyframes issue-spin{to{transform:rotate(360deg)}}@media(max-width:900px){.issue-hero,.flow-code,.closed-loop{grid-template-columns:1fr}.pipeline-machine{min-height:600px}.ownership-grid{grid-template-columns:1fr}.ownership-grid>div+div{border-left:0;border-top:1px solid #59615b}.loop-ring{max-width:480px}.issue-copy h1{font-size:clamp(48px,13vw,78px)}}@media(max-width:560px){.issue-nav span{display:none}.issue-hero{padding:44px 16px 70px}.payload{width:58%;right:12px}.pipeline-track{padding-left:18px}.rail{left:48px}.machine-output strong{font-size:18px}.machine-output div{padding:10px}.issue-footer span{display:none}}@media(prefers-reduced-motion:reduce){.loop-ring{animation:none}.stage,.payload{transition:none}}
  </style>

  <OriginalArticle blog={blog} />
  <script>
    const trigger = document.querySelector('.run-pipeline');
    const stages = [...document.querySelectorAll('.pipeline-machine .stage')];
    const payload = document.querySelector('#issue-payload');
    const status = document.querySelector('#pipeline-status');
    const seo = document.querySelector('#seo-meter');
    const brand = document.querySelector('#brand-meter');
    const comments = document.querySelector('#comment-meter');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let running = false;
    const wait = (time) => new Promise(resolve => setTimeout(resolve, reducedMotion ? 60 : time));
    trigger?.addEventListener('click', async () => {
      if (running) return;
      running = true;
      trigger.textContent = '正在发布';
      const labels = ['ISSUE ACCEPTED','FETCHING CONTENT','INDEXING ON GOOGLE','SITE DEPLOYED'];
      for (let index = 0; index < stages.length; index += 1) {
        stages.forEach((stage, stageIndex) => stage.classList.toggle('active', stageIndex === index));
        payload.style.top = `${52 + index * 118}px`;
        payload.style.transform = `rotate(${index % 2 ? -2 : 2}deg)`;
        status.textContent = labels[index];
        seo.textContent = `${Math.min(100, index * 34)}%`;
        brand.textContent = `${Math.max(0, (index - 1) * 50)}%`;
        comments.textContent = String(index < 3 ? index * 7 : 28);
        await wait(700);
      }
      trigger.textContent = '再次运行';
      running = false;
    });
  </script>
</body>
</html>

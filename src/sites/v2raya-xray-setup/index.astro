---
import OriginalArticle from "../../components/article/OriginalArticle.astro";

const { blog } = Astro.props;
const { title, description, pubDate } = blog.data;
const date = new Date(pubDate).toLocaleDateString("zh-CN");
const commands = [
  ["panel", "安装 v2rayA", "sudo apt install ./installer_debian_x64_2.2.7.4.deb"],
  ["core", "部署 Xray", "sudo mv xray-core/xray /usr/local/bin/"],
  ["rules", "放置规则库", "sudo mv xray-core/{geoip,geosite}.dat /usr/local/share/xray/"],
  ["service", "启动服务", "sudo systemctl enable --now v2raya"],
  ["port", "放行面板", "TCP 2017 / HTTP 20172 / SOCKS5 20170"],
  ["verify", "验证代理", "curl -x http://127.0.0.1:20172 -I https://www.google.com"],
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#061616;color:#e7fff9;font-family:Manrope,sans-serif;overflow-x:hidden}button,a{font:inherit}.nav{height:68px;padding:0 clamp(18px,4vw,60px);display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #224440;background:#061616}.nav strong{font:700 13px "Space Mono";letter-spacing:.06em}.nav a{color:#a4c5bf;text-decoration:none;font:12px "Space Mono"}
    .hero{min-height:calc(100dvh - 68px);display:grid;grid-template-columns:minmax(320px,.8fr) minmax(560px,1.35fr);align-items:center;gap:5vw;padding:clamp(30px,5vw,70px) clamp(18px,4vw,60px)}.intro h1{font-size:clamp(46px,6vw,92px);line-height:.94;letter-spacing:-.065em;margin:12px 0 24px}.intro h1 em{font-style:normal;color:#49e3b0}.intro p{max-width:540px;color:#a7c3bd;font-size:18px;line-height:1.65}.date{font:11px "Space Mono";color:#5f9389}.mode{display:flex;gap:8px;margin-top:28px}.mode button{border:1px solid #347366;color:#b5d8d1;background:transparent;padding:10px 14px;cursor:pointer}.mode button.active{color:#061616;background:#49e3b0;border-color:#49e3b0}
    .network{position:relative;min-height:640px;border:1px solid #29544d;background:#0a201f;overflow:hidden}.network::before{content:"";position:absolute;inset:0;background-image:linear-gradient(#13312e 1px,transparent 1px),linear-gradient(90deg,#13312e 1px,transparent 1px);background-size:34px 34px;opacity:.65}.network svg{position:absolute;inset:0;width:100%;height:100%}.wire{fill:none;stroke:#335c56;stroke-width:3}.wire.live{stroke:#49e3b0;stroke-dasharray:12 8;animation:packet 1.2s linear infinite}.packet{fill:#49e3b0;filter:drop-shadow(0 0 8px #49e3b0);opacity:0}.network.running .packet{opacity:1}.box{position:absolute;border:1px solid #3b7067;background:#0e2926;padding:14px 16px;width:170px;z-index:2}.box small{display:block;font:10px "Space Mono";color:#679c92;margin-bottom:8px}.box b{font-size:14px}.box span{display:block;color:#7ea9a1;font:10px/1.5 "Space Mono";margin-top:6px}.client{left:5%;top:12%}.server{left:5%;bottom:12%}.panel{left:39%;top:14%}.core{left:42%;bottom:12%}.exit{right:5%;top:36%;border-color:#49e3b0}.network-state{position:absolute;left:39%;top:45%;z-index:3;font:700 clamp(22px,3vw,40px) "Space Mono";color:#2e5b53}.network.running .network-state{color:#49e3b0}.launch{position:absolute;right:18px;bottom:18px;z-index:4;border:0;background:#49e3b0;color:#06201c;padding:13px 18px;font-weight:700;cursor:pointer}
    .steps{background:#e9f0ed;color:#102522;padding:clamp(80px,10vw,150px) clamp(18px,8vw,130px)}.steps h2{font-size:clamp(42px,6vw,86px);line-height:.95;letter-spacing:-.06em;margin:0 0 56px;max-width:850px}.rail{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid #78958f}.step{padding:22px 16px 28px;border-right:1px solid #a8bbb7;cursor:pointer;min-height:220px;transition:background .2s}.step:hover,.step.active{background:#49e3b0}.step small{font:10px "Space Mono";color:#496c66}.step h3{font-size:17px;margin:25px 0 15px}.step code{font:10px/1.6 "Space Mono";word-break:break-all}
    .manual{background:#f6f4ea;color:#171c19;padding:clamp(80px,10vw,150px) clamp(18px,8vw,130px);display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw}.manual h2{font-size:clamp(40px,5vw,76px);line-height:1;letter-spacing:-.055em;margin:0}.manual article{font-size:18px;line-height:1.8}.manual pre{background:#102522;color:#bce4dc;padding:24px;overflow:auto;font:12px/1.8 "Space Mono"}.warning{color:#a72c25;font-weight:700}.verify{background:#49e3b0;color:#06201c;padding:clamp(80px,10vw,150px) 20px;text-align:center}.verify h2{font-size:clamp(48px,8vw,110px);line-height:.9;letter-spacing:-.07em;margin:0}.verify p{font-size:19px;max-width:700px;margin:30px auto}.verify code{display:inline-block;padding:14px 18px;background:#06201c;color:#a9f5dc;font:12px "Space Mono"}
    @keyframes packet{to{stroke-dashoffset:-20}}@media(max-width:950px){.hero{grid-template-columns:1fr}.network{min-height:560px}.rail{grid-template-columns:repeat(2,1fr)}.manual{grid-template-columns:1fr}}@media(max-width:580px){.intro h1{font-size:46px}.network{min-height:690px}.box{width:42%;padding:10px}.client{left:4%;top:5%}.panel{left:auto;right:4%;top:20%}.server{left:4%;bottom:26%}.core{left:auto;right:4%;bottom:13%}.exit{right:4%;top:46%}.network-state{left:7%;top:35%;font-size:20px}.rail{grid-template-columns:1fr}.step{min-height:0;border-right:0;border-bottom:1px solid #a8bbb7}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.wire.live{stroke-dasharray:none}}
  </style>
</head>
<body>
  <header class="nav"><strong>ROUTE / 2017</strong><a href="/blog/">返回博客</a></header>
  <main>
    <section class="hero">
      <div class="intro"><div class="date">{date} / UBUNTU 24.04 / X86_64</div><h1>从受阻服务器<br/>到<em>代理出口</em></h1><p>{description}</p><div class="mode"><button class="active" data-mode="blocked">初始网络</button><button data-mode="ready">部署完成</button></div></div>
      <div class="network" id="network" aria-label="动态代理网络拓扑">
        <svg viewBox="0 0 900 640" preserveAspectRatio="none"><path class="wire w0" d="M160 125 C300 125 300 150 420 150"/><path class="wire w1" d="M170 520 C300 520 300 480 450 480"/><path class="wire w2" d="M500 180 C500 260 510 350 520 450"/><path class="wire w3" d="M560 470 C700 450 710 350 790 335"/><circle class="packet" r="7"><animateMotion dur="2.6s" repeatCount="indefinite" path="M170 520 C300 520 300 480 450 480 C510 430 520 390 520 330 C620 340 710 350 790 335"/></circle></svg>
        <div class="box client"><small>LOCAL MACHINE</small><b>离线安装包</b><span>scp -> /tmp</span></div><div class="box server"><small>TENCENT CLOUD</small><b>Ubuntu 24.04</b><span>Docker Hub blocked</span></div><div class="box panel"><small>CONTROL PLANE</small><b>v2rayA</b><span>:2017</span></div><div class="box core"><small>ROUTING ENGINE</small><b>Xray Core</b><span>/usr/local/bin/xray</span></div><div class="box exit"><small>EGRESS</small><b>HTTP / SOCKS5</b><span>:20172 / :20170</span></div>
        <div class="network-state" id="networkState">NO ROUTE</div><button class="launch" id="launch">建立线路</button>
      </div>
    </section>
    <section class="steps"><h2>一条线路，六个确定状态</h2><div class="rail">{commands.map(([id,label,command],index)=><button class="step" data-id={id} data-step={index}><small>0{index+1}</small><h3>{label}</h3><code>{command}</code></button>)}</div></section>
    <section class="manual"><h2>手动部署反而更稳</h2><article><p>国内初始环境里，Docker Hub 和官方 apt 源都可能不可用。下载 <code>.deb</code> 与 Xray 压缩包后通过 <code>scp</code> 上传，能绕开这两个前置依赖。</p><pre>cd /tmp
sudo apt install ./installer_debian_x64_2.2.7.4.deb
unzip Xray-linux-64.zip -d xray-core
sudo mv xray-core/xray /usr/local/bin/
sudo chmod +x /usr/local/bin/xray</pre><p class="warning">如果系统里残留旧 V2Ray，v2rayA 可能优先选错内核。移除旧二进制后重启服务。</p></article></section>
    <section class="verify"><h2>CURL, NOT PING.</h2><p>Ping 使用 ICMP，普通 HTTP/SOCKS 代理不会转发它。验证代理必须观察 HTTP 握手。</p><code>curl -x http://127.0.0.1:20172 -I https://www.google.com</code></section>
  </main>
  <OriginalArticle blog={blog} />
  <script>
    const network = document.querySelector('#network');
    const state = document.querySelector('#networkState');
    const wires = [...document.querySelectorAll('.wire')];
    const steps = [...document.querySelectorAll('.step')];
    function setReady(ready) {
      network.classList.toggle('running', ready);
      wires.forEach(wire => wire.classList.toggle('live', ready));
      state.textContent = ready ? 'ROUTE ACTIVE' : 'NO ROUTE';
      document.querySelectorAll('[data-mode]').forEach(button => button.classList.toggle('active', button.dataset.mode === (ready ? 'ready' : 'blocked')));
    }
    document.querySelector('#launch')?.addEventListener('click', () => setReady(!network.classList.contains('running')));
    document.querySelectorAll('[data-mode]').forEach(button => button.addEventListener('click', () => setReady(button.dataset.mode === 'ready')));
    steps.forEach((step, index) => step.addEventListener('click', () => { steps.forEach((item, position) => item.classList.toggle('active', position <= index)); wires.forEach((wire, position) => wire.classList.toggle('live', position <= Math.min(index, wires.length - 1))); if(index === steps.length - 1) setReady(true); }));
  </script>
</body>
</html>

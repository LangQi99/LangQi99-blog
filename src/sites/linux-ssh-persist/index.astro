            <div class="tool-switch" role="group" aria-label="选择会话工具">
              <button data-ssh-tool="nohup" aria-pressed="false">nohup</button>
              <button data-ssh-tool="screen" aria-pressed="false">Screen</button>
              <button data-ssh-tool="tmux" aria-pressed="true">Tmux</button>
            </div>
            <div class="terminal-window" id="sshTerminal" aria-live="polite"></div>
            <div class="process-vitals">
              <div class="pulse-track"><div class="pulse-wave"></div></div>
              <span class="vital-label" id="sshVital">PID 4821 / ALIVE</span>
            </div>
          </div>
        </div>

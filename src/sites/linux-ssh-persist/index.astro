    <section class="survival-story" id="ssh-methods">
      <h2>三种方法，保护的是三种工作方式。</h2>
      <div class="method-runway">
        <article class="method">
          <strong>nohup</strong>
          <p>最直接地忽略 SIGHUP。适合无需输入、只关心日志的单一任务，但 stdin 会被重定向到 /dev/null。</p>
          <code>nohup python main.py &gt; my_log.txt 2&gt;&amp;1 &amp;</code>
        </article>
        <article class="method">
          <strong>Screen</strong>
          <p>保留完整虚拟终端，稳定但操作较旧。查看历史需要进入 Copy mode，默认鼠标滚轮体验一般。</p>
          <code>screen -S demo · Ctrl+a d · screen -r demo</code>
        </article>
        <article class="method recommended">
          <strong>Tmux</strong>
          <p>会话、窗口与进程分离。支持分屏、恢复和鼠标，是长期服务器工作的推荐默认方案。</p>
          <code>tmux new -s train · Ctrl+b d · tmux attach -t train</code>
        </article>
      </div>
      <footer class="survival-footer"><span>建议开启 set -g mouse on</span><span>{formattedDate}</span></footer>
    </section>
  </main>
  <OriginalArticle blog={blog} />
  <script is:inline>
    (() => {
      const machine = document.querySelector('#sshMachine');
      const terminal = document.querySelector('#sshTerminal');
      const breakButton = document.querySelector('#sshBreak');
      const networkState = document.querySelector('#sshNetworkState');
      const vital = document.querySelector('#sshVital');
      const toolLabel = document.querySelector('#sshToolLabel');
      const buttons = [...document.querySelectorAll('[data-ssh-tool]')];
      if (!machine || !terminal || !breakButton || !networkState || !vital || !toolLabel) return;
      const tools = {
        nohup: { label: 'NOHUP / BACKGROUND', survives: true, logs: ['$', 'nohup python main.py > my_log.txt 2>&1 &', '[1] 4821', 'nohup: ignoring input', 'epoch 18/100 · loss 0.084'] },
        screen: { label: 'SCREEN / ATTACHED', survives: true, logs: ['$', 'screen -S demo', '[screen 0: bash]', '$ python main.py', 'epoch 18/100 · loss 0.084'] },
        tmux: { label: 'TMUX / ATTACHED', survives: true, logs: ['$', 'tmux new -s train', '[train:0] $ python main.py', 'epoch 18/100 · loss 0.084', 'mouse mode: on'] }
      };
      let active = 'tmux';
      let offline = false;
      const render = () => {
        const data = tools[active];
        terminal.innerHTML = data.logs.map((line, index) => `<div class="term-line"><span class="term-time">${String(index).padStart(2,'0')}</span><span>${line}</span></div>`).join('') +
          (offline ? `<div class="term-line"><span class="term-time">!</span><span>client_loop: send disconnect: Broken pipe</span></div><div class="term-line"><span class="term-time">✓</span><span>${active === 'nohup' ? 'process ignores SIGHUP; follow my_log.txt after reconnect' : 'virtual terminal detached; session keeps running'}</span></div>` : '');
        machine.classList.toggle('machine-offline', offline);
        machine.classList.toggle('machine-dead', false);
        networkState.textContent = offline ? 'SSH LINK: DISCONNECTED' : 'SSH LINK: CONNECTED';
        vital.textContent = offline ? 'PID 4821 / SURVIVED' : 'PID 4821 / ALIVE';
        toolLabel.textContent = offline ? `${active.toUpperCase()} / DETACHED` : data.label;
        breakButton.innerHTML = offline ? '恢复<br>连接' : '触发<br>断线';
      };
      buttons.forEach((button) => button.addEventListener('click', () => {
        active = button.dataset.sshTool;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        render();
      }));
      breakButton.addEventListener('click', () => { offline = !offline; render(); });
      render();
    })();
  </script>


        <div class="machine-head"><span>Remote process chamber</span><span id="sshToolLabel">TMUX / ATTACHED</span></div>
        <div class="machine-grid">
          <div class="signal-rail">
            <span class="vital-label">SSH</span><div class="cable"></div>

---
import type { CollectionEntry } from "astro:content";
import OriginalArticle from "../../components/article/OriginalArticle.astro";

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const { title, description, pubDate, categories, tags } = blog.data;
const formattedDate = pubDate ? new Date(pubDate).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" }) : "";

const nohupBasic = `<span class="c"># 后台运行 Python 脚本</span>
<span class="k">nohup</span> python main.py <span class="o">&</span>`;

const nohupLog = `<span class="c"># 实时查看运行日志</span>
<span class="k">tail</span> -f nohup.out

<span class="c"># 自定义输出文件</span>
<span class="k">nohup</span> python main.py <span class="o">></span> my_log.txt <span class="o">2>&1 &</span>`;

const screenCode = `<span class="c"># 创建会话</span>
<span class="k">screen</span> -S demo

<span class="c"># 在会话中执行命令</span>
python main.py

<span class="c"># 分离会话: Ctrl+a -> d</span>
<span class="c"># 恢复会话</span>
<span class="k">screen</span> -r demo`;

const tmuxConfig = `<span class="c"># 开启鼠标支持</span>
<span class="k">echo</span> <span class="s">"set -g mouse on"</span> >> ~/.tmux.conf

<span class="c"># 重新加载配置</span>
<span class="k">tmux</span> source-file ~/.tmux.conf`;

const tmuxSession = `<span class="c"># 新建会话</span>
<span class="k">tmux</span> new -s <span class="v">[session_name]</span>

<span class="c"># 查看所有会话</span>
<span class="k">tmux</span> ls

<span class="c"># 恢复会话</span>
<span class="k">tmux</span> attach -t <span class="v">[session_name]</span>

<span class="c"># 关闭会话</span>
<span class="k">tmux</span> kill-session -t <span class="v">[session_name]</span>`;

const tmuxKeys = `<span class="c"># 默认前缀键: Ctrl+b</span>

<span class="k">Ctrl+b</span> -> <span class="s">d</span>    <span class="c"># 分离会话</span>
<span class="k">Ctrl+b</span> -> <span class="s">c</span>    <span class="c"># 新建窗口</span>
<span class="k">Ctrl+b</span> -> <span class="s">0-9</span>  <span class="c"># 切换窗口</span>
<span class="k">Ctrl+b</span> -> <span class="s">%</span>    <span class="c"># 左右分屏</span>
<span class="k">Ctrl+b</span> -> <span class="s">"</span>    <span class="c"># 上下分屏</span>`;
---

<!doctype html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="article:published_time" content={pubDate ? new Date(pubDate).toISOString() : ""} />
  {categories && <meta name="article:section" content={categories[0]} />}
  {tags && tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <style is:global is:inline>
    :root {
      --bg-deep: #0c0c0c;
      --bg-surface: #141414;
      --bg-elevated: #1a1a1a;
      --bg-code: #111111;
      --text-primary: #e8e8e8;
      --text-secondary: #999999;
      --text-muted: #666666;
      --accent: #A78BFA;
      --accent-dim: #7c5cbf;
      --accent-subtle: rgba(167, 139, 250, 0.08);
      --accent-glow: rgba(167, 139, 250, 0.12);
      --border: rgba(255, 255, 255, 0.06);
      --border-accent: rgba(167, 139, 250, 0.2);
      --radius: 4px;
      --font: 'Geist', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
      --mono: 'Geist', monospace;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
      .reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    body {
      font-family: var(--font);
      background: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    /* Reveal animations */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Navigation */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(12px);
      background: rgba(12, 12, 12, 0.8);
      border-bottom: 1px solid var(--border);
    }
    .nav-back {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      font-weight: 400;
      transition: color 0.2s;
    }
    .nav-back:hover {
      color: var(--accent);
    }
    .nav-back svg {
      width: 16px;
      height: 16px;
    }
    .nav-meta {
      font-size: 13px;
      color: var(--text-muted);
    }

    /* Hero */
    .hero {
      padding: 160px 32px 80px;
      max-width: 860px;
      margin: 0 auto;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      background: var(--accent-subtle);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 500;
      color: var(--accent);
      margin-bottom: 24px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .hero-title {
      font-size: clamp(32px, 5vw, 48px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--text-primary);
      margin-bottom: 20px;
    }
    .hero-title .accent {
      color: var(--accent);
    }
    .hero-desc {
      font-size: 17px;
      color: var(--text-secondary);
      max-width: 640px;
      line-height: 1.8;
    }
    .hero-signal {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 32px;
      padding: 16px 20px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 14px;
      color: var(--text-secondary);
      font-family: var(--mono);
    }
    .hero-signal .prompt {
      color: var(--accent);
      user-select: none;
    }
    .hero-signal .cmd {
      color: var(--text-primary);
    }
    .hero-signal .cursor-blink {
      display: inline-block;
      width: 8px;
      height: 18px;
      background: var(--accent);
      opacity: 0.8;
      animation: blink 1.2s step-end infinite;
      vertical-align: text-bottom;
      margin-left: 2px;
    }
    @keyframes blink {
      0%, 100% { opacity: 0.8; }
      50% { opacity: 0; }
    }

    /* Problem statement */
    .problem {
      max-width: 860px;
      margin: 0 auto;
      padding: 60px 32px 80px;
    }
    .problem-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }
    .problem-text {
      font-size: 16px;
      color: var(--text-secondary);
      line-height: 1.9;
      max-width: 680px;
    }
    .problem-text code {
      font-family: var(--mono);
      font-size: 14px;
      background: var(--bg-elevated);
      padding: 2px 6px;
      border-radius: var(--radius);
      color: var(--accent);
    }

    /* Chapter sections */
    .chapter {
      max-width: 860px;
      margin: 0 auto;
      padding: 60px 32px;
    }
    .chapter-divider {
      width: 100%;
      height: 1px;
      background: var(--border);
      max-width: 860px;
      margin: 0 auto;
    }

    /* Solution headers */
    .sol-header {
      margin-bottom: 32px;
    }
    .sol-number {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }
    .sol-name {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.01em;
      margin-bottom: 8px;
    }
    .sol-tagline {
      font-size: 15px;
      color: var(--text-secondary);
    }

    /* nohup (compact) */
    .nohup-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 24px;
    }
    @media (max-width: 640px) {
      .nohup-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Callout */
    .callout {
      margin-top: 24px;
      padding: 14px 18px;
      background: rgba(250, 204, 21, 0.04);
      border-left: 2px solid rgba(250, 204, 21, 0.4);
      border-radius: 0 var(--radius) var(--radius) 0;
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
    .callout strong {
      color: rgba(250, 204, 21, 0.85);
      font-weight: 600;
    }

    /* Screen section */
    .screen-note {
      margin-top: 24px;
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.8;
    }
    .screen-issues {
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .screen-issue {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
    }
    .screen-issue .icon {
      flex-shrink: 0;
      width: 18px;
      height: 18px;
      margin-top: 2px;
      color: var(--text-muted);
    }

    /* Tmux (hero section) */
    .tmux-hero {
      max-width: 860px;
      margin: 0 auto;
      padding: 80px 32px;
      position: relative;
    }
    .tmux-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .tmux-hero-inner {
      position: relative;
      z-index: 1;
    }
    .tmux-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      background: var(--accent-subtle);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 20px;
      letter-spacing: 0.3px;
    }
    .tmux-title {
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .tmux-sub {
      font-size: 16px;
      color: var(--text-secondary);
      max-width: 560px;
      line-height: 1.8;
      margin-bottom: 40px;
    }

    .tmux-blocks {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .tmux-block-label {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Code blocks */
    .code-block {
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .code-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.02);
    }
    .code-lang {
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--mono);
      font-weight: 500;
    }
    .code-dots {
      display: flex;
      gap: 6px;
    }
    .code-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--border);
    }
    .code-body {
      padding: 16px 20px;
      overflow-x: auto;
    }
    .code-body pre {
      font-family: var(--mono);
      font-size: 13px;
      line-height: 1.7;
      color: var(--text-primary);
      white-space: pre;
      margin: 0;
    }
    .code-body .c { color: var(--text-muted); }
    .code-body .k { color: var(--accent); }
    .code-body .s { color: #6ee7b7; }
    .code-body .o { color: var(--text-secondary); }
    .code-body .v { color: #93c5fd; }

    /* Comparison table */
    .comparison {
      max-width: 860px;
      margin: 0 auto;
      padding: 60px 32px 80px;
    }
    .comparison-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 24px;
    }
    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    .comparison-table th {
      text-align: left;
      padding: 12px 16px;
      font-weight: 500;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .comparison-table td {
      padding: 14px 16px;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      line-height: 1.6;
    }
    .comparison-table tr:last-child td {
      border-bottom: none;
    }
    .comparison-table tr.recommended td {
      color: var(--text-primary);
      background: var(--accent-subtle);
    }
    .comparison-table .tool-name {
      font-weight: 600;
      color: var(--text-primary);
      font-family: var(--mono);
      font-size: 13px;
    }
    .comparison-table .recommended .tool-name {
      color: var(--accent);
    }
    .tag-rec {
      display: inline-block;
      padding: 2px 6px;
      background: var(--accent-subtle);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius);
      font-size: 10px;
      font-weight: 600;
      color: var(--accent);
      margin-left: 8px;
      vertical-align: middle;
      letter-spacing: 0.3px;
    }

    /* Footer */
    .footer {
      max-width: 860px;
      margin: 0 auto;
      padding: 40px 32px 80px;
      border-top: 1px solid var(--border);
    }
    .footer-text {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.8;
    }
    .footer-text strong {
      color: var(--text-secondary);
      font-weight: 500;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav {
        padding: 14px 20px;
      }
      .hero {
        padding: 120px 20px 60px;
      }
      .problem, .chapter, .comparison, .footer, .tmux-hero {
        padding-left: 20px;
        padding-right: 20px;
      }
      .hero-signal {
        font-size: 13px;
        padding: 12px 14px;
      }
      .comparison-table {
        font-size: 13px;
      }
      .comparison-table th,
      .comparison-table td {
        padding: 10px 12px;
      }
    }

    @media (max-width: 480px) {
      .comparison-table {
        display: block;
        overflow-x: auto;
      }
      .nav-meta {
        display: none;
      }
    }
  </style>
</head>
<body>
  <style is:inline>
    body > :not(.survival-site):not(script):not(style) { display: none !important; }
    .survival-site {
      --ink: #15251d;
      --paper: #eef1e8;
      --signal: #ff5a36;
      --green: #7ed39b;
      min-height: 100dvh;
      background: var(--paper);
      color: var(--ink);
      font-family: "Geist", "Noto Sans SC", sans-serif;
      line-height: 1.5;
    }
    .survival-site * { box-sizing: border-box; }
    .survival-nav {
      height: 68px;
      padding: 0 clamp(20px, 4vw, 64px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(21, 37, 29, .18);
    }
    .survival-nav a { color: inherit; text-decoration: none; font-weight: 650; }
    .survival-brand { display: flex; align-items: center; gap: 10px; }
    .survival-brand i {
      width: 18px; height: 18px; display: block; border-radius: 50%;
      border: 5px solid var(--signal);
      box-shadow: 0 0 0 1px var(--ink);
    }
    .survival-state { font: 600 12px/1 monospace; letter-spacing: .08em; text-transform: uppercase; }
    .survival-hero {
      min-height: calc(100dvh - 68px);
      display: grid;
      grid-template-columns: minmax(0, .78fr) minmax(560px, 1.22fr);
      align-items: center;
      gap: clamp(36px, 6vw, 100px);
      padding: clamp(42px, 7vh, 74px) clamp(20px, 4vw, 64px);
      overflow: hidden;
    }
    .survival-copy h1 {
      max-width: 720px;
      font-size: clamp(3.2rem, 6.5vw, 7.8rem);
      line-height: .86;
      letter-spacing: -.075em;
      margin: 0 0 28px;
      font-weight: 850;
    }
    .survival-copy h1 span { color: var(--signal); display: block; }
    .survival-copy p {
      max-width: 520px; font-size: clamp(1.05rem, 1.4vw, 1.35rem);
      color: rgba(21,37,29,.72); margin: 0 0 30px;
    }
    .survival-copy .jump {
      display: inline-flex; padding: 13px 18px; border: 1px solid var(--ink);
      color: inherit; text-decoration: none; font-weight: 700;
      transition: transform .2s ease, background .2s ease;
    }
    .survival-copy .jump:hover { transform: translateY(-2px); background: white; }
    .session-machine {
      position: relative; min-height: 600px; border: 1px solid var(--ink);
      background: #dfe5d9; box-shadow: 20px 20px 0 var(--ink);
      overflow: hidden;
    }
    .machine-head {
      height: 54px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 18px; border-bottom: 1px solid var(--ink);
      font: 700 12px/1 monospace; text-transform: uppercase; letter-spacing: .08em;
    }
    .machine-head span:last-child { color: #455a4c; }
    .machine-grid {
      display: grid; grid-template-columns: 112px 1fr; min-height: 544px;
    }
    .signal-rail {
      border-right: 1px solid var(--ink); padding: 20px 14px;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      background: rgba(255,255,255,.38);
    }
    .cable {
      width: 5px; flex: 1; min-height: 180px; background: var(--ink);
      position: relative; transition: background .25s ease;
    }
    .cable::before, .cable::after {
      content: ""; position: absolute; left: 50%; translate: -50% 0;
      width: 22px; height: 22px; border: 4px solid var(--ink); background: var(--paper);
    }
    .cable::before { top: 0; border-radius: 50% 50% 3px 3px; }
    .cable::after { bottom: 0; border-radius: 3px 3px 50% 50%; }
    .machine-offline .cable {
      background: linear-gradient(var(--ink) 0 43%, transparent 43% 57%, var(--ink) 57%);
    }
    .break-button {
      width: 80px; min-height: 80px; border: 1px solid var(--ink); background: var(--signal);
      color: #161616; font: 800 11px/1.2 monospace; text-transform: uppercase;
      cursor: pointer; transition: transform .15s ease;
    }
    .break-button:active { transform: scale(.96); }
    .terminal-bay { padding: 22px; display: flex; flex-direction: column; gap: 14px; }
    .tool-switch { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--ink); }
    .tool-switch button {
      padding: 13px 8px; border: 0; border-right: 1px solid var(--ink); background: transparent;
      color: inherit; font: 750 12px/1 monospace; cursor: pointer;
    }
    .tool-switch button:last-child { border-right: 0; }
    .tool-switch button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
    .terminal-window {
      flex: 1; min-height: 330px; background: #13231b; color: #d9f8df;
      padding: 20px; font: 500 13px/1.7 monospace; position: relative; overflow: hidden;
    }
    .terminal-window::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: repeating-linear-gradient(transparent 0 3px, rgba(255,255,255,.025) 3px 4px);
    }
    .term-line { display: flex; gap: 12px; }
    .term-time { color: #7ed39b; }
    .process-vitals {
      display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 12px;
      border: 1px solid var(--ink); padding: 14px;
    }
    .pulse-track { height: 20px; overflow: hidden; position: relative; }
    .pulse-wave {
      position: absolute; inset: 0; background:
        linear-gradient(120deg, transparent 0 18%, var(--signal) 18% 20%, transparent 20% 31%, var(--signal) 31% 33%, transparent 33% 100%);
      background-size: 120px 100%; animation: pulse-slide 1.6s linear infinite;
    }

---
import OriginalArticle from "../../components/article/OriginalArticle.astro";
import img1 from "../../content/blog/image/linux-pinyin/1753535240896.png";
import img2 from "../../content/blog/image/linux-pinyin/1753535326134.png";
import img3 from "../../content/blog/image/linux-pinyin/1753536280545.png";
import img4 from "../../content/blog/image/linux-pinyin/1753537431564.png";
const { blog } = Astro.props;
const { title, description } = blog.data;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&family=Source+Code+Pro:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#171b25;font-family:Figtree,"Noto Sans SC",sans-serif;overflow-x:hidden}button,input,a{font:inherit}.bar{height:66px;padding:0 clamp(18px,4vw,58px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cfd5e1}.bar b{font-size:14px}.bar a{color:inherit;text-decoration:none;font-size:13px}
    .hero{min-height:calc(100dvh - 66px);display:grid;grid-template-columns:minmax(300px,.8fr) minmax(560px,1.2fr);gap:5vw;align-items:center;padding:clamp(30px,5vw,72px) clamp(18px,5vw,74px)}.copy h1{font-size:clamp(48px,7vw,104px);line-height:.9;letter-spacing:-.07em;margin:0 0 28px}.copy h1 span{color:#1b67f0}.copy p{font-size:18px;line-height:1.7;max-width:520px;color:#586071}.systems{margin-top:28px;display:flex;gap:8px}.systems button{padding:10px 15px;border:1px solid #aab3c4;background:#fff;color:#41495a;cursor:pointer}.systems button.active{background:#171b25;color:#fff;border-color:#171b25}
    .lab{min-height:620px;background:#e9edf5;border:1px solid #bac3d2;padding:18px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}.desktop-top{position:absolute;top:0;left:0;right:0;height:34px;background:#20242d;color:#dbe1ec;padding:9px 12px;font:10px "Source Code Pro";display:flex;justify-content:space-between}.editor{width:min(650px,92%);margin:auto;background:#fff;border:1px solid #b9c2d2;box-shadow:0 26px 70px rgba(40,54,78,.18)}.editor-head{height:42px;background:#f7f8fb;border-bottom:1px solid #d8dde7;padding:12px 16px;font-size:12px;color:#596173}.paper{min-height:300px;padding:46px 42px;position:relative}.paper label{font-size:12px;color:#81899a;display:block;margin-bottom:15px}.compose{width:100%;border:0;border-bottom:2px solid #171b25;outline:0;font-size:clamp(30px,4vw,54px);font-weight:700;letter-spacing:-.04em;padding:8px 0;background:transparent}.compose:focus{border-color:#1b67f0}.candidate{margin-top:12px;border:1px solid #aab4c5;background:#fff;box-shadow:0 12px 30px rgba(42,55,77,.15);min-height:64px;display:flex;align-items:center;gap:4px;padding:8px}.candidate button{border:0;background:transparent;padding:10px 12px;cursor:pointer;white-space:nowrap}.candidate button:first-child{background:#1b67f0;color:#fff}.candidate.ibus button{font-family:"Noto Sans SC";padding:9px 7px}.candidate.ibus button:nth-child(n+3){color:#8a92a2}.candidate.fcitx{border-radius:12px}.candidate.fcitx button{border-radius:8px}.result{margin-top:28px;font-size:17px;color:#5a6373}.status{position:absolute;right:28px;bottom:25px;background:#171b25;color:#fff;padding:10px 13px;font:10px "Source Code Pro"}
    .comparison{padding:clamp(90px,11vw,170px) clamp(18px,8vw,130px);background:#171b25;color:#f4f6fa}.comparison h2{font-size:clamp(46px,7vw,100px);line-height:.92;letter-spacing:-.07em;margin:0 0 60px}.shots{display:grid;grid-template-columns:1fr 1fr;gap:28px}.shot{margin:0}.shot img{width:100%;height:420px;object-fit:contain;background:#f1f3f7;display:block}.shot figcaption{padding:16px 0;color:#aeb6c6;line-height:1.6}
    .attempts{padding:clamp(90px,11vw,170px) clamp(18px,8vw,130px);background:#fff}.attempts h2{font-size:clamp(44px,6vw,88px);line-height:.95;letter-spacing:-.06em;margin:0 0 60px}.timeline{display:grid;grid-template-columns:repeat(3,1fr);border-top:2px solid #171b25}.attempt{padding:26px 24px;border-right:1px solid #bfc5d0}.attempt:last-child{border-right:0}.attempt small{font:11px "Source Code Pro";color:#1b67f0}.attempt h3{font-size:24px;margin:28px 0 15px}.attempt p{line-height:1.7;color:#596173}.attempt pre{background:#eef1f6;padding:16px;overflow:auto;font:11px/1.7 "Source Code Pro"}
    .decision{padding:clamp(90px,11vw,170px) clamp(18px,8vw,130px);background:#1b67f0;color:#fff;display:grid;grid-template-columns:.85fr 1.15fr;gap:8vw}.decision h2{font-size:clamp(48px,7vw,100px);line-height:.9;letter-spacing:-.07em;margin:0}.decision article{font-size:19px;line-height:1.8}.decision strong{display:block;font-size:30px;margin-top:30px}
    @media(max-width:940px){.hero{grid-template-columns:1fr}.lab{min-height:570px}.shots{grid-template-columns:1fr}.timeline{grid-template-columns:1fr}.attempt{border-right:0;border-bottom:1px solid #bfc5d0}.decision{grid-template-columns:1fr}}@media(max-width:580px){.copy h1{font-size:50px}.paper{padding:38px 18px}.candidate{overflow-x:auto;align-items:stretch}.candidate button{font-size:14px}.shot img{height:280px}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  </style>
</head>
<body>
  <header class="bar"><b>INPUT METHOD LAB</b><a href="/blog/">返回博客</a></header>
  <main>
    <section class="hero">
      <div class="copy"><h1>输入 <span>wsm</span><br/>应该得到什么？</h1><p>{description}</p><div class="systems"><button class="active" data-system="ibus">IBus</button><button data-system="fcitx">Fcitx5</button></div></div>
      <div class="lab"><div class="desktop-top"><span>Ubuntu 24.04</span><span id="systemName">IBus Pinyin</span></div><div class="editor"><div class="editor-head">new-note.txt</div><div class="paper"><label for="compose">在这里输入拼音缩写</label><input class="compose" id="compose" value="wsm" autocomplete="off" spellcheck="false"/><div class="candidate ibus" id="candidate" aria-live="polite"></div><div class="result">已选择：<strong id="selected">尚未选择</strong></div></div></div><div class="status" id="labStatus">词库命中率 / LOW</div></div>
    </section>
    <section class="comparison"><h2>默认原生，实际远古</h2><div class="shots"><figure class="shot"><img src={img1.src} alt="Ubuntu IBus 拼音设置界面" loading="lazy"/><figcaption>Ubuntu 24.04 默认提供 IBus，但默认词库与现代缩写输入习惯脱节。</figcaption></figure><figure class="shot"><img src={img2.src} alt="IBus 输入 wsm 的候选结果" loading="lazy"/><figcaption>输入 wsm 时，期待的“为什么”没有出现在合理候选位置。</figcaption></figure></div></section>
    <section class="attempts"><h2>我试过把词库救回来</h2><div class="timeline"><article class="attempt"><small>PRESET</small><h3>开启预设词库</h3><p>勾选系统提供的词库选项，只能满足基本需求。</p><img src={img3.src} alt="IBus 预设词库设置" loading="lazy" style="width:100%;height:220px;object-fit:contain"/></article><article class="attempt"><small>CONVERT</small><h3>转换搜狗词库</h3><p>使用深蓝词库转换，再把拼音与词频转换为 IBus 格式。</p><pre>博弈论 bo'yi'lun 50000
博弈论 b'y'l 50000</pre></article><article class="attempt"><small>RESTART</small><h3>导入、重启、仍然失败</h3><p>尝试词库与码表导入，多次重启守护进程，wsm 依旧不出现“为什么”。</p><pre>ibus-daemon -drx</pre><img src={img4.src} alt="IBus 词库导入失败后的界面" loading="lazy" style="width:100%;height:180px;object-fit:contain"/></article></div></section>
    <section class="decision"><h2>弃坑不是失败<br/>是停止沉没成本</h2><article><p>搜狗输入法接近 Windows 习惯，但在 Edge 等应用里兼容性不稳定。IBus 更像系统原生，却很难恢复想要的缩写体验。</p><strong>更务实的选择：Fcitx5，或者使用对中文输入定制更完整的 deepin。</strong></article></section>
  </main>
  <OriginalArticle blog={blog} />
  <script>
    const dictionaries = {
      ibus: { wsm:['我什么','为什么么','外设名','网上买','为什么'], nh:['你好','年后','拿回'], default:['输入','候选','词库'] },
      fcitx: { wsm:['为什么','为什么呢','为什么说','为什么会','为什么不'], nh:['你好','您好','你会','年后'], default:['智能候选','模糊拼音','用户词频'] }
    };
    let system='ibus';
    const compose=document.querySelector('#compose'), candidate=document.querySelector('#candidate'), selected=document.querySelector('#selected'), systemName=document.querySelector('#systemName'), labStatus=document.querySelector('#labStatus');
    function render(){
      const key=compose.value.trim().toLowerCase();
      const words=dictionaries[system][key] || dictionaries[system].default;
      candidate.className=`candidate ${system}`;
      candidate.innerHTML='';
      words.forEach((word,index)=>{const button=document.createElement('button');button.textContent=`${index+1} ${word}`;button.addEventListener('click',()=>selected.textContent=word);candidate.append(button);});
      systemName.textContent=system==='ibus'?'IBus Pinyin':'Fcitx5 Pinyin';
      labStatus.textContent=system==='ibus'?'词库命中率 / LOW':'词库命中率 / STABLE';
    }
    document.querySelectorAll('[data-system]').forEach(button=>button.addEventListener('click',()=>{system=button.dataset.system;document.querySelectorAll('[data-system]').forEach(item=>item.classList.toggle('active',item===button));render();}));
    compose.addEventListener('input',render); compose.addEventListener('keydown',event=>{const index=Number(event.key)-1;if(index>=0&&candidate.children[index]) candidate.children[index].click();}); render();
  </script>
</body>
</html>
